      padding: 16px;
    }
  }
</style>

<!-- =========================================================================
     SCRIPT CLIENT ENGINE (UNIFICADO, ROBUSTO Y FULL STACK)
     ========================================================================= -->
<script is:inline>
  (function() {
    const STORAGE_TOKEN_KEY = 'zortex_cms_token';
    const liveChannel = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('zortex_cms') : null;

    // Estado Reactivo del SaaS
    const state = {
      token: localStorage.getItem(STORAGE_TOKEN_KEY) || '',
      allProducts: [],
      filteredProducts: [],
      quotes: [],
      activeCategory: 'all',
      statusFilter: 'all',
      searchQuery: '',
      pageSize: 25,
      currentPage: 1,
      editingOriginalColors: [],
      galleryLoaded: false,
      galleryImages: [],
    };

    // Referencias DOM Principales
    const authScreen = document.getElementById('auth-screen');
    const saasApp = document.getElementById('saas-app');
    const loginForm = document.getElementById('login-form');
    const loginErr = document.getElementById('login-err');
    const btnLogout = document.getElementById('btn-logout');
    const btnSidebarToggle = document.getElementById('btn-sidebar-toggle');
    const sidebar = document.querySelector('.sidebar');
    const topbarTitle = document.getElementById('topbar-section-title');
    const btnGlobalRefresh = document.getElementById('btn-global-refresh');
    const backendLabel = document.getElementById('backend-label');

    // KPIs & Contadores
    const kpiTotalProds = document.getElementById('kpi-total-prods');
    const kpiActiveProds = document.getElementById('kpi-active-prods');
    const kpiInactiveProds = document.getElementById('kpi-inactive-prods');
    const kpiTotalQuotes = document.getElementById('kpi-total-quotes');
    const countProductsNav = document.getElementById('count-products-nav');
    const countQuotesNav = document.getElementById('count-quotes-nav');
    const countAllChip = document.getElementById('count-all-chip');

    // Navegación de Pestañas
    const navItems = document.querySelectorAll('.sidebar-menu .nav-item');
    const tabPanes = document.querySelectorAll('.tab-pane');

    // Filtros de Productos
    const prodSearchInput = document.getElementById('prod-search-input');
    const btnClearSearch = document.getElementById('btn-clear-search');
    const prodStatusFilter = document.getElementById('prod-status-filter');
    const prodPageSize = document.getElementById('prod-page-size');
    const catFilterChips = document.getElementById('cat-filter-chips');
    const prodsTbody = document.getElementById('prods-tbody');
    const tableSummaryLbl = document.getElementById('table-summary-lbl');
    const btnPrevPage = document.getElementById('btn-prev-page');
    const btnNextPage = document.getElementById('btn-next-page');
    const pageCounterLbl = document.getElementById('page-counter-lbl');

    // Modal de Edición de Producto
    const btnOpenCreateProd = document.getElementById('btn-open-create-prod');
    const prodModal = document.getElementById('prod-modal');
    const modalProdTitle = document.getElementById('modal-prod-title');
    const btnCloseProdModal = document.getElementById('btn-close-prod-modal');
    const btnCancelProdModal = document.getElementById('btn-cancel-prod-modal');
    const prodForm = document.getElementById('prod-form');
    const modalProdId = document.getElementById('modal-prod-id');
    const mProdName = document.getElementById('m-prod-name');
    const mProdSku = document.getElementById('m-prod-sku');
    const mProdCategory = document.getElementById('m-prod-category');
    const mProdLine = document.getElementById('m-prod-line');
    const mProdImage = document.getElementById('m-prod-image');
    const mPreviewImg = document.getElementById('m-preview-img');
    const mProdSummary = document.getElementById('m-prod-summary');
    const mProdSizes = document.getElementById('m-prod-sizes');
    const mProdActive = document.getElementById('m-prod-active');
    const uploadDropzone = document.getElementById('upload-dropzone');
    const fileUploaderInput = document.getElementById('file-uploader-input');
    const uploadProgressBox = document.getElementById('upload-progress-box');
    const btnSyncUrlPreview = document.getElementById('btn-sync-url-preview');

    // Galería
    const btnOpenGalleryPicker = document.getElementById('btn-open-gallery-picker');
    const galleryModal = document.getElementById('gallery-modal');
    const btnCloseGallery = document.getElementById('btn-close-gallery');
    const galleryGrid = document.getElementById('gallery-grid');

    // Cotizaciones
    const quoteStatusChips = document.getElementById('quote-status-filter-chips');
    const quotesContainer = document.getElementById('quotes-container');

    // Configuración
    const settingsForm = document.getElementById('settings-form');
    const setHeroBadge = document.getElementById('set-hero-badge');
    const setHeroTitle = document.getElementById('set-hero-title');
    const setHeroLead = document.getElementById('set-hero-lead');
    const setContactEmail = document.getElementById('set-contact-email');
    const setContactPhone = document.getElementById('set-contact-phone');
    const setTopbarWa = document.getElementById('set-topbar-wa');
    const settingsStatusMsg = document.getElementById('settings-status-msg');

    // Helper API Fetch con Bearer Token
    async function apiFetch(url, options = {}) {
      const headers = new Headers(options.headers || {});
      if (state.token) {
        headers.set('Authorization', `Bearer ${state.token}`);
      }
      headers.set('Origin', window.location.origin);
      const res = await fetch(url, { ...options, credentials: 'include', headers });
      if (res.status === 401) {
        handleAuthRequired();
        throw new Error('No autorizado');
      }
      return res;
    }

    function handleAuthRequired() {
      state.token = '';
      localStorage.removeItem(STORAGE_TOKEN_KEY);
      if (authScreen) authScreen.style.display = 'flex';
      if (saasApp) saasApp.style.display = 'none';
    }

    function broadcastLiveChange(type) {
      try {
        localStorage.setItem('zortex_cms_updated', String(Date.now()));
        if (liveChannel) {
          liveChannel.postMessage({ type, at: Date.now() });
        }
      } catch (e) {
        console.warn('Broadcast error:', e);
      }
    }

    // -------------------------------------------------------------------------
    // 1. INICIALIZACIÓN Y LOGIN
    // -------------------------------------------------------------------------
    async function initAuth() {
      if (!state.token) {
        handleAuthRequired();
        return;
      }
      try {
        const res = await apiFetch('/api/admin/products');
        if (res.ok) {
          const data = await res.json();
          showDashboard(data);
        } else {
          handleAuthRequired();
        }
      } catch {
        handleAuthRequired();
      }
    }

    function showDashboard(initialData) {
      if (authScreen) authScreen.style.display = 'none';
      if (saasApp) saasApp.style.display = 'flex';

      if (initialData && initialData.products) {
        processProducts(initialData.products, initialData.backend);
      } else {
        loadProducts();
      }
      loadQuotes();
      loadSettings();
    }

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (loginErr) loginErr.style.display = 'none';

        const username = document.getElementById('login-user').value.trim();
        const password = document.getElementById('login-pass').value.trim();

        try {
          const res = await fetch('/api/admin/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });
          const data = await res.json();

          if (data.success && data.token) {
            state.token = data.token;
            localStorage.setItem(STORAGE_TOKEN_KEY, data.token);
            showDashboard();
          } else {
            if (loginErr) {
              loginErr.textContent = data.error || 'Usuario o contraseña incorrectos.';
              loginErr.style.display = 'block';
            }
          }
        } catch {
          if (loginErr) {
            loginErr.textContent = 'Error de conexión con el servidor.';
            loginErr.style.display = 'block';
          }
        }
      });
    }

    if (btnLogout) {
      btnLogout.addEventListener('click', async () => {
        try {
          await fetch('/api/admin/auth/logout', { method: 'POST' });
        } catch {}
        handleAuthRequired();
      });
    }

    if (btnSidebarToggle && sidebar) {
      btnSidebarToggle.addEventListener('click', () => {
        sidebar.classList.toggle('open');
      });
    }

    if (btnGlobalRefresh) {
      btnGlobalRefresh.addEventListener('click', async () => {
        btnGlobalRefresh.style.opacity = '0.5';
        await Promise.all([loadProducts(), loadQuotes(), loadSettings()]);
        btnGlobalRefresh.style.opacity = '1';
      });
    }

    // Pestañas
    navItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        navItems.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const targetTab = btn.getAttribute('data-tab');
        tabPanes.forEach((pane) => {
          pane.style.display = pane.id === targetTab ? 'block' : 'none';
        });

        if (topbarTitle) {
          if (targetTab === 'tab-products') topbarTitle.textContent = 'Catálogo & Productos';
          if (targetTab === 'tab-quotes') topbarTitle.textContent = 'Cotizaciones B2B';
          if (targetTab === 'tab-content') topbarTitle.textContent = 'Textos & Portada';
        }

        if (sidebar && sidebar.classList.contains('open')) {
          sidebar.classList.remove('open');
        }
      });
    });

    // -------------------------------------------------------------------------
    // 2. GESTIÓN Y RENDERIZADO DEL CATÁLOGO (PAGINACIÓN & DIMENSIONES)
    // -------------------------------------------------------------------------
    async function loadProducts() {
      try {
        const res = await apiFetch('/api/admin/products');
        if (!res.ok) return;
        const data = await res.json();
        processProducts(data.products || [], data.backend);
      } catch (err) {
        console.error('Error al cargar productos:', err);
      }
    }

    function processProducts(products, backend) {
      state.allProducts = products;

      if (backendLabel && backend) {
        backendLabel.textContent = backend === 'supabase' ? 'Supabase PostgreSQL' : 'Local JSON Storage';
      }

      // Actualizar KPIs
      const activeCount = state.allProducts.filter((p) => p.isActive !== false).length;
      const inactiveCount = state.allProducts.length - activeCount;

      if (kpiTotalProds) kpiTotalProds.textContent = String(state.allProducts.length);
      if (kpiActiveProds) kpiActiveProds.textContent = String(activeCount);
      if (kpiInactiveProds) kpiInactiveProds.textContent = String(inactiveCount);
      if (countProductsNav) countProductsNav.textContent = String(state.allProducts.length);
      if (countAllChip) countAllChip.textContent = String(state.allProducts.length);

      applyFilters();
    }

    function applyFilters() {
      const q = state.searchQuery.toLowerCase().trim();
      const cat = state.activeCategory;
      const status = state.statusFilter;

      state.filteredProducts = state.allProducts.filter((p) => {
        // Filtro Categoría
        if (cat !== 'all' && p.category !== cat) return false;

        // Filtro Estado
        const isActive = p.isActive !== false;
        if (status === 'active' && !isActive) return false;
        if (status === 'inactive' && isActive) return false;

        // Filtro Búsqueda
        if (q) {
          const matchName = (p.name || '').toLowerCase().includes(q);
          const matchSku = (p.sku || '').toLowerCase().includes(q);
          const matchCat = (p.category || '').toLowerCase().includes(q);
          const matchLine = (p.line || '').toLowerCase().includes(q);
          if (!matchName && !matchSku && !matchCat && !matchLine) return false;
        }

        return true;
      });

      // Reiniciar a página 1 al filtrar
      state.currentPage = 1;
      renderTablePage();
    }

    function renderTablePage() {
      if (!prodsTbody) return;

      const totalItems = state.filteredProducts.length;

      if (totalItems === 0) {
        prodsTbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; padding: 48px; color: #64748B;">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="1.5" style="margin-bottom: 8px;">
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <div>No se encontraron productos que coincidan con la búsqueda o filtro.</div>
            </td>
          </tr>
        `;
        if (tableSummaryLbl) tableSummaryLbl.textContent = '0 productos encontrados';
        if (pageCounterLbl) pageCounterLbl.textContent = 'Página 1 de 1';
        if (btnPrevPage) btnPrevPage.disabled = true;
        if (btnNextPage) btnNextPage.disabled = true;
        return;
      }

      // Cálculo de paginación
      const pageSize = state.pageSize === 'all' ? totalItems : parseInt(state.pageSize, 10);
      const totalPages = Math.ceil(totalItems / pageSize);
      if (state.currentPage > totalPages) state.currentPage = totalPages;
      if (state.currentPage < 1) state.currentPage = 1;

      const startIndex = (state.currentPage - 1) * pageSize;
      const endIndex = Math.min(startIndex + pageSize, totalItems);
      const pageItems = state.filteredProducts.slice(startIndex, endIndex);

      if (tableSummaryLbl) {
        tableSummaryLbl.textContent = `Mostrando ${startIndex + 1} - ${endIndex} de ${totalItems} productos (Total catálogo: ${state.allProducts.length})`;
      }

      if (pageCounterLbl) {
        pageCounterLbl.textContent = `Página ${state.currentPage} de ${totalPages}`;
      }

      if (btnPrevPage) btnPrevPage.disabled = state.currentPage <= 1;
      if (btnNextPage) btnNextPage.disabled = state.currentPage >= totalPages;

      // Renderizado seguro con miniaturas estrictamente contenidas (56px)
      prodsTbody.innerHTML = pageItems
        .map((p) => {
          const isActive = p.isActive !== false;
          const sizes = Array.isArray(p.sizes) && p.sizes.length > 0 ? p.sizes.slice(0, 4) : ['Estándar'];
          const catClass = getCatBadgeClass(p.category);

          return `
            <tr class="${isActive ? '' : 'row-inactive'}" data-id="${p.id}">
              <td>
                <div class="tbl-thumb-box" data-action="quick-photo" data-id="${p.id}" title="Clic para cambiar la foto de este producto">
                  <img src="${p.image || '/images/catalogo/polera-corporativa.webp'}" alt="${escapeHtml(p.name)}" class="tbl-thumb" onerror="this.src='/images/catalogo/polera-corporativa.webp'" />
                  <div class="tbl-thumb-cam-hint">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                  </div>
                </div>
              </td>
              <td>
                <strong class="tbl-prod-name" title="${escapeHtml(p.name)}">${escapeHtml(p.name)}</strong>
                <span class="tbl-prod-line">${escapeHtml(p.line || 'Línea Estándar')}</span>
              </td>
              <td>
                <span class="tbl-sku-code">${escapeHtml(p.sku || '--')}</span>
              </td>
              <td>
                <span class="tbl-cat-badge ${catClass}">${escapeHtml(p.category)}</span>
              </td>
              <td>
                <div class="tbl-sizes-list">
                  ${sizes.map((s) => `<span class="tbl-size-tag">${escapeHtml(s)}</span>`).join('')}
                  ${Array.isArray(p.sizes) && p.sizes.length > 4 ? `<span class="tbl-size-tag">+${p.sizes.length - 4}</span>` : ''}
                </div>
              </td>
              <td style="text-align: center;">
                <button type="button" class="tbl-status-toggle ${isActive ? 'active' : 'inactive'}" data-action="toggle-status" data-id="${p.id}" title="Alternar visibilidad">
                  ${isActive ? '● Activo' : '○ Inactivo'}
                </button>
              </td>
              <td style="text-align: right;">
                <div class="tbl-actions-group">
                  <button type="button" class="btn-row-action upload" data-action="quick-photo" data-id="${p.id}" title="Cambiar Foto">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                  </button>
                  <button type="button" class="btn-row-action edit" data-action="edit" data-id="${p.id}" title="Editar Producto">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  </button>
                  <button type="button" class="btn-row-action delete" data-action="delete" data-id="${p.id}" title="Eliminar">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join('');
    }

    function getCatBadgeClass(category) {
      if (category === 'Ropa Corporativa') return 'cat-corp';
      if (category === 'Ropa Industrial') return 'cat-ind';
      if (category === 'Ropa de Seguridad') return 'cat-sec';
      if (category === 'EPP') return 'cat-epp';
      return 'cat-cust';
    }

    // Eventos de Búsqueda y Filtros
    if (prodSearchInput) {
      prodSearchInput.addEventListener('input', (e) => {
        state.searchQuery = e.target.value;
        if (btnClearSearch) btnClearSearch.style.display = state.searchQuery ? 'block' : 'none';
        applyFilters();
      });
    }

    if (btnClearSearch) {
      btnClearSearch.addEventListener('click', () => {
        if (prodSearchInput) prodSearchInput.value = '';
        state.searchQuery = '';
        btnClearSearch.style.display = 'none';
        applyFilters();
      });
    }

    if (prodStatusFilter) {
      prodStatusFilter.addEventListener('change', (e) => {
        state.statusFilter = e.target.value;
        applyFilters();
      });
    }

    if (prodPageSize) {
      prodPageSize.addEventListener('change', (e) => {
        state.pageSize = e.target.value;
        applyFilters();
      });
    }

    if (catFilterChips) {
      catFilterChips.addEventListener('click', (e) => {
        const chip = e.target.closest('.chip');
        if (!chip) return;
        catFilterChips.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        state.activeCategory = chip.getAttribute('data-cat') || 'all';
        applyFilters();
      });
    }

    if (btnPrevPage) {
      btnPrevPage.addEventListener('click', () => {
        if (state.currentPage > 1) {
          state.currentPage--;
          renderTablePage();
        }
      });
    }

    if (btnNextPage) {
      btnNextPage.addEventListener('click', () => {
        state.currentPage++;
        renderTablePage();
      });
    }

    // Acciones de Tabla (Toggle Status, Quick Photo, Edit, Delete)
    if (prodsTbody) {
      prodsTbody.addEventListener('click', async (e) => {
        const targetBtn = e.target.closest('[data-action]');
        if (!targetBtn) return;

        const action = targetBtn.getAttribute('data-action');
        const id = targetBtn.getAttribute('data-id');
        if (!id) return;

        const prod = state.allProducts.find((p) => p.id === id);
        if (!prod) return;

        if (action === 'toggle-status') {
          const nextStatus = prod.isActive === false;
          targetBtn.textContent = '...';
          try {
            const res = await apiFetch('/api/admin/products', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...prod, isActive: nextStatus }),
            });
            if (res.ok) {
              prod.isActive = nextStatus;
              processProducts(state.allProducts);
              broadcastLiveChange('PRODUCTS_UPDATED');
            }
          } catch {
            alert('Error al cambiar el estado del producto.');
          }
        } else if (action === 'quick-photo') {
          openProductModal(prod);
          // Hacer foco en la sección de imagen
          if (uploadDropzone) uploadDropzone.scrollIntoView({ behavior: 'smooth' });
        } else if (action === 'edit') {
          openProductModal(prod);
        } else if (action === 'delete') {
          if (!confirm(`¿Eliminar definitivamente "${prod.name}" del catálogo?`)) return;
          try {
            const res = await apiFetch(`/api/admin/products?id=${encodeURIComponent(id)}`, {
              method: 'DELETE',
            });
            if (res.ok) {
              state.allProducts = state.allProducts.filter((p) => p.id !== id);
              processProducts(state.allProducts);
              broadcastLiveChange('PRODUCTS_UPDATED');
            }
          } catch {
            alert('Error al eliminar producto.');
          }
        }
      });
    }

    // -------------------------------------------------------------------------
    // 3. MODAL DE PRODUCTO: SUBIDA DE IMÁGENES & EDICIÓN FULL STACK
    // -------------------------------------------------------------------------
    function openProductModal(prod = null) {
      if (!prodModal) return;

      if (prod) {
        if (modalProdTitle) modalProdTitle.textContent = 'Editar Producto';
        if (modalProdId) modalProdId.value = prod.id || '';
        if (mProdName) mProdName.value = prod.name || '';
        if (mProdSku) mProdSku.value = prod.sku || '';
        if (mProdCategory) mProdCategory.value = prod.category || 'Ropa Corporativa';
        if (mProdLine) mProdLine.value = prod.line || '';
        if (mProdImage) mProdImage.value = prod.image || '';
        if (mPreviewImg) mPreviewImg.src = prod.image || '/images/catalogo/polera-corporativa.webp';
        if (mProdSummary) mProdSummary.value = prod.summary || '';
        if (mProdSizes) mProdSizes.value = Array.isArray(prod.sizes) ? prod.sizes.join(', ') : 'S, M, L, XL';
        if (mProdActive) mProdActive.checked = prod.isActive !== false;
        state.editingOriginalColors = prod.colors || [];
      } else {
        if (modalProdTitle) modalProdTitle.textContent = 'Crear Nuevo Producto';
        if (prodForm) prodForm.reset();
        if (modalProdId) modalProdId.value = '';
        if (mProdActive) mProdActive.checked = true;
        if (mPreviewImg) mPreviewImg.src = '/images/catalogo/polera-corporativa.webp';
        if (mProdSizes) mProdSizes.value = 'S, M, L, XL, XXL';
        state.editingOriginalColors = [];
      }

      prodModal.style.display = 'flex';
    }

    function closeProductModal() {
      if (prodModal) prodModal.style.display = 'none';
      if (uploadProgressBox) uploadProgressBox.style.display = 'none';
    }

    if (btnOpenCreateProd) btnOpenCreateProd.addEventListener('click', () => openProductModal());
    if (btnCloseProdModal) btnCloseProdModal.addEventListener('click', closeProductModal);
    if (btnCancelProdModal) btnCancelProdModal.addEventListener('click', closeProductModal);

    // Cargar previsualización de imagen al escribir URL
    if (mProdImage && mPreviewImg) {
      mProdImage.addEventListener('input', () => {
        mPreviewImg.src = mProdImage.value.trim() || '/images/catalogo/polera-corporativa.webp';
      });
    }

    if (btnSyncUrlPreview && mProdImage && mPreviewImg) {
      btnSyncUrlPreview.addEventListener('click', () => {
        mPreviewImg.src = mProdImage.value.trim() || '/images/catalogo/polera-corporativa.webp';
      });
    }

    // Botones rápidos de agregar talla
    document.querySelectorAll('.btn-quick-size').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sz = btn.getAttribute('data-size');
        if (!sz || !mProdSizes) return;
        const current = mProdSizes.value
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);
        if (!current.includes(sz)) {
          current.push(sz);
          mProdSizes.value = current.join(', ');
        }
      });
    });

    // -------------------------------------------------------------------------
    // SUBIDA DE ARCHIVOS DE IMAGEN (FULL STACK FILE UPLOAD)
    // -------------------------------------------------------------------------
    if (uploadDropzone && fileUploaderInput) {
      uploadDropzone.addEventListener('click', () => {
        fileUploaderInput.click();
      });

      // Drag and Drop
      uploadDropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadDropzone.style.background = '#DBEAFE';
      });

      uploadDropzone.addEventListener('dragleave', () => {
        uploadDropzone.style.background = '#EFF6FF';
      });

      uploadDropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadDropzone.style.background = '#EFF6FF';
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleImageUpload(e.dataTransfer.files[0]);
        }
      });

      fileUploaderInput.addEventListener('change', () => {
        if (fileUploaderInput.files && fileUploaderInput.files[0]) {
          handleImageUpload(fileUploaderInput.files[0]);
        }
      });
    }

    async function handleImageUpload(file) {
      if (!file) return;

      const prodName = mProdName?.value.trim() || 'producto';

      if (uploadProgressBox) uploadProgressBox.style.display = 'flex';
      const progressText = document.getElementById('upload-progress-text');
      if (progressText) progressText.textContent = `Subiendo "${file.name}"...`;

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('name', prodName);

        const res = await apiFetch('/api/admin/upload', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();
        if (data.success && data.url) {
          if (mProdImage) mProdImage.value = data.url;
          if (mPreviewImg) mPreviewImg.src = data.url;

          if (progressText) {
            progressText.textContent = '✓ Imagen subida con éxito.';
            setTimeout(() => {
              if (uploadProgressBox) uploadProgressBox.style.display = 'none';
            }, 2000);
          }
        } else {
          alert('Error al subir imagen: ' + (data.error || 'Formato no permitido.'));
          if (uploadProgressBox) uploadProgressBox.style.display = 'none';
        }
      } catch (err) {
        alert('Error al conectar con el servidor de subida: ' + err.message);
        if (uploadProgressBox) uploadProgressBox.style.display = 'none';
      }
    }

    // -------------------------------------------------------------------------
    // SELECTOR DE GALERÍA DE IMÁGENES
    // -------------------------------------------------------------------------
    if (btnOpenGalleryPicker && galleryModal) {
      btnOpenGalleryPicker.addEventListener('click', async () => {
        galleryModal.style.display = 'flex';
        if (!state.galleryLoaded) {
          loadGallery();
        }
      });
    }

    if (btnCloseGallery && galleryModal) {
      btnCloseGallery.addEventListener('click', () => {
        galleryModal.style.display = 'none';
      });
    }

    async function loadGallery() {
      if (!galleryGrid) return;
      try {
        const res = await apiFetch('/api/admin/gallery');
        const data = await res.json();
        if (data.success && Array.isArray(data.images)) {
          state.galleryImages = data.images;
          state.galleryLoaded = true;
          renderGalleryGrid();
        }
      } catch {
        galleryGrid.innerHTML = '<div class="loading-state">No se pudieron cargar imágenes.</div>';
      }
    }

    function renderGalleryGrid() {
      if (!galleryGrid) return;
      if (state.galleryImages.length === 0) {
        galleryGrid.innerHTML = '<div class="loading-state">No hay imágenes disponibles.</div>';
        return;
      }

      galleryGrid.innerHTML = state.galleryImages
        .map(
          (imgUrl) => `
        <div class="gallery-item-card" data-url="${imgUrl}" title="Seleccionar esta imagen">
          <img src="${imgUrl}" alt="Foto catálogo" loading="lazy" />
        </div>
      `
        )
        .join('');

      galleryGrid.querySelectorAll('.gallery-item-card').forEach((card) => {
        card.addEventListener('click', () => {
          const url = card.getAttribute('data-url');
          if (url) {
            if (mProdImage) mProdImage.value = url;
            if (mPreviewImg) mPreviewImg.src = url;
            if (galleryModal) galleryModal.style.display = 'none';
          }
        });
      });
    }

    // Guardar Producto (Crear o Actualizar)
    if (prodForm) {
      prodForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('btn-save-prod');
        if (saveBtn) saveBtn.setAttribute('disabled', 'true');

        const id = modalProdId?.value.trim() || undefined;
        const name = mProdName?.value.trim() || '';
        const sku = mProdSku?.value.trim() || '';
        const category = mProdCategory?.value || 'Ropa Corporativa';
        const line = mProdLine?.value.trim() || '';
        const image = mProdImage?.value.trim() || '';
        const summary = mProdSummary?.value.trim() || '';
        const rawSizes = mProdSizes?.value || '';
        const sizes = rawSizes
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);
        const isActive = mProdActive ? mProdActive.checked : true;

        const payload = {
          name,
          sku,
          category,
          line,
          image,
          summary,
          sizes: sizes.length > 0 ? sizes : ['S', 'M', 'L', 'XL'],
          isActive,
        };

        if (id) payload.id = id;
        if (state.editingOriginalColors.length > 0) payload.colors = state.editingOriginalColors;

        try {
          const res = await apiFetch('/api/admin/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (data.success && data.product) {
            closeProductModal();
            await loadProducts();
            broadcastLiveChange('PRODUCTS_UPDATED');
          } else {
            alert('Error: ' + (data.error || 'No se pudo guardar el producto.'));
          }
        } catch (err) {
          alert('Error al guardar producto: ' + err.message);
        } finally {
          if (saveBtn) saveBtn.removeAttribute('disabled');
        }
      });
    }

    // -------------------------------------------------------------------------
    // 4. COTIZACIONES B2B (GESTIÓN, EXPORTACIÓN, SEEDING & TIEMPO REAL)
    // -------------------------------------------------------------------------
    const btnCreateTestQuote = document.getElementById('btn-create-test-quote');
    const btnExportQuotesCsv = document.getElementById('btn-export-quotes-csv');
    const quoteSearchInput = document.getElementById('quote-search-input');
    const btnClearQuoteSearch = document.getElementById('btn-clear-quote-search');

    const qStatTotal = document.getElementById('q-stat-total');
    const qStatNew = document.getElementById('q-stat-new');
    const qStatProg = document.getElementById('q-stat-prog');
    const qStatWon = document.getElementById('q-stat-won');

    const countQAll = document.getElementById('count-q-all');
    const countQNuevo = document.getElementById('count-q-nuevo');
    const countQGestion = document.getElementById('count-q-gestion');
    const countQCotizado = document.getElementById('count-q-cotizado');
    const countQGanado = document.getElementById('count-q-ganado');
    const countQPerdido = document.getElementById('count-q-perdido');

    state.selectedQuoteStatus = 'all';
    state.quoteSearchQuery = '';

    async function loadQuotes() {
      try {
        const res = await apiFetch('/api/admin/quotes');
        if (!res.ok) return;
        const data = await res.json();
        
        // Normalización segura de cotizaciones
        state.quotes = (data.quotes || []).map((q) => ({
          ...q,
          estado: q.estado || q.status || 'nuevo',
          created_at: q.created_at || q.createdAt || new Date().toISOString(),
          items: Array.isArray(q.items) ? q.items : [],
        }));

        // Actualizar métricas B2B
        const total = state.quotes.length;
        const nuevos = state.quotes.filter((q) => q.estado === 'nuevo').length;
        const enGestion = state.quotes.filter((q) => q.estado === 'en_gestion').length;
        const cotizados = state.quotes.filter((q) => q.estado === 'cotizado').length;
        const ganados = state.quotes.filter((q) => q.estado === 'ganado').length;
        const perdidos = state.quotes.filter((q) => q.estado === 'perdido').length;

        if (qStatTotal) qStatTotal.textContent = String(total);
        if (qStatNew) qStatNew.textContent = String(nuevos);
        if (qStatProg) qStatProg.textContent = String(enGestion + cotizados);
        if (qStatWon) qStatWon.textContent = String(ganados);

        if (kpiTotalQuotes) kpiTotalQuotes.textContent = String(total);
        if (countQuotesNav) countQuotesNav.textContent = String(nuevos > 0 ? `${total} (${nuevos} nuevas)` : total);

        if (countQAll) countQAll.textContent = String(total);
        if (countQNuevo) countQNuevo.textContent = String(nuevos);
        if (countQGestion) countQGestion.textContent = String(enGestion);
        if (countQCotizado) countQCotizado.textContent = String(cotizados);
        if (countQGanado) countQGanado.textContent = String(ganados);
        if (countQPerdido) countQPerdido.textContent = String(perdidos);

        renderQuotes();
      } catch (err) {
        console.error('Error al cargar cotizaciones:', err);
      }
    }

    if (quoteStatusChips) {
      quoteStatusChips.addEventListener('click', (e) => {
        const target = e.target.closest('.chip');
        if (!target) return;
        quoteStatusChips.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
        target.classList.add('active');
        state.selectedQuoteStatus = target.getAttribute('data-status') || 'all';
        renderQuotes();
      });
    }

    if (quoteSearchInput) {
      quoteSearchInput.addEventListener('input', (e) => {
        state.quoteSearchQuery = e.target.value.toLowerCase().trim();
        if (btnClearQuoteSearch) btnClearQuoteSearch.style.display = state.quoteSearchQuery ? 'block' : 'none';
        renderQuotes();
      });
    }

    if (btnClearQuoteSearch) {
      btnClearQuoteSearch.addEventListener('click', () => {
        if (quoteSearchInput) quoteSearchInput.value = '';
        state.quoteSearchQuery = '';
        btnClearQuoteSearch.style.display = 'none';
        renderQuotes();
      });
    }

    function renderQuotes() {
      if (!quotesContainer) return;

      const qSearch = state.quoteSearchQuery;
      const statusFilter = state.selectedQuoteStatus;

      const filtered = state.quotes.filter((q) => {
        // Filtro por Estado
        if (statusFilter !== 'all' && q.estado !== statusFilter) return false;

        // Filtro por Búsqueda
        if (qSearch) {
          const matchEmpresa = (q.empresa || '').toLowerCase().includes(qSearch);
          const matchRut = (q.rut || '').toLowerCase().includes(qSearch);
          const matchNombre = (q.nombre || '').toLowerCase().includes(qSearch);
          const matchCorreo = (q.correo || '').toLowerCase().includes(qSearch);
          const matchFono = (q.telefono || '').toLowerCase().includes(qSearch);
          const matchItem = q.items.some((it) => (it.producto || '').toLowerCase().includes(qSearch));
          if (!matchEmpresa && !matchRut && !matchNombre && !matchCorreo && !matchFono && !matchItem) return false;
        }

        return true;
      });

      // Estado Vacío Informativo y Elegante
      if (filtered.length === 0) {
        quotesContainer.innerHTML = `
          <div class="quotes-empty-card">
            <div class="quotes-empty-icon">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <h3>Bandeja Lista para Recibir Solicitudes</h3>
            <p>
              ${
                state.quotes.length === 0
                  ? 'Cada vez que una empresa solicite cotización en tu web o carrito, aparecerá aquí al instante con todos sus datos, teléfono, prendas y cantidades.'
                  : 'No hay cotizaciones que coincidan con el filtro seleccionado.'
              }
            </p>
            ${
              state.quotes.length === 0
                ? `
              <button type="button" class="btn-empty-seed" id="btn-empty-seed-quote">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                <span>Generar Cotización de Prueba para Ver el Sistema</span>
              </button>
            `
                : ''
            }
          </div>
        `;

        const seedBtn = document.getElementById('btn-empty-seed-quote');
        if (seedBtn) seedBtn.addEventListener('click', generateTestQuote);
        return;
      }

      // Renderizado de Tarjetas de Cotización
      quotesContainer.innerHTML = filtered
        .map((q) => {
          const items = Array.isArray(q.items) ? q.items : [];
          const totalPrendas = items.reduce((acc, it) => acc + (parseInt(it.cantidad, 10) || 1), 0);
          
          let dateStr = '--';
          try {
            dateStr = new Date(q.created_at).toLocaleString('es-CL', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            });
          } catch {}

          const cleanPhone = (q.telefono || '').replace(/\D/g, '');
          const waMessage = encodeURIComponent(
            `Hola ${q.nombre || ''}, te contactamos desde ZORTEX en respuesta a la cotización solicitada para ${q.empresa || 'tu empresa'} (Ref: #${q.id}). ¿Podemos afinar detalles del despacho y personalización?`
          );
          const waLink = cleanPhone ? `https://wa.me/${cleanPhone}?text=${waMessage}` : '#';

          return `
            <div class="quote-card ${q.estado === 'nuevo' ? 'is-new' : ''}" data-quote-id="${q.id}">
              <div class="q-card-head">
                <div>
                  <div class="q-title-row">
                    <h3 class="q-empresa">${escapeHtml(q.empresa || 'Empresa Sin Nombre')}</h3>
                    ${q.rut ? `<span class="q-rut">RUT: ${escapeHtml(q.rut)}</span>` : ''}
                    <span class="q-id-pill">ID: #${escapeHtml(q.id)}</span>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 8px;">
                  <select class="q-select-status status-${q.estado}" data-quote-id="${q.id}">
                    <option value="nuevo" ${q.estado === 'nuevo' ? 'selected' : ''}>● Nueva Solicitud</option>
                    <option value="en_gestion" ${q.estado === 'en_gestion' ? 'selected' : ''}>⏳ En Gestión Comercial</option>
                    <option value="cotizado" ${q.estado === 'cotizado' ? 'selected' : ''}>📄 Presupuesto Enviado</option>
                    <option value="ganado" ${q.estado === 'ganado' ? 'selected' : ''}>✓ Venta Ganada / Cerrada</option>
                    <option value="perdido" ${q.estado === 'perdido' ? 'selected' : ''}>✕ Oportunidad Perdida</option>
                  </select>
                  <button type="button" class="btn-del-quote" data-quote-id="${q.id}" title="Eliminar cotización">×</button>
                </div>
              </div>

              <!-- Matriz de Datos del Cliente -->
              <div class="q-meta-grid">
                <div class="q-meta-item">
                  <span class="q-meta-label">Persona de Contacto</span>
                  <span class="q-meta-val">${escapeHtml(q.nombre || '--')}</span>
                </div>
                <div class="q-meta-item">
                  <span class="q-meta-label">Correo Electrónico</span>
                  <span class="q-meta-val">
                    ${q.correo ? `<a href="mailto:${escapeHtml(q.correo)}?subject=Cotización%20ZORTEX%20-%20${encodeURIComponent(q.empresa || '')}">${escapeHtml(q.correo)}</a>` : '--'}
                  </span>
                </div>
                <div class="q-meta-item">
                  <span class="q-meta-label">Teléfono / WhatsApp</span>
                  <span class="q-meta-val">
                    ${q.telefono ? `<a href="${waLink}" target="_blank" title="Abrir WhatsApp">${escapeHtml(q.telefono)}</a>` : '--'}
                  </span>
                </div>
                <div class="q-meta-item">
                  <span class="q-meta-label">Fecha y Hora de Ingreso</span>
                  <span class="q-meta-val">${dateStr}</span>
                </div>
                <div class="q-meta-item">
                  <span class="q-meta-label">Personalización de Logo</span>
                  <span class="q-meta-val">${escapeHtml(q.personalizacion || 'Sin logo')}</span>
                </div>
                <div class="q-meta-item">
                  <span class="q-meta-label">Plazo Estimado Requerido</span>
                  <span class="q-meta-val">${escapeHtml(q.plazo || 'Normal (según stock)')}</span>
                </div>
              </div>

              ${
                q.mensaje
                  ? `
                <div class="q-client-msg">
                  <strong>Requerimientos Especiales / Mensaje del Cliente:</strong>
                  ${escapeHtml(q.mensaje)}
                </div>
              `
                  : ''
              }

              <!-- Bloque de Prendas y Modelos -->
              <div class="q-items-block">
                <div class="q-items-header-row">
                  <span class="q-items-title">Prendas y Modelos Solicitados (${items.length} líneas)</span>
                  <span class="q-items-total-pill">Total: ${totalPrendas} unidades</span>
                </div>
                <div class="q-items-flex">
                  ${items
                    .map(
                      (it) => `
                    <span class="q-item-pill">
                      <span class="q-item-qty">${it.cantidad || 1} u.</span>
                      <span class="q-item-name">${escapeHtml(it.producto || 'Producto')}</span>
                      ${it.talla ? `<span class="q-item-size">Talla: ${escapeHtml(it.talla)}</span>` : ''}
                      ${it.categoria ? `<span class="tbl-size-tag" style="color:#64748B;">${escapeHtml(it.categoria)}</span>` : ''}
                    </span>
                  `
                    )
                    .join('')}
                </div>
              </div>

              <!-- Footer de la Tarjeta con Acciones Rápidas -->
              <div class="q-card-footer">
                <div class="q-card-footer-btns">
                  ${
                    cleanPhone
                      ? `
                    <a href="${waLink}" target="_blank" class="btn-q-wa" title="Escribir mensaje formal al cliente por WhatsApp">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                      <span>Contactar por WhatsApp</span>
                    </a>
                  `
                      : ''
                  }

                  <button type="button" class="btn-q-action" data-action="print" data-quote-id="${q.id}" title="Imprimir o guardar como PDF formal">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    <span>Imprimir Ficha</span>
                  </button>
                </div>
              </div>
            </div>
          `;
        })
        .join('');
    }

    // Cambio de estado en vivo
    if (quotesContainer) {
      quotesContainer.addEventListener('change', async (e) => {
        const target = e.target;
        if (target && target.classList.contains('q-select-status')) {
          const id = target.getAttribute('data-quote-id');
          const newStatus = target.value;
          if (!id) return;

          // Feedback visual inmediato
          target.className = `q-select-status status-${newStatus}`;

          try {
            const res = await apiFetch('/api/admin/quotes', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, estado: newStatus, status: newStatus }),
            });

            if (res.ok) {
              const match = state.quotes.find((q) => q.id === id);
              if (match) match.estado = newStatus;
              loadQuotes();
            } else {
              alert('No se pudo actualizar el estado.');
            }
          } catch {
            alert('Error al comunicar con el servidor.');
          }
        }
      });

      // Acciones de Imprimir y Eliminar
      quotesContainer.addEventListener('click', async (e) => {
        const delBtn = e.target.closest('.btn-del-quote');
        if (delBtn) {
          const id = delBtn.getAttribute('data-quote-id');
          if (!id) return;
          if (!confirm('¿Estás seguro de que deseas eliminar esta cotización?')) return;
          try {
            const res = await apiFetch(`/api/admin/quotes?id=${encodeURIComponent(id)}`, {
              method: 'DELETE',
            });
            if (res.ok) {
              state.quotes = state.quotes.filter((q) => q.id !== id);
              loadQuotes();
            }
          } catch {
            alert('Error al eliminar la cotización.');
          }
          return;
        }

        const printBtn = e.target.closest('button[data-action="print"]');
        if (printBtn) {
          const id = printBtn.getAttribute('data-quote-id');
          const q = state.quotes.find((item) => item.id === id);
          if (q) printQuoteDoc(q);
        }
      });
    }

    // Generar Cotización de Prueba (Test B2B Seed)
    async function generateTestQuote() {
      try {
        const res = await apiFetch('/api/admin/quotes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            empresa: 'Constructora & Minería del Norte SpA',
            rut: '76.852.147-9',
            nombre: 'Mauricio Morales - Subgerente de Compras',
            telefono: '+56 9 9482 1102',
            correo: 'compras@nortemineria.cl',
            personalizacion: 'Bordado Computarizado',
            plazo: '15 días hábiles',
            mensaje: 'Solicitud de cotización urgente para cuadrilla en faena alta cordillera.',
            items: [
              { producto: 'Parka Alta Visibilidad Fluor 3 en 1', categoria: 'Ropa de Seguridad', cantidad: 50, talla: 'L' },
              { producto: 'Pantalón Cargo Faena Ignífugo', categoria: 'Ropa Industrial', cantidad: 50, talla: '46' },
              { producto: 'Botín Dieléctrico Seguridad Pu/Goma', categoria: 'EPP', cantidad: 50, talla: '43' },
            ],
          }),
        });

        if (res.ok) {
          await loadQuotes();
          broadcastLiveChange('QUOTES_UPDATED');
        }
      } catch (err) {
        alert('Error al crear cotización de prueba: ' + err.message);
      }
    }

    if (btnCreateTestQuote) {
      btnCreateTestQuote.addEventListener('click', generateTestQuote);
    }

    // Exportar a CSV compatible con Excel
    if (btnExportQuotesCsv) {
      btnExportQuotesCsv.addEventListener('click', () => {
        if (state.quotes.length === 0) {
          alert('No hay cotizaciones para exportar.');
          return;
        }

        const headers = ['ID', 'Fecha', 'Empresa', 'RUT', 'Contacto', 'Telefono', 'Correo', 'Estado', 'Personalizacion', 'Plazo', 'Prendas_Totales', 'Detalle_Items'];
        
        const rows = state.quotes.map((q) => {
          const totalPrendas = q.items.reduce((acc, it) => acc + (parseInt(it.cantidad, 10) || 1), 0);
          const itemsStr = q.items.map((it) => `${it.cantidad}x ${it.producto} (${it.talla || 'Std'})`).join('; ');
          const dateStr = q.created_at ? new Date(q.created_at).toLocaleDateString('es-CL') : '';

          return [
            `"${q.id}"`,
            `"${dateStr}"`,
            `"${(q.empresa || '').replace(/"/g, '""')}"`,
            `"${q.rut || ''}"`,
            `"${(q.nombre || '').replace(/"/g, '""')}"`,
            `"${q.telefono || ''}"`,
            `"${q.correo || ''}"`,
            `"${q.estado || ''}"`,
            `"${q.personalizacion || ''}"`,
            `"${q.plazo || ''}"`,
            totalPrendas,
            `"${itemsStr.replace(/"/g, '""')}"`,
          ].join(',');
        });

        const csvContent = '\uFEFF' + [headers.join(','), ...rows].join('\r\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `cotizaciones-zortex-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Ventana de Impresión de Ficha Formal
    function printQuoteDoc(q) {
      const printWin = window.open('', '_blank', 'width=800,height=900');
      if (!printWin) return;

      const totalPrendas = q.items.reduce((acc, it) => acc + (parseInt(it.cantidad, 10) || 1), 0);
      const dateStr = q.created_at ? new Date(q.created_at).toLocaleString('es-CL') : '--';

      printWin.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <title>Cotización #${q.id} - ${q.empresa}</title>
          <style>
            body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 40px; color: #0F172A; }
            .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0F172A; padding-bottom: 20px; margin-bottom: 24px; }
            .logo { height: 40px; }
            .company-info { font-size: 12px; color: #64748B; text-align: right; }
            .title { font-size: 24px; font-weight: 800; margin: 0 0 4px; }
            .meta-box { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 16px; margin-bottom: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 13px; }
            table { width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 13.5px; }
            th { background: #F1F5F9; text-align: left; padding: 10px 12px; border-bottom: 1px solid #CBD5E1; font-size: 12px; text-transform: uppercase; }
            td { padding: 12px; border-bottom: 1px solid #E2E8F0; }
            .total-row td { font-weight: 800; font-size: 15px; background: #F8FAFC; }
            .footer-notes { font-size: 12px; color: #64748B; border-top: 1px solid #E2E8F0; padding-top: 16px; margin-top: 30px; }
          </style>
        </head>
        <body>
          <div class="header">
            <div>
              <h1 class="title">SOLICITUD DE COTIZACIÓN</h1>
              <div><strong>Nº Solicitud:</strong> #${q.id}</div>
              <div><strong>Fecha:</strong> ${dateStr}</div>
            </div>
            <div class="company-info">
              <strong>ZORTEX VESTUARIO & EPP</strong><br/>
              Distribución Mayorista B2B Chile<br/>
              contacto@zortex.cl • +56 9 5863 9727
            </div>
          </div>

          <div class="meta-box">
            <div><strong>Empresa / Razón Social:</strong> ${q.empresa || '--'}</div>
            <div><strong>RUT Empresa:</strong> ${q.rut || '--'}</div>
            <div><strong>Contacto Comercial:</strong> ${q.nombre || '--'}</div>
            <div><strong>Correo Electrónico:</strong> ${q.correo || '--'}</div>
            <div><strong>Teléfono:</strong> ${q.telefono || '--'}</div>
            <div><strong>Personalización:</strong> ${q.personalizacion || 'Sin logo'}</div>
            <div><strong>Plazo Requerido:</strong> ${q.plazo || 'Normal'}</div>
            <div><strong>Estado Actual:</strong> ${q.estado || 'Nuevo'}</div>
          </div>

          ${q.mensaje ? `<p><strong>Observaciones del Cliente:</strong> ${q.mensaje}</p>` : ''}

          <table>
            <thead>
              <tr>
                <th style="width: 60px;">Cant.</th>
                <th>Prenda / Modelo Requerido</th>
                <th>Categoría</th>
                <th>Talla</th>
              </tr>
            </thead>
            <tbody>
              ${q.items
                .map(
                  (it) => `
                <tr>
                  <td><strong>${it.cantidad || 1}</strong></td>
                  <td>${it.producto || 'Producto'}</td>
                  <td>${it.categoria || '--'}</td>
                  <td>${it.talla || 'Estándar'}</td>
                </tr>
              `
                )
                .join('')}
              <tr class="total-row">
                <td colspan="3" style="text-align: right;">Total Prendas Solicitadas:</td>
                <td>${totalPrendas} unidades</td>
              </tr>
            </tbody>
          </table>

          <div class="footer-notes">
            Documento emitido para evaluación y confección de propuesta comercial formal por ZORTEX. Precios mayoristas escalonados y condiciones de despacho válidas por 15 días hábiles.
          </div>
          <script>
            window.onload = function() { window.print(); };
          <\/script>
        </body>
        </html>
      `);
      printWin.document.close();
    }

    // Auto-actualización de cotizaciones en tiempo real cada 10 segundos o al enfocar ventana
    setInterval(() => {
      if (saasApp && saasApp.style.display !== 'none') {
        loadQuotes();
      }
    }, 10000);

    window.addEventListener('focus', () => {
      if (saasApp && saasApp.style.display !== 'none') {
        loadQuotes();
      }
    });

    // Escuchar eventos en vivo desde la tienda pública
    if (liveChannel) {
      liveChannel.addEventListener('message', (ev) => {
        if (ev.data && ev.data.type === 'QUOTES_UPDATED') {
          loadQuotes();
        }
      });
    }

    window.addEventListener('storage', (e) => {
      if (e.key === 'zortex_cms_updated') {
        loadQuotes();
      }
    });

    // -------------------------------------------------------------------------
    // 5. AJUSTES DE CONTENIDO (HERO & CONTACTO)
    // -------------------------------------------------------------------------
    async function loadSettings() {
      try {
        const res = await apiFetch('/api/admin/settings');
        if (!res.ok) return;
        const data = await res.json();
        const s = data.settings || {};
        if (setHeroBadge) setHeroBadge.value = s.heroBadge || '';
        if (setHeroTitle) setHeroTitle.value = s.heroTitle || '';
        if (setHeroLead) setHeroLead.value = s.heroLead || '';
        if (setContactEmail) setContactEmail.value = s.contactEmail || '';
        if (setContactPhone) setContactPhone.value = s.contactPhone || '';
        if (setTopbarWa) setTopbarWa.value = s.topbarWhatsappText || '';
      } catch (err) {
        console.error('Error al cargar ajustes:', err);
      }
    }

    if (settingsForm) {
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (settingsStatusMsg) {
          settingsStatusMsg.textContent = 'Guardando cambios en vivo...';
          settingsStatusMsg.className = 'status-msg';
        }

        const payload = {
          heroBadge: setHeroBadge?.value.trim() || '',
          heroTitle: setHeroTitle?.value.trim() || '',
          heroLead: setHeroLead?.value.trim() || '',
          contactEmail: setContactEmail?.value.trim() || '',
          contactPhone: setContactPhone?.value.trim() || '',
          topbarWhatsappText: setTopbarWa?.value.trim() || '',
        };

        try {
          const res = await apiFetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (res.ok) {
            if (settingsStatusMsg) {
              settingsStatusMsg.textContent = '✓ Guardado correctamente en vivo.';
              settingsStatusMsg.className = 'status-msg success';
              setTimeout(() => {
                if (settingsStatusMsg) settingsStatusMsg.textContent = '';
              }, 3000);
            }
            broadcastLiveChange('SETTINGS_UPDATED');
          }
        } catch (err) {
          if (settingsStatusMsg) {
            settingsStatusMsg.textContent = '✕ Error: ' + err.message;
            settingsStatusMsg.className = 'status-msg error';
          }
        }
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Arrancar autenticación inicial
    initAuth();
  })();
</script>
