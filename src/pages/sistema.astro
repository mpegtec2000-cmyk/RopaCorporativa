  .kpi-val {
    font-size: 22px;
    font-weight: 800;
    color: var(--saas-text-main);
  }

  /* Pane Header */
  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .pane-header h2 {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 4px;
    color: var(--saas-text-main);
  }

  .pane-header p {
    font-size: 13.5px;
    color: var(--saas-text-muted);
    margin: 0;
  }

  .btn-primary-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--saas-primary);
    color: #FFFFFF;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    transition: all 0.2s;
  }

  .btn-primary-add:hover {
    background: var(--saas-primary-hover);
    transform: translateY(-1px);
  }

  /* Filter Toolbar */
  .filter-toolbar {
    background: #FFFFFF;
    border: 1px solid var(--saas-border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
  }

  .filter-top-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .search-field {
    flex: 1;
    min-width: 280px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-field svg {
    position: absolute;
    left: 14px;
    color: #94A3B8;
  }

  .search-field input {
    width: 100%;
    padding: 10px 36px 10px 40px;
    background: #F8FAFC;
    border: 1.5px solid var(--saas-border-dark);
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--saas-text-main);
    box-sizing: border-box;
    outline: none;
  }

  .search-field input:focus {
    border-color: var(--saas-primary);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .btn-clear-search {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    color: #94A3B8;
    cursor: pointer;
    font-size: 13px;
  }

  .filter-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748B;
    margin-right: 6px;
  }

  .saas-select-filter {
