    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--saas-text-main);
    padding: 6px;
  }

  .breadcrumb {
    font-size: 14px;
    color: var(--saas-text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb strong {
    color: var(--saas-text-main);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-action-refresh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    border: 1px solid var(--saas-border-dark);
