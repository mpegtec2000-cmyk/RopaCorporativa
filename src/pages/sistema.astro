                      </div>
                    </div>
                    <div class="meta-ev-item">
                      <span class="ev-tag purple">Search</span>
                      <div>
                        <strong>Búsqueda en Catálogo</strong>
                        <small>Al buscar modelos o SKUs en el buscador</small>
                      </div>
                    </div>
                    <div class="meta-ev-item">
                      <span class="ev-tag amber">AddToCart</span>
                      <div>
                        <strong>Agregar a Cotización</strong>
                        <small>Al sumar prendas al carrito cotizador</small>
                      </div>
                    </div>
                    <div class="meta-ev-item">
                      <span class="ev-tag indigo">InitiateCheckout</span>
                      <div>
                        <strong>Iniciar Formulario</strong>
                        <small>Al pasar del carrito al formulario B2B</small>
                      </div>
                    </div>
                    <div class="meta-ev-item">
                      <span class="ev-tag green">Contact</span>
                      <div>
                        <strong>Clic a WhatsApp</strong>
                        <small>Flotante, header, modal, carrito y formulario</small>
                      </div>
                    </div>
                    <div class="meta-ev-item highlight">
                      <span class="ev-tag emerald">Lead</span>
                      <div>
                        <strong>Cotización Formal B2B (Conversión Clave)</strong>
                        <small>Con hashing SHA-256 de correo, teléfono y nombre</small>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Generador de Enlaces UTM para Meta Ads -->
                <div class="an-card">
                  <div class="an-card-head">
                    <div>
                      <h3>Generador de URLs UTM para Meta Ads</h3>
                      <p>Usa esta URL como destino de tu anuncio en Meta para atribuir visitas y cotizaciones en tu CRM.</p>
                    </div>
                  </div>
                  <div class="utm-builder-form">
                    <div class="form-grid-2">
                      <div class="form-row">
                        <label for="utm-platform">Plataforma (utm_source)</label>
                        <select id="utm-platform">
