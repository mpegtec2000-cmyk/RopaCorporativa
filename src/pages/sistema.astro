                    </div>

                    <div class="utm-output-box">
                      <label>URL Lista para Pegar en Meta Ads Manager:</label>
                      <div class="utm-url-preview" id="utm-url-preview">https://www.zortex.cl/?utm_source=meta&amp;utm_medium=paid_social&amp;utm_campaign=zortex-trafico-epp-mayo&amp;utm_content=video-bordado-01</div>
                      <div class="utm-output-actions">
                        <button type="button" class="btn-main" id="btn-copy-utm-url" style="padding: 9px 16px; font-size: 13px;">Copiar URL para Meta</button>
                        <button type="button" class="btn-subtle-action" id="btn-test-utm-local">Simular visita local con este UTM</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

