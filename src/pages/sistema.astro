    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-action-refresh:hover {
    background: #F1F5F9;
  }

  .live-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ECFDF5;
