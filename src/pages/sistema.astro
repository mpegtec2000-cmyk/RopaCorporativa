  .kpi-icon.amber { background: #FFFBEB; color: #D97706; }
  .kpi-icon.purple { background: #FAF5FF; color: #9333EA; }

  .kpi-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--saas-text-muted);
    margin-bottom: 2px;
