    function renderTimelineChart(series) {
      const container = document.getElementById('an-timeline-chart');
      if (!container) return;
      if (!series || series.length === 0) {
        container.innerHTML = '<div class="loading-state">Sin datos temporales todavía.</div>';
        return;
      }

      const W = 720;
      const H = 220;
      const padL = 34;
      const padR = 14;
      const padT = 18;
      const padB = 34;
      const plotW = W - padL - padR;
      const plotH = H - padT - padB;
      const maxVal = Math.max(4, ...series.map((s) => Math.max(s.visits || 0, s.conversions || 0)));
      const stepX = plotW / series.length;
      const barW = Math.max(6, Math.min(26, stepX * 0.42));

      const gridLines = [0, 0.25, 0.5, 0.75, 1]
        .map((ratio) => {
          const y = padT + plotH * (1 - ratio);
          const val = Math.round(maxVal * ratio);
          return `
            <line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="#E2E8F0" stroke-dasharray="3 3" />
            <text x="${padL - 6}" y="${y + 4}" text-anchor="end" font-size="10" fill="#64748B">${val}</text>
          `;
        })
        .join('');

      const bars = series
        .map((s, i) => {
          const cx = padL + i * stepX + stepX / 2;
          const vH = ((s.visits || 0) / maxVal) * plotH;
          const cH = ((s.conversions || 0) / maxVal) * plotH;
          const showLabel = series.length <= 12 || i % Math.ceil(series.length / 10) === 0 || i === series.length - 1;
          return `
            <g>
              <rect x="${cx - barW - 1}" y="${padT + plotH - vH}" width="${barW}" height="${Math.max(0, vH)}" rx="3" fill="#2563EB" opacity="0.88">
                <title>${escapeHtml(s.label)} — Visitas: ${s.visits} | Únicos: ${s.uniqueVisitors}</title>
              </rect>
              <rect x="${cx + 1}" y="${padT + plotH - cH}" width="${Math.max(5, barW * 0.72)}" height="${Math.max(0, cH)}" rx="3" fill="#10B981">
                <title>${escapeHtml(s.label)} — Contactos/Leads: ${s.conversions}</title>
              </rect>
              ${showLabel ? `<text x="${cx}" y="${H - 10}" text-anchor="middle" font-size="10" fill="#64748B">${escapeHtml(s.label)}</text>` : ''}
            </g>
          `;
        })
        .join('');

      container.innerHTML = `
        <svg class="an-svg-chart" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
          ${gridLines}
          ${bars}
        </svg>
      `;
    }

    const anRangePills = document.getElementById('an-range-pills');
    if (anRangePills) {
      anRangePills.addEventListener('click', (e) => {
        const btn = e.target.closest('.range-pill');
        if (!btn) return;
        anRangePills.querySelectorAll('.range-pill').forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        loadAnalytics(btn.getAttribute('data-range') || '7d');
      });
    }

    const btnGoUtmBuilder = document.getElementById('btn-go-utm-builder');
    if (btnGoUtmBuilder) {
      btnGoUtmBuilder.addEventListener('click', () => activateTab('tab-meta'));
    }

    const btnCopySqlHint = document.getElementById('btn-copy-sql-hint');
    if (btnCopySqlHint) {
      btnCopySqlHint.addEventListener('click', () => {
        alert(
          'Archivo listo en tu proyecto: supabase/analytics-crm-migration.sql\n\n' +
            '1. Abre Supabase → SQL Editor.\n' +
            '2. Pega el contenido de supabase/analytics-crm-migration.sql.\n' +
            '3. Presiona RUN.\n\n' +
            'Mientras tanto, tus visitas y campañas ya se registran automáticamente en modo buffer.'
        );
      });
    }

    // Auto-refresco analítica cada 15s mientras esté visible
    setInterval(() => {
      const anTab = document.getElementById('tab-analytics');
      if (saasApp && saasApp.style.display !== 'none' && anTab && anTab.style.display !== 'none') {
        loadAnalytics();
      }
    }, 15000);

    // -------------------------------------------------------------------------
    // 7. META PIXEL, CONVERSIONS API (CAPI) & GENERADOR UTM
    // -------------------------------------------------------------------------
    const metaPixelEnabledEl = document.getElementById('meta-pixel-enabled');
    const metaPixelIdEl = document.getElementById('meta-pixel-id');
    const metaDomainVerifEl = document.getElementById('meta-domain-verif');
    const metaCapiTokenEl = document.getElementById('meta-capi-token');
    const metaTestCodeEl = document.getElementById('meta-test-code');
    const metaSettingsForm = document.getElementById('meta-settings-form');
    const metaSettingsStatus = document.getElementById('meta-settings-status');
    const metaHealthPill = document.getElementById('meta-health-pill');
    const metaStatusNav = document.getElementById('meta-status-nav');
    const metaCapiBadge = document.getElementById('meta-capi-badge');
    const metaTestOutput = document.getElementById('meta-test-output');

    function populateMetaSettingsUI(s) {
      if (metaPixelEnabledEl) metaPixelEnabledEl.checked = Boolean(s.metaPixelEnabled);
      if (metaPixelIdEl) metaPixelIdEl.value = s.metaPixelId || '';
      if (metaDomainVerifEl) metaDomainVerifEl.value = s.metaDomainVerification || '';
      if (metaTestCodeEl) metaTestCodeEl.value = s.metaTestEventCode || '';
      if (metaCapiTokenEl) metaCapiTokenEl.value = '';

      const isActive = Boolean(s.metaPixelEnabled && s.metaPixelId);
      const hasCapi = Boolean(s.hasMetaCapiToken);

      if (metaHealthPill) {
        metaHealthPill.classList.toggle('active', isActive);
        metaHealthPill.textContent = isActive
          ? hasCapi
            ? `✓ Pixel + CAPI Activos (${s.metaPixelId})`
            : `✓ Pixel Activo (${s.metaPixelId}) · Falta CAPI`
          : 'Pixel Inactivo — Configura tu Pixel ID';
      }
      if (metaStatusNav) {
        metaStatusNav.textContent = isActive ? 'ON' : 'OFF';
        metaStatusNav.classList.toggle('nav-count-live', isActive);
      }
      if (metaCapiBadge) {
        metaCapiBadge.textContent = hasCapi ? '✓ Configurado en Servidor' : 'No configurado';
        metaCapiBadge.className = `capi-badge ${hasCapi ? 'on' : 'off'}`;
      }
    }

    if (metaSettingsForm) {
      metaSettingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (metaSettingsStatus) {
          metaSettingsStatus.textContent = 'Guardando configuración Meta...';
          metaSettingsStatus.className = 'status-msg';
        }
        const payload = {
          metaPixelEnabled: Boolean(metaPixelEnabledEl?.checked),
          metaPixelId: (metaPixelIdEl?.value || '').replace(/[^\d]/g, ''),
          metaDomainVerification: (metaDomainVerifEl?.value || '').trim(),
          metaTestEventCode: (metaTestCodeEl?.value || '').trim(),
        };
        const rawToken = (metaCapiTokenEl?.value || '').trim();
        if (rawToken) payload.metaCapiToken = rawToken;

        try {
          const res = await apiFetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.settings) {
            populateMetaSettingsUI(data.settings);
            if (metaSettingsStatus) {
              metaSettingsStatus.textContent = '✓ Configuración Meta guardada y activa en vivo.';
              metaSettingsStatus.className = 'status-msg success';
            }
          } else if (metaSettingsStatus) {
            metaSettingsStatus.textContent = '✕ ' + (data.error || 'Error guardando configuración.');
            metaSettingsStatus.className = 'status-msg error';
          }
        } catch (err) {
          if (metaSettingsStatus) {
            metaSettingsStatus.textContent = '✕ Error de red: ' + err.message;
            metaSettingsStatus.className = 'status-msg error';
          }
        }
      });
    }

    async function runMetaCapiTest(eventName) {
      if (metaTestOutput) metaTestOutput.textContent = `Enviando evento "${eventName}" a Meta Graph API v21.0...`;
      try {
        const res = await apiFetch('/api/admin/meta-test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            eventName,
            testEventCode: (metaTestCodeEl?.value || '').trim() || undefined,
          }),
        });
        const data = await res.json();
        if (metaTestOutput) {
          metaTestOutput.textContent = JSON.stringify(data, null, 2);
        }
      } catch (err) {
        if (metaTestOutput) metaTestOutput.textContent = 'Error de conexión: ' + err.message;
      }
    }

    document.getElementById('btn-test-meta-pv')?.addEventListener('click', () => runMetaCapiTest('PageView'));
    document.getElementById('btn-test-meta-lead')?.addEventListener('click', () => runMetaCapiTest('Lead'));

    // Generador UTM
    const utmPlatformEl = document.getElementById('utm-platform');
    const utmLandingEl = document.getElementById('utm-landing');
    const utmCampaignEl = document.getElementById('utm-campaign');
    const utmContentEl = document.getElementById('utm-content');
    const utmPreviewEl = document.getElementById('utm-url-preview');

    function slugUtm(v) {
      return (v || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function buildUtmUrl(baseOrigin) {
      const origin = baseOrigin || 'https://www.zortex.cl';
      const landing = utmLandingEl?.value || '/';
      const [pathPart, hashPart] = landing.split('#');
      const params = new URLSearchParams();
      params.set('utm_source', utmPlatformEl?.value || 'meta');
      params.set('utm_medium', 'paid_social');
      const camp = slugUtm(utmCampaignEl?.value || 'campana-zortex');
      if (camp) params.set('utm_campaign', camp);
      const cont = slugUtm(utmContentEl?.value || '');
      if (cont) params.set('utm_content', cont);
      return `${origin}${pathPart || '/'}?${params.toString()}${hashPart ? '#' + hashPart : ''}`;
    }

    function refreshUtmPreview() {
      if (utmPreviewEl) utmPreviewEl.textContent = buildUtmUrl('https://www.zortex.cl');
    }
    [utmPlatformEl, utmLandingEl, utmCampaignEl, utmContentEl].forEach((el) => {
      if (el) {
        el.addEventListener('input', refreshUtmPreview);
        el.addEventListener('change', refreshUtmPreview);
      }
    });
    refreshUtmPreview();

    document.getElementById('btn-copy-utm-url')?.addEventListener('click', async (e) => {
      const url = buildUtmUrl('https://www.zortex.cl');
      try {
        await navigator.clipboard.writeText(url);
        const btn = e.currentTarget;
        const prev = btn.textContent;
        btn.textContent = '✓ URL Copiada';
        setTimeout(() => (btn.textContent = prev), 1800);
      } catch {
        prompt('Copia tu URL UTM para Meta Ads:', url);
      }
    });

    document.getElementById('btn-test-utm-local')?.addEventListener('click', () => {
      const localUrl = buildUtmUrl(window.location.origin);
      window.open(localUrl, '_blank');
    });

    // Arrancar autenticación inicial
    initAuth();
  })();
</script>
