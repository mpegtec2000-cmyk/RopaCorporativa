---
import Layout from '../layouts/Layout.astro';
import { PRODUCT_CATEGORIES } from '../lib/cms/types';

export const prerender = true;
---

<Layout title="SaaS CMS ZORTEX | Panel de Administración B2B" noindex={true}>
  <div class="saas-shell" id="saas-shell">
    
    <!-- =====================================================================
         1. PANTALLA DE ACCESO (LOGIN)
         ===================================================================== -->
    <section id="auth-screen" class="auth-view">
      <div class="auth-box">
        <div class="auth-brand">
          <img src="/images/zortex-logo-dark.png" alt="ZORTEX" class="auth-logo" />
          <span class="auth-pill">PORTAL SAAS B2B</span>
        </div>
        
        <div class="auth-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>

        <h1 class="auth-title">Ingreso al Sistema</h1>
        <p class="auth-desc">Administración de Catálogo, Carga de Imágenes, Cotizaciones y Contenido en Vivo</p>

        <form id="login-form" class="auth-form" autocomplete="off">
          <div class="field-block">
            <label for="login-user">Usuario Administrador</label>
            <div class="field-input-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input type="text" id="login-user" name="username" placeholder="ZORTEX" value="ZORTEX" required autofocus />
            </div>
          </div>

          <div class="field-block">
            <label for="login-pass">Contraseña</label>
            <div class="field-input-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input type="password" id="login-pass" name="password" placeholder="••••••••" required />
            </div>
            <div class="auth-hint">Clave oficial: <code>zortex</code></div>
          </div>

          <div id="login-err" class="alert-box error" style="display: none;">
            Usuario o contraseña incorrectos.
          </div>

          <button type="submit" class="btn-main" id="btn-login">
            <span>Iniciar Sesión en el SaaS</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <div class="auth-footer-link">
          <a href="/">← Volver a la Tienda Pública</a>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         2. APLICACIÓN PRINCIPAL SAAS (SIDEBAR + WORKSPACE)
         ===================================================================== -->
    <div id="saas-app" class="app-layout" style="display: none;">
      
      <!-- Barra lateral (Sidebar) -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <a href="/" class="sidebar-brand" title="Ir a la web pública">
            <img src="/images/zortex-logo-dark.png" alt="ZORTEX" class="sidebar-logo" />
          </a>
          <span class="saas-badge-pill">SaaS PRO</span>
        </div>

        <nav class="sidebar-menu">
          <button type="button" class="nav-item active" data-tab="tab-products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span>Catálogo & Productos</span>
            <span class="nav-count" id="count-products-nav">0</span>
          </button>

          <button type="button" class="nav-item" data-tab="tab-quotes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Cotizaciones B2B</span>
            <span class="nav-count nav-count-alert" id="count-quotes-nav">0</span>
          </button>

          <button type="button" class="nav-item" data-tab="tab-content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Textos & Portada</span>
          </button>
        </nav>

        <div class="sidebar-footer">
          <div class="backend-status-card">
            <span class="status-indicator-dot"></span>
            <div class="status-text-block">
              <strong>Base de Datos:</strong>
              <span id="backend-label">Conectando...</span>
            </div>
          </div>

          <div class="user-strip">
            <div class="user-avatar">ZX</div>
            <div class="user-meta">
              <strong>ZORTEX Admin</strong>
              <span>Conectado en Vivo</span>
            </div>
          </div>

          <div class="footer-btns">
            <a href="/" target="_blank" class="btn-subtle" title="Abrir tienda en pestaña nueva">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>Ver Web</span>
            </a>
            <button type="button" class="btn-logout" id="btn-logout" title="Cerrar sesión">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Salir</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- Contenedor Principal (Workspace) -->
      <main class="workspace">
        
        <!-- Header superior -->
        <header class="topbar">
          <div class="topbar-left">
            <button type="button" class="btn-sidebar-toggle" id="btn-sidebar-toggle" aria-label="Alternar menú">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <div class="breadcrumb">
              <span>SaaS ZORTEX</span>
              <span class="sep">/</span>
              <strong id="topbar-section-title">Catálogo & Productos</strong>
            </div>
          </div>

          <div class="topbar-right">
            <button type="button" class="btn-action-refresh" id="btn-global-refresh" title="Sincronizar datos">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              <span>Sincronizar</span>
            </button>
            <span class="live-tag">
              <span class="pulse-dot"></span> EN VIVO
            </span>
          </div>
        </header>

        <div class="workspace-body">
          
          <!-- ================= TAB 1: PRODUCTOS ================= -->
          <section id="tab-products" class="tab-pane active">
            
            <!-- Tarjetas de métricas rápidas (KPIs) -->
            <div class="kpi-grid">
              <div class="kpi-card">
                <div class="kpi-icon blue">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Total en Catálogo</span>
                  <strong class="kpi-val" id="kpi-total-prods">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon green">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Activos en Tienda</span>
                  <strong class="kpi-val" id="kpi-active-prods">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon amber">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Ocultos / Pausados</span>
                  <strong class="kpi-val" id="kpi-inactive-prods">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon purple">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Cotizaciones B2B</span>
                  <strong class="kpi-val" id="kpi-total-quotes">0</strong>
                </div>
              </div>
            </div>

            <!-- Cabecera de sección de catálogo -->
            <div class="pane-header">
              <div>
                <h2>Catálogo Maestro de Productos</h2>
                <p>Edita fotos, modelos, SKUs, categorías, curvas de tallas y visibilidad en tiempo real para la tienda online.</p>
              </div>
              <div class="pane-header-actions">
                <button type="button" class="btn-primary-add" id="btn-open-create-prod">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>Crear Nuevo Producto</span>
                </button>
              </div>
            </div>

            <!-- Barra de Filtros y Búsqueda -->
            <div class="filter-toolbar">
              <div class="filter-top-row">
                <div class="search-field">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <input type="text" id="prod-search-input" placeholder="Buscar por nombre, modelo, SKU o tela (ej: oxford, cargo, softshell)..." />
                  <button type="button" id="btn-clear-search" class="btn-clear-search" style="display: none;" title="Limpiar búsqueda">✕</button>
                </div>

                <div class="status-select-wrap">
                  <span class="filter-label">Estado:</span>
                  <select id="prod-status-filter" class="saas-select-filter">
                    <option value="all">Todos los estados</option>
                    <option value="active">Solo Activos en Tienda</option>
                    <option value="inactive">Solo Inactivos / Pausados</option>
                  </select>
                </div>

                <div class="items-per-page-wrap">
                  <span class="filter-label">Por página:</span>
                  <select id="prod-page-size" class="saas-select-filter">
                    <option value="25" selected>25 modelos</option>
                    <option value="50">50 modelos</option>
                    <option value="100">100 modelos</option>
                    <option value="all">Todos (sin paginar)</option>
                  </select>
                </div>
              </div>

              <!-- Chips de Categoría -->
              <div class="category-chips-bar" id="cat-filter-chips">
                <button type="button" class="chip active" data-cat="all">Todas las Categorías (<span id="count-all-chip">0</span>)</button>
                {PRODUCT_CATEGORIES.map(cat => (
                  <button type="button" class="chip" data-cat={cat}>{cat}</button>
                ))}
              </div>
            </div>

            <!-- Tabla de productos con dimensionamiento estricto y seguro -->
            <div class="table-card">
              <div class="table-responsive">
                <table class="saas-table" id="prods-table">
                  <thead>
                    <tr>
                      <th class="th-thumb" style="width: 76px;">Foto</th>
                      <th class="th-prod" style="width: auto;">Producto & Modelo</th>
                      <th class="th-sku" style="width: 120px;">Código / SKU</th>
                      <th class="th-cat" style="width: 160px;">Categoría</th>
                      <th class="th-sizes" style="width: 150px;">Curva Tallas</th>
                      <th class="th-status" style="width: 120px; text-align: center;">Visibilidad</th>
                      <th class="th-actions" style="width: 130px; text-align: right;">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="prods-tbody">
                    <tr>
                      <td colspan="7" class="loading-td">Cargando catálogo en tiempo real...</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Footer con resumen y paginación interactiva -->
              <div class="table-footer-bar">
                <div class="footer-summary-text" id="table-summary-lbl">
                  Mostrando 0 productos
                </div>

                <div class="pagination-controls" id="pagination-controls">
                  <button type="button" class="page-nav-btn" id="btn-prev-page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Anterior</span>
                  </button>
                  <span class="page-counter-lbl" id="page-counter-lbl">Página 1 de 1</span>
                  <button type="button" class="page-nav-btn" id="btn-next-page">
                    <span>Siguiente</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <!-- ================= TAB 2: COTIZACIONES B2B ================= -->
          <section id="tab-quotes" class="tab-pane" style="display: none;">
            
            <!-- KPIs de Cotizaciones -->
            <div class="kpi-grid">
              <div class="kpi-card">
                <div class="kpi-icon purple">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Total Cotizaciones</span>
                  <strong class="kpi-val" id="q-stat-total">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon amber">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Nuevas por Gestionar</span>
                  <strong class="kpi-val" id="q-stat-new">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon blue">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><path d="M16 12l-4-4-4 4M12 16V8"></path></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">En Gestión / Cotizadas</span>
                  <strong class="kpi-val" id="q-stat-prog">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon green">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Ganadas / Cerradas</span>
                  <strong class="kpi-val" id="q-stat-won">0</strong>
                </div>
              </div>
            </div>

            <!-- Cabecera de la sección -->
            <div class="pane-header">
              <div>
                <h2>Bandeja de Cotizaciones Mayoristas B2B</h2>
                <p>Monitoreo y seguimiento en tiempo real de solicitudes de empresas y clientes recibidas desde la tienda.</p>
              </div>
              <div class="pane-header-actions">
                <button type="button" class="btn-subtle-action" id="btn-create-test-quote" title="Crea un pedido de prueba para ver el flujo">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                  <span>Generar Cotización de Prueba</span>
                </button>
                <button type="button" class="btn-subtle-action" id="btn-export-quotes-csv" title="Descargar todas las solicitudes en archivo compatible con Excel">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  <span>Exportar a Excel (CSV)</span>
                </button>
              </div>
            </div>

            <!-- Toolbar de Filtros y Búsqueda de Cotizaciones -->
            <div class="filter-toolbar">
              <div class="filter-top-row">
                <div class="search-field" style="max-width: 440px;">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <input type="text" id="quote-search-input" placeholder="Buscar por empresa, RUT, contacto, correo o producto..." />
                  <button type="button" id="btn-clear-quote-search" class="btn-clear-search" style="display: none;">✕</button>
                </div>

                <div class="category-chips-bar" id="quote-status-filter-chips" style="border: none; padding: 0;">
                  <button type="button" class="chip active" data-status="all">Todas (<span id="count-q-all">0</span>)</button>
                  <button type="button" class="chip" data-status="nuevo">Nuevas (<span id="count-q-nuevo">0</span>)</button>
                  <button type="button" class="chip" data-status="en_gestion">En Gestión (<span id="count-q-gestion">0</span>)</button>
                  <button type="button" class="chip" data-status="cotizado">Cotizadas (<span id="count-q-cotizado">0</span>)</button>
                  <button type="button" class="chip" data-status="ganado">Ganadas (<span id="count-q-ganado">0</span>)</button>
                  <button type="button" class="chip" data-status="perdido">Perdidas (<span id="count-q-perdido">0</span>)</button>
                </div>
              </div>
            </div>

            <!-- Listado Dinámico de Cotizaciones -->
            <div id="quotes-container" class="quotes-grid">
              <div class="loading-state">Cargando cotizaciones...</div>
            </div>
          </section>

          <!-- ================= TAB 3: CONTENIDO ================= -->
          <section id="tab-content" class="tab-pane" style="display: none;">
            <div class="pane-header">
              <div>
                <h2>Textos y Configuración de Portada (Hero)</h2>
                <p>Edita los textos de la página principal y datos de contacto oficiales en tiempo real.</p>
              </div>
            </div>

            <div class="settings-card">
              <form id="settings-form" class="settings-form">
                <div class="form-group-section">
                  <h3>Portada Principal (Hero)</h3>
                  
                  <div class="form-row">
                    <label for="set-hero-badge">Insignia / Badge Superior</label>
                    <input type="text" id="set-hero-badge" name="heroBadge" />
                  </div>

                  <div class="form-row">
                    <label for="set-hero-title">Titular Principal (H1)</label>
                    <textarea id="set-hero-title" name="heroTitle" rows="2"></textarea>
                  </div>

                  <div class="form-row">
                    <label for="set-hero-lead">Bajada Comercial / Descripción</label>
                    <textarea id="set-hero-lead" name="heroLead" rows="3"></textarea>
                  </div>
                </div>

                <div class="form-group-section">
                  <h3>Contacto Oficial y WhatsApp</h3>
                  
                  <div class="form-grid-2">
                    <div class="form-row">
                      <label for="set-contact-email">Correo de Ventas</label>
                      <input type="email" id="set-contact-email" name="contactEmail" />
                    </div>
                    <div class="form-row">
                      <label for="set-contact-phone">Teléfono / WhatsApp de Contacto</label>
                      <input type="text" id="set-contact-phone" name="contactPhone" />
                    </div>
                  </div>

                  <div class="form-row">
                    <label for="set-topbar-wa">Texto de WhatsApp en Barra Superior</label>
                    <input type="text" id="set-topbar-wa" name="topbarWhatsappText" />
                  </div>
                </div>

                <div class="form-actions-bar">
                  <span id="settings-status-msg" class="status-msg"></span>
                  <button type="submit" class="btn-main" id="btn-save-settings">
                    <span>Guardar Cambios en Vivo</span>
                  </button>
                </div>
              </form>
            </div>
          </section>

        </div>
      </main>
    </div>

    <!-- =====================================================================
         3. MODAL FULL STACK: EDITOR / CREADOR DE PRODUCTO
         ===================================================================== -->
    <div id="prod-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-lg">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <span class="modal-tag">CATÁLOGO ZORTEX</span>
            <h3 id="modal-prod-title">Editar Producto</h3>
          </div>
          <button type="button" class="btn-close-modal" id="btn-close-prod-modal" aria-label="Cerrar">×</button>
        </div>

        <form id="prod-form" class="modal-form">
          <input type="hidden" id="modal-prod-id" />

          <div class="modal-two-columns">
            
            <!-- Columna Izquierda: Estudio de Imagen & Carga -->
            <div class="modal-col-media">
              <span class="sub-label">Imagen del Producto</span>
              
              <!-- Previsualización en Vivo de Imagen -->
              <div class="prod-img-stage" id="modal-img-preview-box">
                <img id="m-preview-img" src="/images/catalogo/polera-corporativa.webp" alt="Previsualización" />
                <span class="preview-badge" id="m-preview-badge">Vista Previa</span>
              </div>

              <!-- Zona de subida de archivo desde el equipo -->
              <div class="upload-dropzone" id="upload-dropzone">
                <input type="file" id="file-uploader-input" accept="image/png,image/jpeg,image/webp,image/avif" style="display: none;" />
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <div class="dropzone-text">
                  <strong>Haz clic para subir desde tu equipo</strong>
                  <span>o arrastra aquí tu foto (JPG, PNG, WEBP)</span>
                </div>
              </div>

              <div id="upload-progress-box" class="upload-progress-box" style="display: none;">
                <span class="spinner-inline"></span>
                <span id="upload-progress-text">Subiendo imagen al servidor...</span>
              </div>

              <!-- Botón selector de Galería existente -->
              <button type="button" class="btn-browse-gallery" id="btn-open-gallery-picker">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <span>Elegir foto existente de la Galería</span>
              </button>

              <!-- Campo de texto URL directo -->
              <div class="form-row direct-url-row">
                <label for="m-prod-image">Ruta o URL Directa</label>
                <div class="input-with-action">
                  <input type="text" id="m-prod-image" required placeholder="/images/catalogo/... o https://..." />
                  <button type="button" id="btn-sync-url-preview" class="btn-input-test" title="Cargar vista previa">Ver</button>
                </div>
              </div>
            </div>

            <!-- Columna Derecha: Información del Producto -->
            <div class="modal-col-data">
              <div class="form-grid-2">
                <div class="form-row">
                  <label for="m-prod-name">Nombre Comercial del Modelo *</label>
                  <input type="text" id="m-prod-name" required placeholder="Ej: Parka Térmica Industrial Alerce" />
                </div>

                <div class="form-row">
                  <label for="m-prod-sku">Código / SKU *</label>
                  <input type="text" id="m-prod-sku" placeholder="Ej: 08460" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-row">
                  <label for="m-prod-category">Categoría Principal *</label>
                  <select id="m-prod-category" required>
                    {PRODUCT_CATEGORIES.map(cat => (
                      <option value={cat}>{cat}</option>
                    ))}
                  </select>
                </div>

                <div class="form-row">
                  <label for="m-prod-line">Línea Técnica / Colección</label>
                  <input type="text" id="m-prod-line" placeholder="Ej: High-Tech / Outwork" />
                </div>
              </div>

              <!-- Curva de tallas con chips rápidos -->
              <div class="form-row">
                <label for="m-prod-sizes">Curva de Tallas Disponibles</label>
                <input type="text" id="m-prod-sizes" placeholder="S, M, L, XL, XXL, 3XL" />
                <div class="quick-sizes-bar">
                  <span class="quick-hint-label">Añadir talla rápida:</span>
                  <button type="button" class="btn-quick-size" data-size="XS">+ XS</button>
                  <button type="button" class="btn-quick-size" data-size="S">+ S</button>
                  <button type="button" class="btn-quick-size" data-size="M">+ M</button>
                  <button type="button" class="btn-quick-size" data-size="L">+ L</button>
                  <button type="button" class="btn-quick-size" data-size="XL">+ XL</button>
                  <button type="button" class="btn-quick-size" data-size="XXL">+ XXL</button>
                  <button type="button" class="btn-quick-size" data-size="3XL">+ 3XL</button>
                  <button type="button" class="btn-quick-size" data-size="Única">+ Única</button>
                </div>
              </div>

              <div class="form-row">
                <label for="m-prod-summary">Ficha Breve / Descripción Técnica</label>
                <textarea id="m-prod-summary" rows="3" placeholder="Composición textil, certificaciones, gramaje y usos recomendados..."></textarea>
              </div>

              <div class="form-row checkbox-row">
                <label class="toggle-control">
                  <input type="checkbox" id="m-prod-active" checked />
                  <span class="toggle-slider"></span>
                  <span class="toggle-label">Producto Activo y Visible en la Tienda Pública</span>
                </label>
              </div>
            </div>

          </div>

          <div class="modal-actions">
            <button type="button" class="btn-cancel" id="btn-cancel-prod-modal">Cancelar</button>
            <button type="submit" class="btn-main" id="btn-save-prod">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Guardar Producto en Vivo</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- =====================================================================
         4. MODAL SELECTOR DE GALERÍA DE IMÁGENES
         ===================================================================== -->
    <div id="gallery-modal" class="modal-backdrop" style="display: none; z-index: 1050;">
      <div class="modal-card modal-md">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <span class="modal-tag">GALERÍA DISPONIBLE</span>
            <h3>Elegir Imagen del Catálogo</h3>
          </div>
          <button type="button" class="btn-close-modal" id="btn-close-gallery" aria-label="Cerrar">×</button>
        </div>
        <div class="gallery-modal-body">
          <p class="gallery-lead">Haz clic en cualquier foto existente para asignarla al producto:</p>
          <div class="gallery-grid" id="gallery-grid">
            <div class="loading-state">Explorando fotos del catálogo...</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</Layout>

<!-- =========================================================================
     ESTILOS GLOBALES SAAS (Dimensionamiento Estricto & Diseño Profesional)
     ========================================================================= -->
<style is:global>
  /* Variables y Resets SaaS */
  :root {
    --saas-bg: #F8FAFC;
    --saas-card-bg: #FFFFFF;
    --saas-border: #E2E8F0;
    --saas-border-dark: #CBD5E1;
    --saas-text-main: #0F172A;
    --saas-text-muted: #64748B;
    --saas-primary: #2563EB;
    --saas-primary-hover: #1D4ED8;
    --saas-success: #059669;
    --saas-danger: #DC2626;
  }

  body {
    background-color: var(--saas-bg);
    margin: 0;
    padding: 0;
    color: var(--saas-text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Shell General */
  .saas-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* 1. Login View */
  .auth-view {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #F1F5F9;
  }

  .auth-box {
    background: #FFFFFF;
    border: 1px solid var(--saas-border);
    border-radius: 16px;
    padding: 40px;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    text-align: center;
    box-sizing: border-box;
  }

  .auth-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .auth-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .auth-pill {
    background: #0F172A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.06em;
  }

  .auth-icon-wrap {
    width: 52px;
    height: 52px;
    background: #EFF6FF;
    color: var(--saas-primary);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .auth-title {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 6px;
    color: var(--saas-text-main);
  }

  .auth-desc {
    font-size: 13.5px;
    color: var(--saas-text-muted);
    margin: 0 0 28px;
    line-height: 1.4;
  }

  .field-block {
    text-align: left;
    margin-bottom: 18px;
  }

  .field-block label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .field-input-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field-input-box svg {
    position: absolute;
    left: 12px;
    color: #94A3B8;
  }

  .field-input-box input {
    width: 100%;
    padding: 11px 14px 11px 40px;
    background: #F8FAFC;
    border: 1.5px solid var(--saas-border-dark);
    border-radius: 8px;
    font-size: 14px;
    color: var(--saas-text-main);
    box-sizing: border-box;
    outline: none;
    transition: all 0.2s;
  }

  .field-input-box input:focus {
    border-color: var(--saas-primary);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .auth-hint {
    font-size: 11.5px;
    color: var(--saas-text-muted);
    margin-top: 5px;
    text-align: right;
  }

  .auth-hint code {
    background: #F1F5F9;
    padding: 2px 5px;
    border-radius: 4px;
    font-weight: 700;
    color: #0F172A;
  }

  .alert-box.error {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #DC2626;
    padding: 10px;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 16px;
  }

  .btn-main {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--saas-primary);
    color: #FFFFFF;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    transition: all 0.2s;
  }

  .btn-main:hover {
    background: var(--saas-primary-hover);
    transform: translateY(-1px);
  }

  .auth-footer-link {
    margin-top: 24px;
    font-size: 13px;
  }

  .auth-footer-link a {
    color: var(--saas-text-muted);
    text-decoration: none;
    font-weight: 600;
  }

  .auth-footer-link a:hover {
    color: var(--saas-text-main);
  }

  /* 2. App Layout */
  .app-layout {
    display: flex;
    min-height: 100vh;
    width: 100%;
  }

  /* Sidebar */
  .sidebar {
    width: 260px;
    min-width: 260px;
    background: #FFFFFF;
    border-right: 1px solid var(--saas-border);
    display: flex;
    flex-direction: column;
    z-index: 100;
  }

  .sidebar-header {
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--saas-border);
  }

  .sidebar-logo {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  .saas-badge-pill {
    background: #0F172A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .sidebar-menu {
    flex: 1;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #475569;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-item:hover {
    background: #F1F5F9;
    color: var(--saas-text-main);
  }

  .nav-item.active {
    background: #EFF6FF;
    color: var(--saas-primary);
    font-weight: 700;
  }

  .nav-count {
    margin-left: auto;
    background: #E2E8F0;
    color: #334155;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
  }

  .nav-item.active .nav-count {
    background: #DBEAFE;
    color: #1E40AF;
  }

  .nav-count-alert {
    background: #FEF3C7;
    color: #B45309;
  }

  .sidebar-footer {
    padding: 16px;
    border-top: 1px solid var(--saas-border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .backend-status-card {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #F8FAFC;
    border: 1px solid var(--saas-border);
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 11.5px;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--saas-success);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    flex-shrink: 0;
  }

  .status-text-block strong {
    display: block;
    color: #64748B;
    font-size: 10px;
    text-transform: uppercase;
  }

  .status-text-block span {
    color: var(--saas-text-main);
    font-weight: 700;
  }

  .user-strip {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0F172A;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
  }

  .user-meta strong {
    display: block;
    font-size: 12.5px;
    color: var(--saas-text-main);
  }

  .user-meta span {
    font-size: 11px;
    color: var(--saas-success);
    font-weight: 600;
  }

  .footer-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .btn-subtle, .btn-logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--saas-border);
    cursor: pointer;
    background: #FFFFFF;
    color: #475569;
    transition: all 0.2s;
  }

  .btn-subtle:hover {
    background: #F1F5F9;
    color: var(--saas-text-main);
  }

  .btn-logout:hover {
    background: #FEF2F2;
    color: var(--saas-danger);
    border-color: #FECACA;
  }

  /* Workspace */
  .workspace {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--saas-bg);
  }

  /* Topbar */
  .topbar {
    height: 64px;
    background: #FFFFFF;
    border-bottom: 1px solid var(--saas-border);
