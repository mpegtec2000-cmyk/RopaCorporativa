                <div class="form-row">
                  <label for="m-prod-sku">Código / SKU *</label>
                  <input type="text" id="m-prod-sku" placeholder="Ej: 08460" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-row">
                  <label for="m-prod-category">Categoría Principal *</label>
                  <select id="m-prod-category" required>
                    {PRODUCT_CATEGORIES.map(cat => (
                      <option value={cat}>{cat}</option>
                    ))}
                  </select>
                </div>

                <div class="form-row">
                  <label for="m-prod-line">Línea Técnica / Colección</label>
                  <input type="text" id="m-prod-line" placeholder="Ej: High-Tech / Outwork" />
                </div>
              </div>

              <!-- Curva de tallas con chips rápidos -->
              <div class="form-row">
                <label for="m-prod-sizes">Curva de Tallas Disponibles</label>
                <input type="text" id="m-prod-sizes" placeholder="S, M, L, XL, XXL, 3XL" />
                <div class="quick-sizes-bar">
                  <span class="quick-hint-label">Añadir talla rápida:</span>
                  <button type="button" class="btn-quick-size" data-size="XS">+ XS</button>
                  <button type="button" class="btn-quick-size" data-size="S">+ S</button>
                  <button type="button" class="btn-quick-size" data-size="M">+ M</button>
                  <button type="button" class="btn-quick-size" data-size="L">+ L</button>
                  <button type="button" class="btn-quick-size" data-size="XL">+ XL</button>
                  <button type="button" class="btn-quick-size" data-size="XXL">+ XXL</button>
                  <button type="button" class="btn-quick-size" data-size="3XL">+ 3XL</button>
                  <button type="button" class="btn-quick-size" data-size="Única">+ Única</button>
                </div>
              </div>

              <div class="form-row">
                <label for="m-prod-summary">Ficha Breve / Descripción Técnica</label>
                <textarea id="m-prod-summary" rows="3" placeholder="Composición textil, certificaciones, gramaje y usos recomendados..."></textarea>
              </div>

              <div class="form-row checkbox-row">
                <label class="toggle-control">
                  <input type="checkbox" id="m-prod-active" checked />
                  <span class="toggle-slider"></span>
                  <span class="toggle-label">Producto Activo y Visible en la Tienda Pública</span>
                </label>
              </div>
            </div>

          </div>

          <div class="modal-actions">
            <button type="button" class="btn-cancel" id="btn-cancel-prod-modal">Cancelar</button>
            <button type="submit" class="btn-main" id="btn-save-prod">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Guardar Producto en Vivo</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- =====================================================================
         4. MODAL SELECTOR DE GALERÍA DE IMÁGENES
         ===================================================================== -->
    <div id="gallery-modal" class="modal-backdrop" style="display: none; z-index: 1050;">
      <div class="modal-card modal-md">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <span class="modal-tag">GALERÍA DISPONIBLE</span>
            <h3>Elegir Imagen del Catálogo</h3>
          </div>
          <button type="button" class="btn-close-modal" id="btn-close-gallery" aria-label="Cerrar">×</button>
        </div>
        <div class="gallery-modal-body">
          <p class="gallery-lead">Haz clic en cualquier foto existente para asignarla al producto:</p>
          <div class="gallery-grid" id="gallery-grid">
            <div class="loading-state">Explorando fotos del catálogo...</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</Layout>

<!-- =========================================================================
     ESTILOS GLOBALES SAAS (Dimensionamiento Estricto & Diseño Profesional)
     ========================================================================= -->
<style is:global>
  /* Variables y Resets SaaS */
  :root {
    --saas-bg: #F8FAFC;
    --saas-card-bg: #FFFFFF;
    --saas-border: #E2E8F0;
    --saas-border-dark: #CBD5E1;
    --saas-text-main: #0F172A;
    --saas-text-muted: #64748B;
    --saas-primary: #2563EB;
    --saas-primary-hover: #1D4ED8;
    --saas-success: #059669;
    --saas-danger: #DC2626;
  }

  body {
    background-color: var(--saas-bg);
    margin: 0;
    padding: 0;
    color: var(--saas-text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Shell General */
  .saas-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* 1. Login View */
  .auth-view {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #F1F5F9;
  }

  .auth-box {
    background: #FFFFFF;
    border: 1px solid var(--saas-border);
    border-radius: 16px;
    padding: 40px;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    text-align: center;
    box-sizing: border-box;
  }

  .auth-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .auth-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .auth-pill {
    background: #0F172A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.06em;
  }

  .auth-icon-wrap {
    width: 52px;
    height: 52px;
    background: #EFF6FF;
    color: var(--saas-primary);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .auth-title {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 24px;
    color: var(--saas-text-main);
  }

  .auth-desc {
    font-size: 13.5px;
    color: var(--saas-text-muted);
    margin: 0 0 28px;
    line-height: 1.4;
  }

  .field-block {
    text-align: left;
    margin-bottom: 18px;
  }

  .field-block label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .field-input-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field-input-box svg {
    position: absolute;
    left: 12px;
    color: #94A3B8;
  }

  .field-input-box input {
    width: 100%;
    padding: 11px 14px 11px 40px;
    background: #F8FAFC;
    border: 1.5px solid var(--saas-border-dark);
    border-radius: 8px;
    font-size: 14px;
    color: var(--saas-text-main);
    box-sizing: border-box;
    outline: none;
    transition: all 0.2s;
  }

  .field-input-box input:focus {
    border-color: var(--saas-primary);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .auth-hint {
    font-size: 11.5px;
    color: var(--saas-text-muted);
    margin-top: 5px;
    text-align: right;
  }

  .auth-hint code {
    background: #F1F5F9;
    padding: 2px 5px;
    border-radius: 4px;
    font-weight: 700;
    color: #0F172A;
  }

  .alert-box.error {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #DC2626;
    padding: 10px;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 16px;
  }

  .btn-main {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--saas-primary);
    color: #FFFFFF;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    transition: all 0.2s;
  }

  .btn-main:hover {
    background: var(--saas-primary-hover);
    transform: translateY(-1px);
  }

  .auth-footer-link {
    margin-top: 24px;
    font-size: 13px;
  }

  .auth-footer-link a {
    color: var(--saas-text-muted);
    text-decoration: none;
    font-weight: 600;
  }

  .auth-footer-link a:hover {
    color: var(--saas-text-main);
  }

  /* 2. App Layout */
  .app-layout {
    display: flex;
    min-height: 100vh;
    width: 100%;
  }

  /* Sidebar */
  .sidebar {
    width: 260px;
    min-width: 260px;
    background: #FFFFFF;
    border-right: 1px solid var(--saas-border);
    display: flex;
    flex-direction: column;
    z-index: 100;
  }

  .sidebar-header {
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--saas-border);
  }

  .sidebar-logo {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  .saas-badge-pill {
    background: #0F172A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .sidebar-menu {
    flex: 1;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #475569;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-item:hover {
    background: #F1F5F9;
    color: var(--saas-text-main);
  }

  .nav-item.active {
    background: #EFF6FF;
    color: var(--saas-primary);
    font-weight: 700;
  }

  .nav-count {
    margin-left: auto;
    background: #E2E8F0;
    color: #334155;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
  }

  .nav-item.active .nav-count {
    background: #DBEAFE;
    color: #1E40AF;
  }

  .nav-count-alert {
    background: #FEF3C7;
    color: #B45309;
  }

  .sidebar-footer {
    padding: 16px;
    border-top: 1px solid var(--saas-border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .backend-status-card {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #F8FAFC;
    border: 1px solid var(--saas-border);
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 11.5px;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--saas-success);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    flex-shrink: 0;
  }

  .status-text-block strong {
    display: block;
    color: #64748B;
    font-size: 10px;
    text-transform: uppercase;
  }

  .status-text-block span {
    color: var(--saas-text-main);
    font-weight: 700;
  }

  .user-strip {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0F172A;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
  }

  .user-meta strong {
    display: block;
    font-size: 12.5px;
    color: var(--saas-text-main);
  }

  .user-meta span {
    font-size: 11px;
    color: var(--saas-success);
    font-weight: 600;
  }

  .footer-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .btn-subtle, .btn-logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--saas-border);
    cursor: pointer;
    background: #FFFFFF;
    color: #475569;
    transition: all 0.2s;
  }

  .btn-subtle:hover {
    background: #F1F5F9;
    color: var(--saas-text-main);
  }

  .btn-logout:hover {
    background: #FEF2F2;
    color: var(--saas-danger);
    border-color: #FECACA;
  }

  /* Workspace */
  .workspace {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--saas-bg);
  }

  /* Topbar */
  .topbar {
    height: 64px;
    background: #FFFFFF;
    border-bottom: 1px solid var(--saas-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .btn-sidebar-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--saas-text-main);
    padding: 6px;
  }

  .breadcrumb {
    font-size: 14px;
    color: var(--saas-text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb strong {
    color: var(--saas-text-main);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-action-refresh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    border: 1px solid var(--saas-border-dark);
    padding: 7px 12px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-action-refresh:hover {
    background: #F1F5F9;
  }

  .live-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    color: #065F46;
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
  }

  .workspace-body {
    padding: 24px 28px;
    flex: 1;
  }

  /* KPIs Grid */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: #FFFFFF;
    border: 1px solid var(--saas-border);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
  }

  .kpi-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .kpi-icon.blue { background: #EFF6FF; color: #2563EB; }
  .kpi-icon.green { background: #ECFDF5; color: #059669; }
  .kpi-icon.amber { background: #FFFBEB; color: #D97706; }
  .kpi-icon.purple { background: #FAF5FF; color: #9333EA; }

  .kpi-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--saas-text-muted);
    margin-bottom: 2px;
  }

  .kpi-val {
    font-size: 22px;
    font-weight: 800;
    color: var(--saas-text-main);
  }

  /* Pane Header */
  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .pane-header h2 {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 4px;
    color: var(--saas-text-main);
  }

  .pane-header p {
    font-size: 13.5px;
    color: var(--saas-text-muted);
    margin: 0;
  }

  .btn-primary-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--saas-primary);
    color: #FFFFFF;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    transition: all 0.2s;
  }

  .btn-primary-add:hover {
    background: var(--saas-primary-hover);
    transform: translateY(-1px);
  }

  /* Filter Toolbar */
  .filter-toolbar {
    background: #FFFFFF;
    border: 1px solid var(--saas-border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
  }

  .filter-top-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .search-field {
    flex: 1;
    min-width: 280px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-field svg {
    position: absolute;
    left: 14px;
    color: #94A3B8;
  }

  .search-field input {
    width: 100%;
    padding: 10px 36px 10px 40px;
    background: #F8FAFC;
    border: 1.5px solid var(--saas-border-dark);
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--saas-text-main);
    box-sizing: border-box;
    outline: none;
  }

  .search-field input:focus {
    border-color: var(--saas-primary);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .btn-clear-search {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    color: #94A3B8;
    cursor: pointer;
    font-size: 13px;
  }

  .filter-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748B;
    margin-right: 6px;
  }

  .saas-select-filter {
    background: #F8FAFC;
    border: 1.5px solid var(--saas-border-dark);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--saas-text-main);
    outline: none;
    cursor: pointer;
  }

  .category-chips-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    border-top: 1px solid #F1F5F9;
    padding-top: 12px;
  }

  .chip {
    background: #F8FAFC;
    border: 1px solid var(--saas-border);
    color: #475569;
    padding: 6px 13px;
    border-radius: 20px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s;
  }

  .chip:hover {
    background: #F1F5F9;
    color: var(--saas-text-main);
  }

  .chip.active {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
  }

  /* Table Card - DIMENSIONAMIENTO ESTRICTO */
  .table-card {
    background: #FFFFFF;
    border: 1px solid var(--saas-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
  }

  .table-responsive {
    overflow-x: auto;
    width: 100%;
  }

  .saas-table {
    width: 100%;
    table-layout: fixed; /* OBLIGATORIO PARA CONTROL DE TAMAÑOS */
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }

  .saas-table th {
    background: #F8FAFC;
    padding: 13px 16px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748B;
    border-bottom: 1px solid var(--saas-border);
    white-space: nowrap;
  }

  .saas-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #F1F5F9;
    vertical-align: middle;
  }

  .saas-table tr:hover td {
    background: #F8FAFC;
  }

  .row-inactive td {
    opacity: 0.55;
    background: #FCFCFD;
  }

  /* Thumbnail Estricto: EXACTAMENTE 56px x 56px */
  .tbl-thumb-box {
    width: 56px;
    height: 56px;
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 8px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    cursor: pointer;
  }

  .tbl-thumb {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important; /* Mantiene la prenda en proporción sin deformar */
    display: block !important;
  }

  .tbl-thumb-cam-hint {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
