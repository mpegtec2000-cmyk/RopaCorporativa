---
import Layout from '../layouts/Layout.astro';
import { PRODUCT_CATEGORIES } from '../lib/cms/types';

export const prerender = true;
---

<Layout title="ZORTEX | Panel de Administración" noindex={true}>
  <div class="saas-shell" id="saas-shell">
    
    <!-- =====================================================================
         1. PANTALLA DE ACCESO (LOGIN)
         ===================================================================== -->
    <section id="auth-screen" class="auth-view">
      <div class="auth-box">
        <div class="auth-brand">
          <img src="/images/zortex-logo-dark.png" alt="ZORTEX" class="auth-logo" />
        </div>
        
        <div class="auth-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>

        <h1 class="auth-title">Ingreso al Sistema</h1>

        <form id="login-form" class="auth-form" autocomplete="off">
          <div class="field-block">
            <label for="login-user">Usuario Administrador</label>
            <div class="field-input-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input type="text" id="login-user" name="username" placeholder="Ingresa tu usuario" autocomplete="username" required autofocus />
            </div>
          </div>

          <div class="field-block">
            <label for="login-pass">Contraseña</label>
            <div class="field-input-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input type="password" id="login-pass" name="password" placeholder="••••••••" autocomplete="current-password" required />
            </div>
          </div>

          <div id="login-err" class="alert-box error" style="display: none;">
            Usuario o contraseña incorrectos.
          </div>

          <button type="submit" class="btn-main" id="btn-login">
            <span>Ingresar</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <div class="auth-footer-link">
          <a href="/">← Volver a la Tienda Pública</a>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         2. APLICACIÓN PRINCIPAL SAAS (SIDEBAR + WORKSPACE)
         ===================================================================== -->
    <div id="saas-app" class="app-layout" style="display: none;">
      
      <!-- Barra lateral (Sidebar) -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <a href="/" class="sidebar-brand" title="Ir a la web pública">
            <img src="/images/zortex-logo-dark.png" alt="ZORTEX" class="sidebar-logo" />
          </a>
          <span class="saas-badge-pill">SaaS PRO</span>
        </div>

        <nav class="sidebar-menu">
          <button type="button" class="nav-item active" data-tab="tab-analytics">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <span>Analítica & Tráfico</span>
            <span class="nav-count nav-count-live" id="count-live-nav">0</span>
          </button>

          <button type="button" class="nav-item" data-tab="tab-quotes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>CRM & Cotizaciones</span>
            <span class="nav-count nav-count-alert" id="count-quotes-nav">0</span>
          </button>

          <button type="button" class="nav-item" data-tab="tab-meta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
            <span>Meta Pixel & Campañas</span>
            <span class="nav-count" id="meta-status-nav">OFF</span>
          </button>

          <button type="button" class="nav-item" data-tab="tab-products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span>Catálogo & Productos</span>
            <span class="nav-count" id="count-products-nav">0</span>
          </button>

          <button type="button" class="nav-item" data-tab="tab-content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Textos & Portada</span>
          </button>
        </nav>

        <div class="sidebar-footer">
          <div class="backend-status-card">
            <span class="status-indicator-dot"></span>
            <div class="status-text-block">
              <strong>Base de Datos:</strong>
              <span id="backend-label">Conectando...</span>
            </div>
          </div>

          <div class="user-strip">
            <div class="user-avatar">ZX</div>
            <div class="user-meta">
              <strong>ZORTEX Admin</strong>
              <span>Conectado en Vivo</span>
            </div>
          </div>

          <div class="footer-btns">
            <a href="/" target="_blank" class="btn-subtle" title="Abrir tienda en pestaña nueva">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>Ver Web</span>
            </a>
            <button type="button" class="btn-logout" id="btn-logout" title="Cerrar sesión">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Salir</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- Contenedor Principal (Workspace) -->
      <main class="workspace">
        
        <!-- Header superior -->
        <header class="topbar">
          <div class="topbar-left">
            <button type="button" class="btn-sidebar-toggle" id="btn-sidebar-toggle" aria-label="Alternar menú">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <div class="breadcrumb">
              <span>SaaS ZORTEX</span>
              <span class="sep">/</span>
              <strong id="topbar-section-title">Analítica & Tráfico</strong>
            </div>
          </div>

          <div class="topbar-right">
            <button type="button" class="btn-action-refresh" id="btn-global-refresh" title="Sincronizar datos">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              <span>Sincronizar</span>
            </button>
            <span class="live-tag">
              <span class="pulse-dot"></span> EN VIVO
            </span>
          </div>
        </header>

        <div class="workspace-body">

          <!-- ================= TAB 0: ANALÍTICA & TRÁFICO EN VIVO ================= -->
          <section id="tab-analytics" class="tab-pane active">
            <div class="pane-header">
              <div>
                <h2>Monitor de Tráfico, Flujo de Visitas & Embudo B2B</h2>
                <p>Control en tiempo real de quién entra a Zortex, desde qué campaña de Meta llega y cuántos cotizan o escriben por WhatsApp.</p>
              </div>
              <div class="pane-header-actions analytics-range-bar">
                <span class="live-users-pill" title="Visitantes con actividad en los últimos 5 minutos">
                  <span class="pulse-dot"></span>
                  <strong id="an-live-users">0</strong> activos ahora
                </span>
                <div class="range-pills" id="an-range-pills">
                  <button type="button" class="range-pill" data-range="24h">24h</button>
                  <button type="button" class="range-pill active" data-range="7d">7 días</button>
                  <button type="button" class="range-pill" data-range="30d">30 días</button>
                  <button type="button" class="range-pill" data-range="all">Todo</button>
                </div>
              </div>
            </div>

            <!-- Banner opcional de migración SQL si aún opera en modo buffer -->
            <div id="an-migration-banner" class="migration-banner" style="display: none;">
              <div class="migration-banner-text">
                <strong>Modo Buffer Activo (ya registra visitas en vivo)</strong>
                <span>Para almacenar historial ilimitado en Supabase, ejecuta <code>supabase/analytics-crm-migration.sql</code> en el SQL Editor de tu proyecto Supabase.</span>
              </div>
              <button type="button" class="btn-subtle-action" id="btn-copy-sql-hint">Ver pasos SQL</button>
            </div>

            <!-- KPIs Principales de Tráfico y Conversión -->
            <div class="kpi-grid kpi-grid-6">
              <div class="kpi-card">
                <div class="kpi-icon blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Visitas Totales</span>
                  <strong class="kpi-val" id="an-kpi-views">0</strong>
                  <span class="kpi-sub" id="an-kpi-sessions">0 sesiones</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon cyan">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Visitantes Únicos</span>
                  <strong class="kpi-val" id="an-kpi-unique">0</strong>
                  <span class="kpi-sub" id="an-kpi-prodviews">0 vistas de producto</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon green">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Clics WhatsApp</span>
                  <strong class="kpi-val" id="an-kpi-wa">0</strong>
                  <span class="kpi-sub" id="an-kpi-atc">0 agregados al cotizador</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Cotizaciones (Leads)</span>
                  <strong class="kpi-val" id="an-kpi-quotes">0</strong>
                  <span class="kpi-sub" id="an-kpi-won">0 cerradas ganadas</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon purple">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Tasa de Contacto</span>
                  <strong class="kpi-val" id="an-kpi-conv">0%</strong>
                  <span class="kpi-sub" id="an-kpi-leadrate">0% leads formales</span>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Pipeline CRM (CLP)</span>
                  <strong class="kpi-val" id="an-kpi-pipeline">$0</strong>
                  <span class="kpi-sub" id="an-kpi-wonval">Ganado: $0</span>
                </div>
              </div>
            </div>

            <!-- Fila 1: Gráfico de Flujo de Visitas + Embudo de Conversión -->
            <div class="analytics-grid-main">
              <div class="an-card an-card-chart">
                <div class="an-card-head">
                  <div>
                    <h3>Flujo de Visitas y Conversiones</h3>
                    <p>Evolución de visitas a la web vs contactos generados (WhatsApp + Cotizaciones).</p>
                  </div>
                  <div class="chart-legend">
                    <span><i class="dot-blue"></i> Visitas</span>
                    <span><i class="dot-green"></i> Contactos/Leads</span>
                  </div>
                </div>
                <div id="an-timeline-chart" class="an-chart-stage">
                  <div class="loading-state">Cargando flujo de visitas...</div>
                </div>
              </div>

              <div class="an-card">
                <div class="an-card-head">
                  <div>
                    <h3>Embudo de Conversión B2B</h3>
                    <p>Desde que llegan de Meta hasta el cierre comercial.</p>
                  </div>
                </div>
                <div id="an-funnel-list" class="an-funnel-list"></div>
              </div>
            </div>

            <!-- Fila 2: Fuentes de Tráfico + Dispositivos & Top Productos -->
            <div class="analytics-grid-2">
              <div class="an-card">
                <div class="an-card-head">
                  <div>
                    <h3>Fuentes de Tráfico (Meta, Google, Directo)</h3>
                    <p>Origen real de tus visitantes y qué canal convierte mejor.</p>
                  </div>
                </div>
                <div id="an-sources-list" class="an-sources-list"></div>
              </div>

              <div class="an-card">
                <div class="an-card-head">
                  <div>
                    <h3>Productos Más Consultados & Dispositivos</h3>
                    <p>Qué prendas atraen más clics y desde qué pantalla compran.</p>
                  </div>
                </div>
                <div id="an-devices-bar" class="an-devices-bar"></div>
                <div id="an-top-products" class="an-top-products"></div>
              </div>
            </div>

            <!-- Fila 3: Rendimiento por Campaña UTM (Meta Ads) -->
            <div class="an-card" style="margin-bottom: 20px;">
              <div class="an-card-head">
                <div>
                  <h3>Rendimiento por Campaña Meta Ads (UTM)</h3>
                  <p>Cada campaña creada con el Generador de Enlaces UTM aparecerá aquí con sus visitas, WhatsApp y cotizaciones.</p>
                </div>
                <button type="button" class="btn-subtle-action" id="btn-go-utm-builder">Ir a Generador UTM & Pixel →</button>
              </div>
              <div class="table-responsive">
                <table class="saas-table">
                  <thead>
                    <tr>
                      <th>Campaña (utm_campaign)</th>
                      <th>Origen / Medio</th>
                      <th style="text-align:center;">Visitas</th>
                      <th style="text-align:center;">Únicos</th>
                      <th style="text-align:center;">Al Cotizador</th>
                      <th style="text-align:center;">WhatsApp</th>
                      <th style="text-align:center;">Cotizaciones</th>
                      <th style="text-align:right;">Conversión</th>
                    </tr>
                  </thead>
                  <tbody id="an-campaigns-tbody">
                    <tr><td colspan="8" class="loading-td">Sin campañas UTM registradas aún.</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Fila 4: Feed en Vivo de Actividad -->
            <div class="an-card">
              <div class="an-card-head">
                <div>
                  <h3>Actividad en Vivo de la Tienda</h3>
                  <p>Últimos 25 movimientos registrados (visitas, productos abiertos, búsquedas, WhatsApp y cotizaciones).</p>
                </div>
              </div>
              <div id="an-live-feed" class="an-live-feed"></div>
            </div>
          </section>

          <!-- ================= TAB 1: PRODUCTOS ================= -->
          <section id="tab-products" class="tab-pane" style="display: none;">
            
            <!-- Tarjetas de métricas rápidas (KPIs) -->
            <div class="kpi-grid">
              <div class="kpi-card">
                <div class="kpi-icon blue">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Total en Catálogo</span>
                  <strong class="kpi-val" id="kpi-total-prods">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon green">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Activos en Tienda</span>
                  <strong class="kpi-val" id="kpi-active-prods">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon amber">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Ocultos / Pausados</span>
                  <strong class="kpi-val" id="kpi-inactive-prods">0</strong>
                </div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon purple">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </div>
                <div class="kpi-info">
                  <span class="kpi-label">Cotizaciones B2B</span>
                  <strong class="kpi-val" id="kpi-total-quotes">0</strong>
                </div>
              </div>
            </div>

            <!-- Cabecera de sección de catálogo -->
            <div class="pane-header">
              <div>
                <h2>Catálogo Maestro de Productos</h2>
                <p>Edita fotos, modelos, SKUs, categorías, curvas de tallas y visibilidad en tiempo real para la tienda online.</p>
              </div>
              <div class="pane-header-actions">
                <button type="button" class="btn-primary-add" id="btn-open-create-prod">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>Crear Nuevo Producto</span>
                </button>
              </div>
            </div>

            <!-- Barra de Filtros y Búsqueda -->
            <div class="filter-toolbar">
              <div class="filter-top-row">
                <div class="search-field">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <input type="text" id="prod-search-input" placeholder="Buscar por nombre, modelo, SKU o tela (ej: oxford, cargo, softshell)..." />
                  <button type="button" id="btn-clear-search" class="btn-clear-search" style="display: none;" title="Limpiar búsqueda">✕</button>
                </div>

                <div class="status-select-wrap">
                  <span class="filter-label">Estado:</span>
                  <select id="prod-status-filter" class="saas-select-filter">
                    <option value="all">Todos los estados</option>
                    <option value="active">Solo Activos en Tienda</option>
                    <option value="inactive">Solo Inactivos / Pausados</option>
                  </select>
