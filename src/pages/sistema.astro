  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
  }

  .workspace-body {
    padding: 24px 28px;
    flex: 1;
  }

