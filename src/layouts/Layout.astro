---
import { SITE } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  canonical,
  image = `${SITE.url}/images/hero-epp.png`,
  noindex = false,
} = Astro.props;

// Construir URL canónica absoluta siempre con el dominio oficial www.zortex.cl
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = image.startsWith('http') ? image : `${SITE.url}${image}`;
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Zortex, Zortex Chile, zortex.cl, ropa corporativa, ropa industrial, vestuario laboral, EPP, elementos de proteccion personal, venta mayorista ropa de trabajo chile, bordados corporativos" />
  <link rel="canonical" href={canonicalUrl} />
  <!-- Verificación Google Search Console -->
  <meta name="google-site-verification" content="google11fdd4e712c03d13" />

  <!-- Forzar actualización automática e instantánea a HTTPS seguro -->
  <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
  <script is:inline>
    (function () {
      if (typeof window !== 'undefined' && window.location) {
        var h = window.location.hostname;
        var p = window.location.protocol;
        var isLocal = h === 'localhost' || h === '127.0.0.1';
        if (!isLocal) {
          if (p === 'http:' || h === 'zortex.cl') {
            window.location.replace('https://www.zortex.cl' + window.location.pathname + window.location.search + window.location.hash);
          }
        }
      }
    })();
  </script>

  <!-- Control de Indexación Robots -->
  {noindex ? (
    <meta name="robots" content="noindex, nofollow, noarchive" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}

  <!-- Identidad de Marca y Favicon Oficial ZORTEX (Google Search, Apple, Android, Navegadores) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0F172A" />

  <!-- Open Graph / Redes Sociales (WhatsApp, LinkedIn, Facebook) -->
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:secure_url" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Zortex - Vestuario Corporativo, Industrial y Equipamiento EPP al por mayor en Chile" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:domain" content="zortex.cl" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Geo SEO para Posicionamiento Local en Chile -->
  <meta name="geo.region" content="CL-RM" />
  <meta name="geo.placename" content="Santiago, Chile" />
  <meta name="geo.position" content="-33.4489;-70.6693" />
  <meta name="ICBM" content="-33.4489, -70.6693" />

  <!-- Preload LCP Hero Image for Core Web Vitals (Instant LCP) -->
  <link rel="preload" as="image" href="/images/hero/desktop/1.webp" media="(min-width: 900px)" type="image/webp" fetchpriority="high" />
  <link rel="preload" as="image" href="/images/hero/mobile/1.webp" media="(max-width: 899px)" type="image/webp" fetchpriority="high" />

  <!-- Preconexión y Carga Asíncrona de Fuentes (Non-render-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </noscript>

  <!-- Schema.org Rich Snippets estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${SITE.url}/#organization`,
        "name": SITE.name,
        "legalName": "Zortex Chile",
        "url": SITE.url,
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE.url}/images/zortex_logo_transparente.png`,
          "caption": "Logo Zortex"
        },
        "description": SITE.description,
        "email": SITE.email,
        "telephone": SITE.phone,
        "slogan": "Distribuidor Mayorista en Ropa Corporativa, Industrial y EPP en Chile",
        "knowsAbout": [
          "Ropa Corporativa",
          "Ropa Industrial",
          "Vestuario Laboral y de Faena",
          "Elementos de Protección Personal (EPP)",
          "Bordados y Estampados Textil Mayorista",
          "Calzado y Botines de Seguridad"
        ],
        "brand": {
          "@type": "Brand",
          "name": "Zortex",
          "alternateName": "Zortex Chile",
          "logo": `${SITE.url}/images/zortex_logo_transparente.png`
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Santiago",
          "addressRegion": "Región Metropolitana",
          "addressCountry": "CL"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": SITE.phone,
            "contactType": "sales",
            "areaServed": "CL",
            "availableLanguage": ["Spanish"]
          }
        ]
      },
      {
        "@type": "WebSite",
        "@id": `${SITE.url}/#website`,
        "url": SITE.url,
        "name": "Zortex",
        "alternateName": ["Zortex Chile", "ZORTEX", "zortex.cl"],
        "description": SITE.description,
        "publisher": { "@id": `${SITE.url}/#organization` },
        "inLanguage": "es-CL"
      },
      {
        "@type": "WholesaleStore",
        "@id": `${SITE.url}/#store`,
        "name": "Zortex Venta Mayorista y Distribución",
        "url": SITE.url,
        "image": ogImageUrl,
        "telephone": SITE.phone,
        "priceRange": "$$",
        "currenciesAccepted": "CLP",
        "paymentAccepted": "Transferencia bancaria, Factura B2B 30 días, WebPay",
        "areaServed": {
          "@type": "Country",
          "name": "Chile"
        }
      }
    ]
  })} />
</head>
<body>
  <slot />
</body>
</html>