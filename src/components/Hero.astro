---
import { WHATSAPP_NUMBER } from '../config';
const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, quiero cotizar ropa corporativa / industrial.')}`;

// 4 Fondos para escritorio (16:9) y 4 para móvil (9:16)
const heroSlides = [
  { desktop: "/images/hero/desktop/1.jpg", mobile: "/images/hero/mobile/1.jpg", alt: "Equipo industrial y corporativo Zortex" },
  { desktop: "/images/hero/desktop/2.jpg", mobile: "/images/hero/mobile/2.jpg", alt: "Vestuario de faena y seguridad industrial" },
  { desktop: "/images/hero/desktop/3.jpg", mobile: "/images/hero/mobile/3.jpg", alt: "Personalización y bordado textil corporativo" },
  { desktop: "/images/hero/desktop/4.jpg", mobile: "/images/hero/mobile/4.jpg", alt: "Elementos de protección personal EPP Zortex" },
];
---

<section class="hero-section" aria-label="Sección principal Zortex">
  <!-- Slideshow de fondo: 100% full-bleed edge-to-edge -->
  <div class="hero-slideshow" id="hero-slideshow" aria-hidden="true">
    {heroSlides.map((slide, index) => (
      <div class={`hero-slide${index === 0 ? ' active' : ''}`} data-slide={index}>
        <picture>
          <source media="(max-width: 899px)" srcset={slide.mobile} />
          <img
            src={slide.desktop}
            alt={slide.alt}
            class="hero-slide-img"
            loading="eager"
            decoding="async"
            fetchpriority={index === 0 ? "high" : "auto"}
          />
        </picture>
      </div>
    ))}
  </div>

  <!-- Overlay degradado semitransparente para legibilidad de texto sobre la foto -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Contenedor centrado con max-width para texto, botones y tarjetas -->
  <div class="hero-container">
    <div class="hero-copy">
      <div class="hero-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Distribuidor Mayorista B2B en Chile</span>
      </div>
      
      <h1 class="fade-up">Los Mejores Proveedores en Ropa Corporativa, Industrial y EPP</h1>
      <p class="hero-lead fade-up fade-up-delay">Venta al por mayor para empresas de todos los rubros. Precios escalonados por volumen, bordado y estampado de logo corporativo con despacho a todo Chile.</p>
      
      <div class="hero-actions fade-up fade-up-delay-2">
        <a class="btn hero-btn-primary" href="#cotizar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="vertical-align:middle;margin-right:8px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Solicitar Cotización
        </a>
        <a class="btn ghost hero-btn-ghost" href={waUrl} target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:6px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Cotizar por WhatsApp
        </a>
      </div>
    </div>

    <!-- Proof Badges overlay -->
    <div class="proof-bar">
      <div class="proof-card">
        <div class="proof-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="proof-text">
          <b>Respuesta 24h</b>
          <span>Cotización formal garantizada</span>
        </div>
      </div>
      
      <div class="proof-card">
        <div class="proof-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <div class="proof-text">
          <b>Precios por Volumen</b>
          <span>Descuentos corporativos desde 50u</span>
        </div>
      </div>

      <div class="proof-card">
        <div class="proof-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="proof-text">
          <b>Bordado de Logo</b>
          <span>Personalización textil industrial</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 76px 0 64px;
    background: #0A1128;
    overflow: hidden;
    border-bottom: 1px solid #E2E8F0;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 580px;
  }

  @media (min-width: 900px) {
    .hero-section {
      min-height: 650px;
      padding: 84px 0 64px;
    }
  }

  @media (max-width: 899px) {
    .hero-section {
      min-height: auto;
      padding: 44px 0 36px;
    }
  }

  /* 1. Fondo slideshow edge-to-edge 100% full-bleed */
  .hero-slideshow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .hero-slide.active {
    opacity: 1;
    z-index: 2;
  }

  .hero-slide picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 2. Encuadre optimizado: center 18% para no cortar cabezas, gorras ni cascos */
  .hero-slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }

  @media (max-width: 899px) {
    .hero-slide-img {
      object-position: center 12%;
    }
  }

  /* 3. Overlay calibrado: texto nítido a la izquierda y fotos vibrantes a la derecha */
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.97) 0%,
      rgba(255, 255, 255, 0.92) 38%,
      rgba(255, 255, 255, 0.50) 60%,
      rgba(255, 255, 255, 0.12) 82%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  @media (max-width: 899px) {
    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.96) 0%,
        rgba(255, 255, 255, 0.88) 50%,
        rgba(255, 255, 255, 0.42) 80%,
        rgba(255, 255, 255, 0.18) 100%
      );
    }
  }

  /* 4. Contenedor centrado para el contenido */
  .hero-container {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1320px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
    box-sizing: border-box;
  }

  .hero-copy {
    max-width: 650px;
    margin-bottom: 48px;
  }

  @media (max-width: 899px) {
    .hero-copy {
      margin-bottom: 28px;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 6px;
    color: #F8FAFC;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 20px;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  }

  .hero-badge svg {
    color: #CBD5E1;
  }

  .hero-section h1 {
    font-size: clamp(28px, 4.2vw, 52px);
    color: #0F172A;
    font-weight: 800;
    line-height: 1.12;
    margin: 0 0 18px;
    letter-spacing: -0.03em;
    font-family: var(--display, system-ui);
    overflow-wrap: break-word;
    word-break: normal;
  }

  @media (max-width: 640px) {
    .hero-container {
      padding-left: 18px;
      padding-right: 18px;
    }
    .hero-section h1 {
      font-size: clamp(23px, 6.6vw, 30px);
      line-height: 1.18;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }
    .hero-lead {
      font-size: 14.5px;
      line-height: 1.55;
      margin-bottom: 22px;
    }
    .hero-btn-primary,
    .hero-btn-ghost {
      padding: 12px 20px !important;
      font-size: 14px !important;
    }
  }

  .hero-lead {
    color: #334155;
    font-size: 17.5px;
    line-height: 1.6;
    margin: 0 0 32px;
    font-weight: 500;
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 899px) {
    .hero-actions {
      flex-direction: column;
      gap: 10px;
    }
  }

  .hero-btn-primary {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    background: #0F172A !important;
    color: #ffffff !important;
    border: 1px solid #0F172A !important;
    padding: 14px 28px !important;
    font-size: 14.5px !important;
    font-weight: 700 !important;
    border-radius: 8px !important;
    box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.28);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .hero-btn-primary:hover {
    background: #1E293B !important;
    border-color: #1E293B !important;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -4px rgba(15, 23, 42, 0.36);
  }

  .hero-btn-ghost {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.96) !important;
    color: #0F172A !important;
    border: 1px solid #CBD5E1 !important;
    padding: 14px 26px !important;
    font-size: 14.5px !important;
    font-weight: 700 !important;
    border-radius: 8px !important;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .hero-btn-ghost svg {
    color: #16A34A;
  }
  .hero-btn-ghost:hover {
    background-color: #FFFFFF !important;
    border-color: #0F172A !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.1);
  }

  @media (max-width: 899px) {
    .hero-btn-primary,
    .hero-btn-ghost {
      width: 100%;
    }
  }

  /* Proof Badges */
  .proof-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    border-top: 1px solid rgba(203, 213, 225, 0.75);
    padding-top: 28px;
  }

  @media (max-width: 899px) {
    .proof-bar {
      padding-top: 20px;
      gap: 10px;
    }
  }

  .proof-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border: 1px solid #E2E8F0;
    border-left: 3px solid #0F172A;
    border-radius: 10px;
    box-shadow: 0 6px 20px -4px rgba(15, 23, 42, 0.08);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .proof-card:hover {
    transform: translateY(-2px);
    border-color: #CBD5E1;
    border-left-color: #0F172A;
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.14);
  }

  @media (max-width: 899px) {
    .proof-card {
      padding: 12px 16px;
      gap: 12px;
    }
  }

  .proof-icon {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0F172A;
    flex-shrink: 0;
  }

  @media (max-width: 899px) {
    .proof-icon {
      width: 38px;
      height: 38px;
    }
  }

  .proof-text b {
    display: block;
    font-size: 14.5px;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 2px;
    font-family: var(--display, system-ui);
    letter-spacing: -0.01em;
  }
  .proof-text span {
    font-size: 12.5px;
    color: #475569;
    font-weight: 500;
  }
</style>

<script is:inline>
  let heroTimer = null;

  function setupHeroBgSlideshow() {
    // Evita timers duplicados
    if (heroTimer) {
      clearInterval(heroTimer);
      heroTimer = null;
    }

    const slides = document.querySelectorAll('.hero-slide');
    if (!slides || slides.length < 2) return;

    // Respetar preferencia de accesibilidad (sin animación brusca)
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    let currentIndex = 0;
    const intervalMs = 5000; // 5 segundos por diapositiva

    heroTimer = setInterval(() => {
      slides[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % slides.length;
      slides[currentIndex].classList.add('active');
    }, intervalMs);
  }

  // Integración limpia para Astro (soporta View Transitions y recargas estándar)
  document.addEventListener('astro:page-load', setupHeroBgSlideshow);
  document.addEventListener('astro:before-swap', () => {
    if (heroTimer) {
      clearInterval(heroTimer);
      heroTimer = null;
    }
  });

  if (document.readyState !== 'loading') {
    setupHeroBgSlideshow();
  } else {
    document.addEventListener('DOMContentLoaded', setupHeroBgSlideshow);
  }
</script>
