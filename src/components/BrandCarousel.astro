---
const brands = [1, 2, 3, 4, 5, 6];
---

<section class="carousel-wrapper" aria-label="Marcas asociadas">
  <div class="wrap">
    <h2>Marcas que distribuimos</h2>
    <p class="lead">Trabajamos con las mejores marcas de ropa industrial y equipamiento de seguridad.</p>
  </div>
  <div class="carousel-track">
    {brands.map(n => (
      <img src={`/images/marcas/marca-${n}.svg`} alt={`Marca asociada ${n}`} width="160" height="48" loading="lazy" />
    ))}
    {brands.map(n => (
      <img src={`/images/marcas/marca-${n}.svg`} alt="" width="160" height="48" loading="lazy" aria-hidden="true" />
    ))}
  </div>
</section>
