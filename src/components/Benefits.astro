---
import { BENEFITS } from '../config';

const ICONS = [
  // 1. Despacho a todo Chile (Truck)
  `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--blue, #263A99)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>`,
  // 2. Pedidos por volumen (Factory/Boxes)
  `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--blue, #263A99)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`,
  // 3. Personalización con logo (Shirt/Needle)
  `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--blue, #263A99)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path></svg>`,
  // 4. Cotización en 24h (Clock)
  `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--blue, #263A99)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`
];
---

<section class="reveal benefits-section">
  <div class="wrap">
    <div class="benefits-grid">
      {BENEFITS.map((b, i) => (
        <div class="benefit-card">
          <div class="benefit-badge" set:html={ICONS[i]} />
          <h3 class="benefit-title">{b.title}</h3>
          <p class="benefit-desc">{b.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits-section {
    padding: 60px 0;
    background: #ffffff;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }
  .benefit-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem;
  }
  .benefit-badge {
    width: 80px;
    height: 80px;
    background: var(--tint, #F3F6FC);
    border: 2px solid var(--sky, #97B4DE);
    border-radius: 50%; /* circular badge */
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, background 0.4s ease;
  }
  .benefit-card:hover .benefit-badge {
    transform: scale(1.15) translateY(-5px);
    box-shadow: 0 10px 25px rgba(38, 58, 153, 0.25);
    background: #ffffff;
  }
  .benefit-title {
    color: var(--blue, #263A99);
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .benefit-desc {
    color: #4a5568;
    line-height: 1.6;
    font-size: 0.95rem;
  }
</style>
