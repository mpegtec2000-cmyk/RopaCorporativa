---
import { WHATSAPP_NUMBER } from '../config';
import { getPublicProducts } from '../lib/cms/store';

const PRODUCTS = await getPublicProducts();

const categories = [
  { name: 'Todos', filter: 'all', count: PRODUCTS.length, icon: 'grid' },
  { name: 'Ropa Corporativa', filter: 'Ropa Corporativa', count: PRODUCTS.filter(p => p.category === 'Ropa Corporativa').length, icon: 'corporate' },
  { name: 'Ropa Industrial', filter: 'Ropa Industrial', count: PRODUCTS.filter(p => p.category === 'Ropa Industrial').length, icon: 'industrial' },
  { name: 'Ropa de Seguridad', filter: 'Ropa de Seguridad', count: PRODUCTS.filter(p => p.category === 'Ropa de Seguridad').length, icon: 'safety' },
  { name: 'EPP', filter: 'EPP', count: PRODUCTS.filter(p => p.category === 'EPP').length, icon: 'epp' },
  { name: 'Ropa Personalizada', filter: 'Ropa Personalizada', count: PRODUCTS.filter(p => p.category === 'Ropa Personalizada').length, icon: 'custom' },
];

// Catálogo serializado ligero para el modal interactivo de ficha técnica con todos los colores
const modalCatalog = PRODUCTS.map(p => ({
  id: p.id,
  baseId: p.baseId || p.id,
  name: p.name,
  displayName: p.displayName || p.name,
  color: p.color || '',
  colorHex: p.colorHex || '',
  category: p.category,
  sku: p.sku || '',
  image: p.image,
  images: (p.images && p.images.length > 0) ? p.images : [p.image],
  colors: p.colors || [],
  sizes: p.sizes || [],
  features: p.features || [],
  summary: p.summary || '',
  line: p.line || '',
  gender: p.gender || '',
}));
---

<section id="productos" class="reveal" data-wa={WHATSAPP_NUMBER}>
  <div class="products-wrap">
    <div class="products-header">
      <div class="products-title-col">
        <div class="products-eyebrow-badge">
          <span class="live-pulse-dot" aria-hidden="true"></span>
          <span class="eyebrow-text">CATÁLOGO MAYORISTA B2B</span>
          <span class="eyebrow-dot">•</span>
          <span class="eyebrow-stat">{PRODUCTS.length} MODELOS ACTIVOS</span>
        </div>
        <h2>Catálogo Técnico de Vestuario y EPP</h2>
        <p class="products-lead">Explora nuestra colección técnica de vestuario corporativo, faena industrial de alta resistencia, indumentaria de seguridad certificada y equipamiento de protección personal (EPP).</p>
        
        <div class="products-trust-row">
          <span class="trust-chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Precios mayoristas por escala
          </span>
          <span class="trust-chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Taller propio de bordado y estampado
          </span>
          <span class="trust-chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Despacho rápido a todo Chile
          </span>
        </div>
      </div>

      <!-- Barra de búsqueda en vivo con botón limpiar -->
      <div class="catalog-search-wrap">
        <div class="search-input-box">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="catalog-search"
            class="catalog-search-input"
            placeholder="Buscar por modelo, SKU, tela o color (ej: softshell, cargo, marino...)"
            aria-label="Buscar en catálogo de productos"
          />
          <button type="button" id="catalog-search-clear" class="search-clear-btn" aria-label="Limpiar búsqueda" style="display: none;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <div class="search-quick-hints">
          <span class="hint-label">Búsquedas rápidas:</span>
          <button type="button" class="hint-btn" data-search-trigger="Softshell">Softshell</button>
          <button type="button" class="hint-btn" data-search-trigger="Cargo">Cargo</button>
          <button type="button" class="hint-btn" data-search-trigger="Parka">Parka</button>
          <button type="button" class="hint-btn" data-search-trigger="Polerón">Polerón</button>
        </div>
      </div>
    </div>

    <!-- Barra de control y navegación de filtros de categoría -->
    <div class="catalog-control-panel">
      <!-- Navegación táctil móvil: Botones Anterior / Siguiente con categoría activa -->
      <div class="mobile-cat-stepper" id="mobile-cat-stepper">
        <button type="button" class="mobile-step-arrow-btn" id="mobile-prev-cat" aria-label="Categoría anterior">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Anterior</span>
        </button>
        
        <div class="mobile-step-pill" id="mobile-current-cat-pill">
          <span class="mobile-pill-prefix">Categoría actual:</span>
          <span class="mobile-pill-text" id="mobile-current-cat-name">
            <strong>Todos</strong> <span class="mobile-curr-count">{PRODUCTS.length}</span>
          </span>
        </div>

        <button type="button" class="mobile-step-arrow-btn" id="mobile-next-cat" aria-label="Siguiente categoría">
          <span>Siguiente</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Contenedor con flechas de desplazamiento para barra de pestañas -->
      <div class="product-tabs-nav-container">
        <button 
          type="button" 
          class="tabs-nav-arrow tabs-nav-arrow-prev" 
          id="tabs-scroll-prev" 
          aria-label="Desplazar menú a la izquierda"
          title="Ver categorías anteriores"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="product-tabs-scroll-wrapper" id="product-tabs-wrapper">
          <div class="product-tabs" id="product-tabs" role="tablist" aria-label="Filtrar por categoría">
          {categories.map((cat, i) => (
            <button
              class={`product-tab${i === 0 ? ' active' : ''}`}
              data-filter={cat.filter}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {cat.icon === 'grid' && (
                <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                </svg>
              )}
              {cat.icon === 'corporate' && (
                <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 3H8l-2 5 4 1 2-4 2 4 4-1-2-5z"/>
                  <path d="M10 11l2 8 2-8"/>
                  <path d="M12 19l2 2-2 1-2-1 2-2z"/>
                </svg>
              )}
              {cat.icon === 'industrial' && (
                <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
                  <path d="M17 18h.01"></path>
                  <path d="M7 18h.01"></path>
                </svg>
              )}
              {cat.icon === 'safety' && (
                <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              )}
              {cat.icon === 'epp' && (
                <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 13h20"></path>
                  <path d="M4 13a8 8 0 0 1 16 0"></path>
                  <path d="M12 4v4"></path>
                  <path d="M9 13v3a3 3 0 0 0 6 0v-3"></path>
                </svg>
              )}
              {cat.icon === 'custom' && (
                <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>
                </svg>
              )}
              <span class="tab-label">{cat.name}</span>
              <span class="tab-count">{cat.count}</span>
            </button>
          ))}
        </div>
      </div>

      <button 
        type="button" 
        class="tabs-nav-arrow tabs-nav-arrow-next" 
        id="tabs-scroll-next" 
        aria-label="Desplazar menú a la derecha"
        title="Ver más categorías"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

      <!-- Barra de estado y retroalimentación activa -->
      <div class="catalog-status-bar" id="catalog-status-bar">
        <div class="catalog-status-info">
          <span class="catalog-status-dot"></span>
          <span class="catalog-status-text" id="catalog-status-text">
            Mostrando todos los modelos (<strong>{PRODUCTS.length}</strong>)
          </span>
        </div>
      </div>
    </div>

    <!-- Grid de productos: 6 por fila en escritorio con todos los colores -->
    <div class="products-grid" id="product-grid">
      {PRODUCTS.map((product, index) => (
        <div
          class="product-card"
          data-id={product.id}
          data-base-id={product.baseId || product.id}
          data-category={product.category}
          data-name={product.name.toLowerCase()}
          data-color={product.color ? product.color.toLowerCase() : ''}
          data-sku={product.sku ? product.sku.toLowerCase() : ''}
          data-summary={product.summary ? product.summary.toLowerCase() : ''}
          data-colors={product.colors ? product.colors.map(c => c.name.toLowerCase()).join(' ') : (product.color ? product.color.toLowerCase() : '')}
          data-default-img={product.image}
          data-selected-color={product.color || (product.colors && product.colors[0] ? product.colors[0].name : '')}
          data-index={index}
          tabindex="0"
          role="button"
          aria-label={`Ver ficha técnica de ${product.name} en color ${product.color || 'estándar'}`}
        >
          <div class="product-img-wrapper">
            <img
              class="product-img"
              src={product.image}
              alt={`${product.name} ${product.color ? `- ${product.color}` : ''}`}
              loading="lazy"
              decoding="async"
              width="300"
              height="300"
            />
            <span class="product-quick-hint">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
              Ficha técnica
            </span>
          </div>
          <div class="product-info">
            <div class="product-cat-row">
              <span class="product-cat">{product.category}</span>
              {product.colors && product.colors.length > 0 ? (
                <span class="product-color-pill-tag" title={`${product.colors.length} colores disponibles`}>
                  <span class="color-dot-indicator" style={`background-color: ${product.colors[0].hex};`}></span>
                  {product.colors.length > 1 ? `${product.colors.length} colores` : product.colors[0].name}
                </span>
              ) : null}
            </div>

            <h3 class="product-name" title={product.name}>{product.name}</h3>

            <!-- Swatches de variedad en colores para el modelo -->
            {product.colors && product.colors.length > 1 && (
              <div class="card-swatches" aria-label="Variedad en colores">
                {product.colors.slice(0, 6).map((col, cIdx) => (
                  <button
                    type="button"
                    class={`card-swatch-dot${cIdx === 0 ? ' active' : ''}`}
                    style={`background-color: ${col.hex};`}
                    title={col.name}
                    data-color-name={col.name}
                    data-color-img={col.image || product.image}
                    aria-label={`Ver en color ${col.name}`}
                  />
                ))}
                {product.colors.length > 6 && (
                  <span class="card-swatch-more" title={`${product.colors.length - 6} colores más disponibles en la ficha`}>
                    +{product.colors.length - 6}
                  </span>
                )}
              </div>
            )}

            {product.sku && <span class="product-sku">SKU: {product.sku}</span>}
            <button class="product-btn" data-product-id={product.id} type="button" title={`Agregar ${product.name} (${product.color || 'estándar'}) al cotizador`}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              <span>Cotizar</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Mensaje sin resultados -->
    <div id="no-products-msg" class="no-products-msg" style="display: none;">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <p>No se encontraron modelos que coincidan con tu búsqueda.</p>
      <button type="button" id="reset-filter-btn" class="reset-filter-btn">Restablecer catálogo completo</button>
    </div>

    <!-- Botón Cargar Más -->
    <div class="load-more-wrap" id="load-more-wrap">
      <button type="button" id="load-more-btn" class="load-more-btn">
        <span>Cargar más modelos del catálogo</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <span class="load-more-status" id="load-more-status"></span>
    </div>
  </div>

  <!-- Catálogo ligero para scripts cliente -->
  <script id="catalog-products-json" type="application/json" set:html={JSON.stringify(modalCatalog)}></script>
</section>

<!-- ================================================================= -->
<!-- MODAL DE FICHA TÉCNICA ULTRA-INMERSIVA (PORTAL AL BODY VIEWPORT)  -->
<!-- ================================================================= -->
<div id="product-modal" class="pmodal" role="dialog" aria-modal="true" aria-hidden="true" style="display: none;">
  <div class="pmodal-backdrop" id="pmodal-backdrop"></div>
  <div class="pmodal-dialog" id="pmodal-dialog">
    <!-- Botón de Cerrar Flotante de Lujo -->
    <button type="button" class="pmodal-close" id="pmodal-close" aria-label="Cerrar ficha">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="pmodal-grid">
      <!-- ─────── COLUMNA IZQUIERDA: STUDIO FOTOGRÁFICO INTERACTIVO ─────── -->
      <div class="pmodal-gallery">
        <div class="pmodal-stage-wrapper">
          <div class="pmodal-main-img-wrap" id="pmodal-main-img-wrap" title="Pasa el cursor para inspeccionar textura del tejido en Zoom HD">
            <!-- Badges flotantes en la imagen -->
            <div class="pmodal-stage-topbar">
              <span class="pmodal-stage-pill">
                <span class="stage-dot-live"></span>
                <span>Foto de Estudio Real</span>
              </span>
              <span class="pmodal-zoom-hint" id="pmodal-zoom-hint">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <span>Zoom HD</span>
              </span>
            </div>

            <!-- Imagen Principal -->
            <img id="pmodal-main-img" src="" alt="" width="560" height="560" />

            <!-- Pill flotante del color actual sobre la foto -->
            <div class="pmodal-stage-color-tag" id="pmodal-stage-color-tag">
              <span class="pmodal-stage-color-dot" id="pmodal-stage-color-dot"></span>
              <span id="pmodal-stage-color-name">Color</span>
            </div>
          </div>
        </div>

        <!-- Garantías Corporativas en la columna de imagen -->
        <div class="pmodal-trust-cards">
          <div class="pmodal-trust-item">
            <div class="trust-icon-wrap">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
            </div>
            <div>
              <strong>Calidad Corporativa</strong>
              <span>Confección de alta resistencia al uso intensivo</span>
            </div>
          </div>
          <div class="pmodal-trust-item">
            <div class="trust-icon-wrap">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
              </svg>
            </div>
            <div>
              <strong>Personalización Disponible</strong>
              <span>Bordado computarizado o DTF con tu logo</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ─────── COLUMNA DERECHA: INFORMACIÓN, SELECTOR DE COLOR Y COTIZADOR ─────── -->
      <div class="pmodal-details">
        <!-- Badges Superiores -->
        <div class="pmodal-badges">
          <span class="pmodal-cat-badge" id="pmodal-cat">Ropa Corporativa</span>
          <button type="button" class="pmodal-sku-badge" id="pmodal-sku" title="Clic para copiar SKU">
            <span id="pmodal-sku-text">SKU: --</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
          <span class="pmodal-stock-badge">
            <span class="stock-pulse"></span>
            <span>Venta por Mayor</span>
          </span>
          <span class="pmodal-extra-badge" id="pmodal-extra"></span>
        </div>

        <!-- Título y Resumen -->
        <h2 class="pmodal-title" id="pmodal-title">Nombre del Producto</h2>
        <p class="pmodal-summary" id="pmodal-summary">Descripción técnica del producto.</p>

        <!-- ─────── SELECCIÓN DE COLOR ─────── -->
        <div class="pmodal-color-hub" id="pmodal-colors-field">
          <div class="pmodal-section-header">
            <span class="pmodal-section-label">Color:</span>
            <span class="pmodal-selected-color-title" id="pmodal-selected-color-name">Selecciona un color</span>
          </div>
          <div class="pmodal-color-grid" id="pmodal-colors"></div>
        </div>

        <!-- ─────── SELECTOR DE TALLA ─────── -->
        <div class="pmodal-field" id="pmodal-sizes-field">
          <div class="pmodal-section-header">
            <span class="pmodal-section-label">Talla:</span>
            <span class="pmodal-size-selected-tag">Seleccionada: <strong id="pmodal-current-size-label">M</strong></span>
          </div>
          <div class="pmodal-sizes-list" id="pmodal-sizes"></div>
        </div>

        <!-- ─────── FICHA TÉCNICA ─────── -->
        <div class="pmodal-field" id="pmodal-specs-field">
          <div class="pmodal-section-header">
            <span class="pmodal-section-label">Ficha Técnica y Materialidad</span>
          </div>
          <div class="pmodal-specs-grid" id="pmodal-specs"></div>
        </div>

        <!-- ─────── CHECKOUT Y COTIZACIÓN ─────── -->
        <div class="pmodal-checkout-card">
          <div class="pmodal-qty-wrapper">
            <span class="pmodal-qty-label">Cantidad a cotizar:</span>
            <div class="pmodal-qty-stepper">
              <button type="button" class="stepper-btn" id="pmodal-qty-minus" aria-label="Restar 5 unidades">−5</button>
              <input type="number" id="pmodal-qty-input" min="1" max="9999" value="10" />
              <button type="button" class="stepper-btn" id="pmodal-qty-plus" aria-label="Sumar 5 unidades">+5</button>
            </div>
            <div class="pmodal-qty-presets">
              <button type="button" class="qty-preset-btn" data-qty="10">10 u.</button>
              <button type="button" class="qty-preset-btn" data-qty="25">25 u.</button>
              <button type="button" class="qty-preset-btn" data-qty="50">50 u.</button>
              <button type="button" class="qty-preset-btn" data-qty="100">100 u.</button>
            </div>
          </div>

          <div class="pmodal-actions-row">
            <button type="button" class="pmodal-btn-add" id="pmodal-add-btn">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
