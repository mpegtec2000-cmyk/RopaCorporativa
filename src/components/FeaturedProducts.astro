  function matchesQuery(query: string, text: string, cardName: string, cardCategory: string, cardLine: string, cardSku: string) {
    if (!query) return true;

    // 1. Coincidencia directa por SKU exacto
    if (cardSku && (cardSku.toLowerCase() === query.toLowerCase() || cardSku.toLowerCase().includes(query.toLowerCase()))) {
      return true;
    }

    const normQuery = normalizeText(query);
    const normName = normalizeText(cardName);
    const normCat = normalizeText(cardCategory);
    const normLine = normalizeText(cardLine);
    const normSku = normalizeText(cardSku);

    // 2. Si la consulta corresponde a una categoría o subcategoría conocida, aplicar la regla estricta sobre el nombre
    if (STRICT_CATEGORY_RULES[normQuery]) {
      return STRICT_CATEGORY_RULES[normQuery](normName, normCat, normLine, normSku);
    }

    // 3. Coincidencia literal en el nombre o sku del producto (prioridad alta)
    if (normName.includes(normQuery) || normSku.includes(normQuery)) {
      return true;
    }

    // 4. Búsqueda por palabras: cada palabra debe estar presente en el texto del producto
    const words = normQuery.split(/\s+/).filter(w => w.length > 2);
    if (words.length > 0) {
      const allWordsMatch = words.every(word => {
        if (text.includes(word)) return true;
        const syns = SYNONYMS[word];
        return syns ? syns.some(s => text.includes(s)) : false;
      });
      if (allWordsMatch) return true;
    }

    // 5. Sinónimos exactos de la consulta completa
    const syns = SYNONYMS[normQuery];
    if (syns) {
      for (const syn of syns) {
        if (text.includes(syn)) return true;
      }
    }

    return false;
  }

  function updateVisibility() {
    let matchedCards: HTMLElement[] = [];

    cards.forEach((card) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardName = card.getAttribute('data-name') || '';
      const cardColor = card.getAttribute('data-color') || '';
      const cardSku = card.getAttribute('data-sku') || '';
      const cardSummary = card.getAttribute('data-summary') || '';
      const cardColors = card.getAttribute('data-colors') || '';

      const targetText = normalizeText(`${cardName} ${cardColor} ${cardSku} ${cardCategory} ${cardSummary} ${cardColors}`);

      const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesSearch = matchesQuery(searchTerm, targetText, cardName, cardCategory, card.getAttribute('data-line') || '', cardSku);

      if (matchesCategory && matchesSearch) {
        matchedCards.push(card);
      } else {
        card.style.display = 'none';
      }
    });

    const limit = searchTerm ? matchedCards.length : visibleLimit;

    matchedCards.forEach((card, index) => {
      if (index < limit) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    if (noProductsMsg) {
      noProductsMsg.style.display = matchedCards.length === 0 ? 'block' : 'none';
    }

    if (loadMoreWrap && loadMoreStatus && loadMoreBtn) {
      if (searchTerm || matchedCards.length <= limit) {
        loadMoreWrap.style.display = 'none';
      } else {
        loadMoreWrap.style.display = 'flex';
        const currentShown = Math.min(limit, matchedCards.length);
        loadMoreStatus.textContent = `Mostrando ${currentShown} de ${matchedCards.length} productos`;
      }
    }

    const statusTextEl = document.getElementById('catalog-status-text');
    if (statusTextEl) {
      if (searchTerm) {
        const queryDisplay = searchInput?.value || searchTerm;
        statusTextEl.innerHTML = `Mostrando <strong>${matchedCards.length}</strong> resultados para "${queryDisplay}"${activeCategory !== 'all' ? ` en <strong>${activeCategory}</strong>` : ''}`;
      } else if (activeCategory !== 'all') {
        statusTextEl.innerHTML = `Mostrando <strong>${matchedCards.length}</strong> modelos en <strong>${activeCategory}</strong>`;
      } else {
        statusTextEl.innerHTML = `Mostrando todos los modelos (<strong>${matchedCards.length}</strong>)`;
      }
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      activeCategory = tab.getAttribute('data-filter') || 'all';
      visibleLimit = BATCH_SIZE;
      updateVisibility();
      updateMobileCategoryDisplay();
      tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    });
  });

  // Control de scroll con flechas táctiles para las pestañas de categorías
  const tabsWrapper = document.getElementById('product-tabs-wrapper');
  const scrollPrevBtn = document.getElementById('tabs-scroll-prev');
  const scrollNextBtn = document.getElementById('tabs-scroll-next');

  if (tabsWrapper && scrollPrevBtn && scrollNextBtn) {
    scrollPrevBtn.addEventListener('click', () => {
      tabsWrapper.scrollBy({ left: -160, behavior: 'smooth' });
    });
    scrollNextBtn.addEventListener('click', () => {
      tabsWrapper.scrollBy({ left: 160, behavior: 'smooth' });
    });

    const updateScrollButtons = () => {
      const maxScroll = tabsWrapper.scrollWidth - tabsWrapper.clientWidth;
      if (maxScroll <= 5) {
        scrollPrevBtn.style.opacity = '0.3';
        scrollPrevBtn.style.pointerEvents = 'none';
        scrollNextBtn.style.opacity = '0.3';
        scrollNextBtn.style.pointerEvents = 'none';
      } else {
        scrollPrevBtn.style.opacity = tabsWrapper.scrollLeft > 10 ? '1' : '0.3';
        scrollPrevBtn.style.pointerEvents = tabsWrapper.scrollLeft > 10 ? 'auto' : 'none';
        scrollNextBtn.style.opacity = tabsWrapper.scrollLeft < maxScroll - 10 ? '1' : '0.3';
        scrollNextBtn.style.pointerEvents = tabsWrapper.scrollLeft < maxScroll - 10 ? 'auto' : 'none';
      }
    };

    tabsWrapper.addEventListener('scroll', updateScrollButtons, { passive: true });
    window.addEventListener('resize', updateScrollButtons, { passive: true });
    if ('requestAnimationFrame' in window) {
      requestAnimationFrame(() => updateScrollButtons());
    } else {
      setTimeout(updateScrollButtons, 300);
    }
  }

  // Stepper móvil: Cambiar categoría con botones Anterior / Siguiente
  const mobilePrevCatBtn = document.getElementById('mobile-prev-cat');
  const mobileNextCatBtn = document.getElementById('mobile-next-cat');
  const mobileCurrentCatName = document.getElementById('mobile-current-cat-name');

  function updateMobileCategoryDisplay() {
    if (!mobileCurrentCatName) return;
    const activeTab = document.querySelector('.product-tab.active') as HTMLElement | null;
    if (activeTab) {
      const label = activeTab.querySelector('.tab-label')?.textContent || 'Todos';
      const count = activeTab.querySelector('.tab-count')?.textContent || '';
      mobileCurrentCatName.innerHTML = `<strong>${label}</strong> ${count ? `<span class="mobile-curr-count">${count}</span>` : ''}`;
    }
  }

  function switchTabByIndex(index: number) {
    const tabList = Array.from(tabs) as HTMLElement[];
    if (index >= 0 && index < tabList.length) {
      tabList[index].click();
      tabList[index].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }
  }

  if (mobilePrevCatBtn && mobileNextCatBtn) {
    mobilePrevCatBtn.addEventListener('click', () => {
      const tabList = Array.from(tabs) as HTMLElement[];
      const currentIndex = tabList.findIndex(t => t.classList.contains('active'));
      const prevIndex = currentIndex > 0 ? currentIndex - 1 : tabList.length - 1;
      switchTabByIndex(prevIndex);
    });

    mobileNextCatBtn.addEventListener('click', () => {
      const tabList = Array.from(tabs) as HTMLElement[];
      const currentIndex = tabList.findIndex(t => t.classList.contains('active'));
      const nextIndex = currentIndex < tabList.length - 1 ? currentIndex + 1 : 0;
      switchTabByIndex(nextIndex);
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', function () {
      searchTerm = normalizeText(this.value || '');
      if (searchClearBtn) {
        searchClearBtn.style.display = searchTerm ? 'inline-flex' : 'none';
      }
      visibleLimit = BATCH_SIZE;
      updateVisibility();
    });
  }

  if (searchClearBtn && searchInput) {
    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      searchClearBtn.style.display = 'none';
      visibleLimit = BATCH_SIZE;
      updateVisibility();
      searchInput.focus();
    });
  }

  if (resetFilterBtn && searchInput) {
    resetFilterBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      if (searchClearBtn) searchClearBtn.style.display = 'none';
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tabs[0]?.classList.add('active');
      tabs[0]?.setAttribute('aria-selected', 'true');
      activeCategory = 'all';
      visibleLimit = BATCH_SIZE;
      updateVisibility();
    });
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      visibleLimit += BATCH_SIZE;
      updateVisibility();
    });
  }

  // Swatches interactivos en tarjetas de productos
  document.querySelectorAll('.card-swatch-dot').forEach((dot) => {
    function activateSwatch(e: Event) {
      e.stopPropagation();
      const parentCard = dot.closest('.product-card');
      if (!parentCard) return;
      const img = parentCard.querySelector('.product-img') as HTMLImageElement;
      const targetSrc = dot.getAttribute('data-color-img');
      const colorName = dot.getAttribute('data-color-name');
      if (img && targetSrc) {
        img.src = targetSrc;
      }
      parentCard.querySelectorAll('.card-swatch-dot').forEach((d) => d.classList.remove('active'));
      dot.classList.add('active');
      if (colorName) {
        parentCard.setAttribute('data-selected-color', colorName);
        const tag = parentCard.querySelector('.product-color-pill-tag');
        if (tag) {
          const dotInd = tag.querySelector('.color-dot-indicator') as HTMLElement;
          if (dotInd) dotInd.style.backgroundColor = (dot as HTMLElement).style.backgroundColor;
          tag.innerHTML = '';
          if (dotInd) tag.appendChild(dotInd);
          tag.appendChild(document.createTextNode(' ' + colorName));
        }
      }
    }

    dot.addEventListener('mouseenter', activateSwatch);
    dot.addEventListener('click', activateSwatch);
  });

  // Zoom interactivo en imagen de estudio
  if (mainImgWrap && mainImg) {
    mainImgWrap.addEventListener('mousemove', (e) => {
      const rect = mainImgWrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      mainImg.style.transformOrigin = `${x}% ${y}%`;
      mainImg.style.transform = 'scale(1.55)';
    });

    mainImgWrap.addEventListener('mouseleave', () => {
      mainImg.style.transformOrigin = 'center center';
      mainImg.style.transform = 'scale(1)';
    });
  }

  // Copiar SKU al portapapeles
  if (skuBadge && skuText) {
    skuBadge.addEventListener('click', () => {
      const txt = skuText.textContent?.replace('SKU: ', '').trim() || '';
      if (txt && txt !== '--') {
        navigator.clipboard.writeText(txt).then(() => {
          const original = skuText.textContent;
          skuText.textContent = '✓ Copiado';
          setTimeout(() => { skuText.textContent = original; }, 1500);
        }).catch(() => {});
      }
    });
  }

  // Controles de cantidad (Stepper y presets)
  if (qtyMinusBtn && qtyInput) {
    qtyMinusBtn.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 10;
      val = Math.max(1, val - 5);
      qtyInput.value = String(val);
      updateWaUrl();
    });
  }
  if (qtyPlusBtn && qtyInput) {
    qtyPlusBtn.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 10;
      val = Math.min(9999, val + 5);
      qtyInput.value = String(val);
      updateWaUrl();
    });
  }
  qtyPresetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = btn.getAttribute('data-qty');
      if (q && qtyInput) {
        qtyInput.value = q;
        updateWaUrl();
      }
    });
  });
  if (qtyInput) {
    qtyInput.addEventListener('input', () => {
      updateWaUrl();
    });
  }

  // ───────────────────────── Modal de Ficha Técnica ─────────────────────────
  let currentModalProduct: any = null;
  let selectedModalSize = 'M';
  let selectedModalColor = '';

  function isLightColorHex(hex: string) {
    if (!hex) return false;
    const clean = hex.replace('#', '');
    if (clean.length !== 6) return false;
    const r = parseInt(clean.substring(0, 2), 16);
    const g = parseInt(clean.substring(2, 4), 16);
    const b = parseInt(clean.substring(4, 6), 16);
    const brightness = (r * 299 + g * 587 + b * 114) / 1000;
    return brightness > 185;
  }

  function updateWaUrl() {
    if (!waBtn || !currentModalProduct) return;
    const qty = qtyInput ? (parseInt(qtyInput.value) || 10) : 10;
    const colorTxt = selectedModalColor ? ` (Color: ${selectedModalColor})` : '';
    const sizeTxt = selectedModalSize ? ` (Talla: ${selectedModalSize})` : '';
    const waText = encodeURIComponent(`Hola Zortex, quisiera cotizar ${qty} unidades de "${currentModalProduct.name}"${colorTxt}${sizeTxt} (SKU: ${currentModalProduct.sku || 'N/A'}).`);
    waBtn.href = `https://wa.me/${whatsappNumber}?text=${waText}`;
  }

  function switchMainImage(newSrc: string) {
    if (!mainImg || !newSrc) return;
    if (mainImg.src.endsWith(newSrc)) return;
    mainImg.classList.add('switching');
    const preloader = new Image();
    preloader.src = newSrc;
    preloader.onload = () => {
      mainImg.src = newSrc;
      requestAnimationFrame(() => {
        setTimeout(() => mainImg.classList.remove('switching'), 30);
      });
    };
    preloader.onerror = () => {
      mainImg.src = newSrc;
      mainImg.classList.remove('switching');
    };
  }

  function openModal(id: string, initialColor?: string) {
    const prod = catalogMap.get(id);
    if (!prod || !modalEl) return;
    currentModalProduct = prod;

    const baseColorObj = (prod.colors && prod.colors[0]) ? prod.colors[0] : { name: prod.color || 'Estándar', hex: prod.colorHex || '#0F172A', image: prod.image };
    selectedModalColor = initialColor || baseColorObj.name;

    let initialImg = prod.image;
    let initialHex = baseColorObj.hex || '#0F172A';
    if (selectedModalColor && prod.colors) {
      const matchCol = prod.colors.find((c: any) => c.name === selectedModalColor);
      if (matchCol) {
        if (matchCol.image) initialImg = matchCol.image;
        if (matchCol.hex) initialHex = matchCol.hex;
      }
    }

    if (mainImg) {
      mainImg.src = initialImg;
      mainImg.alt = `${prod.name} - ${selectedModalColor}`;
    }

    function updateStageColorIndicator(label: string, hex: string) {
      if (stageColorName) stageColorName.textContent = label || 'Color Estándar';
      if (stageColorDot) stageColorDot.style.backgroundColor = hex || '#0F172A';
    }

    function syncSelectedColorUI(colorName: string, colorHex: string) {
      selectedModalColor = colorName;
      if (selectedColorNameEl) selectedColorNameEl.textContent = colorName || 'Color Estándar';
      if (headerColorDot) headerColorDot.style.backgroundColor = colorHex || '#0F172A';
      updateStageColorIndicator(colorName, colorHex);
      if (colorsContainer) {
        colorsContainer.querySelectorAll('.pmodal-color-card').forEach(b => {
          const isMatch = b.getAttribute('data-color-name') === colorName;
          b.classList.toggle('active', isMatch);
        });
      }
      updateWaUrl();
    }

    updateStageColorIndicator(selectedModalColor, initialHex);
    if (headerColorDot) headerColorDot.style.backgroundColor = initialHex;
    if (selectedColorNameEl) selectedColorNameEl.textContent = selectedModalColor || 'Color Estándar';

    if (catBadge) catBadge.textContent = prod.category;
    if (skuText) skuText.textContent = prod.sku ? `SKU: ${prod.sku}` : 'SKU: N/A';
    if (extraBadge) extraBadge.textContent = [prod.line, prod.gender].filter(Boolean).join(' • ');

    if (titleEl) titleEl.textContent = prod.name;
    if (summaryEl) summaryEl.textContent = prod.summary || 'Vestuario y equipamiento técnico confeccionado bajo estrictos estándares corporativos e industriales, ideal para alta durabilidad y presentación institucional.';

    // Renderizado de variedad en cuadros profesionales de color
    if (colorsField && colorsContainer) {
      colorsContainer.innerHTML = '';
      if (prod.colors && prod.colors.length > 0) {
        colorsField.style.display = 'block';

        prod.colors.forEach((c: { name: string; hex: string; image?: string }) => {
          const card = document.createElement('button');
          card.type = 'button';
          const isSelected = c.name === selectedModalColor;
          card.className = `pmodal-color-card${isSelected ? ' active' : ''}`;
          card.setAttribute('data-color-name', c.name);
          card.setAttribute('aria-label', `Seleccionar color ${c.name}`);

          const isLight = isLightColorHex(c.hex);
          const checkStroke = isLight ? '#0F172A' : '#FFFFFF';

          card.innerHTML = `
            <span class="pmodal-swatch-disc" style="background-color: ${c.hex};">
              <svg class="swatch-check-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="${checkStroke}" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="pmodal-color-card-title">${c.name}</span>
          `;

          card.addEventListener('click', () => {
            const newImg = c.image || prod.image;
            syncSelectedColorUI(c.name, c.hex);
            switchMainImage(newImg);
            if (mainImg) mainImg.alt = `${prod.name} - ${c.name}`;
          });

          colorsContainer.appendChild(card);
        });
      } else {
        colorsField.style.display = 'none';
      }
    }

    // Tallas
    if (sizesField && sizesContainer) {
      sizesContainer.innerHTML = '';
      const sizes = prod.sizes && prod.sizes.length > 0 ? prod.sizes : ['S', 'M', 'L', 'XL', 'XXL'];
      selectedModalSize = sizes[0] || 'M';
      if (currentSizeLabel) currentSizeLabel.textContent = selectedModalSize;

      sizes.forEach((s: string, idx: number) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `pmodal-size-pill${idx === 0 ? ' selected' : ''}`;
        btn.textContent = s;
        btn.addEventListener('click', () => {
          sizesContainer.querySelectorAll('.pmodal-size-pill').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedModalSize = s;
          if (currentSizeLabel) currentSizeLabel.textContent = s;
          updateWaUrl();
        });
        sizesContainer.appendChild(btn);
      });
    }

    // Ficha técnica y materialidad
    if (specsField && specsContainer) {
      specsContainer.innerHTML = '';
      if (prod.features && prod.features.length > 0) {
        specsField.style.display = 'block';
        prod.features.slice(0, 8).forEach((f: { name: string; value: string }) => {
          const row = document.createElement('div');
          const isLong = f.value.length > 34 || f.name.toLowerCase() === 'atributos' || f.name.toLowerCase() === 'tecnologías';
          row.className = `pmodal-spec-row${isLong ? ' span-2' : ''}`;
          row.innerHTML = `<span class="spec-k">${f.name}</span><span class="spec-v">${f.value}</span>`;
          specsContainer.appendChild(row);
        });
      } else {
        specsField.style.display = 'none';
      }
    }

    if (qtyInput) qtyInput.value = '10';
    if (toastEl) toastEl.style.display = 'none';
    if (addBtnText) addBtnText.textContent = 'Agregar a Solicitud de Cotización';
    if (addBtn) addBtn.classList.remove('success');

    updateWaUrl();

    // Mostrar modal con animación fluida y centrado incondicional
    modalEl.style.display = 'flex';
    void modalEl.offsetHeight; // Forzar reflujo
    modalEl.classList.add('is-open');
    modalEl.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    document.body.classList.add('pmodal-open');

    // Reiniciar posición de scroll interno del modal
    modalEl.scrollTop = 0;
    if (modalDialog) modalDialog.scrollTop = 0;
  }

  function closeModal() {
    if (!modalEl) return;
    modalEl.classList.remove('is-open');
    modalEl.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    document.body.classList.remove('pmodal-open');
    setTimeout(() => {
      if (!modalEl.classList.contains('is-open')) {
        modalEl.style.display = 'none';
      }
    }, 280);
    currentModalProduct = null;
  }

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalEl && modalEl.classList.contains('is-open')) {
      closeModal();
    }
  });

  // Agregar desde el modal con color y talla seleccionados
  if (addBtn) {
    addBtn.addEventListener('click', () => {
      if (!currentModalProduct) return;
      const qty = qtyInput ? parseInt(qtyInput.value) || 1 : 10;

      const matchCol = currentModalProduct.colors?.find((c: any) => c.name === selectedModalColor);
      const chosenImg = matchCol?.image || currentModalProduct.image;
      const chosenHex = matchCol?.hex || currentModalProduct.colorHex || '#CBD5E0';

      const itemPayload = {
        id: currentModalProduct.id,
        name: currentModalProduct.name,
        category: currentModalProduct.category,
        sku: currentModalProduct.sku,
        image: chosenImg,
        qty: qty,
        size: selectedModalSize,
        color: selectedModalColor,
        colorHex: chosenHex,
      };

      if ((window as any).QuoteCart) {
        (window as any).QuoteCart.addItem(itemPayload);
      } else {
        window.dispatchEvent(new CustomEvent('add-product-to-quote', { detail: itemPayload }));
      }

      if (toastEl) toastEl.style.display = 'flex';
      addBtn.classList.add('success');
      if (addBtnText) addBtnText.textContent = '✓ Agregado al Cotizador';
      setTimeout(() => {
        if (addBtnText) addBtnText.textContent = 'Agregar a Cotización';
        addBtn.classList.remove('success');
      }, 2500);
    });
  }

  if (goQuoteBtn) {
    goQuoteBtn.addEventListener('click', () => {
      closeModal();
      if ((window as any).QuoteCart) {
        (window as any).QuoteCart.open();
      } else {
        const cotizarSec = document.getElementById('cotizar');
        if (cotizarSec) cotizarSec.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Click en tarjeta abre modal; click en "+ Cotizar" cotiza directo
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.product-btn') || (e.target as HTMLElement).closest('.card-swatch-dot')) return;
      const id = card.getAttribute('data-id');
      const chosenColor = card.getAttribute('data-selected-color') || card.getAttribute('data-color') || undefined;
      if (id) openModal(id, chosenColor);
    });

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        if ((e.target as HTMLElement).closest('.product-btn') || (e.target as HTMLElement).closest('.card-swatch-dot')) return;
        e.preventDefault();
        const id = card.getAttribute('data-id');
        const chosenColor = card.getAttribute('data-selected-color') || card.getAttribute('data-color') || undefined;
        if (id) openModal(id, chosenColor);
      }
    });
  });

  // Botón "+ Cotizar" en tarjeta con el color activo
  const productBtns = document.querySelectorAll('.product-btn');
  productBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const prodId = btn.getAttribute('data-product-id');
      if (!prodId) return;

      const prod = catalogMap.get(prodId);
      if (!prod) return;

      const parentCard = btn.closest('.product-card');
      const chosenColor = parentCard?.getAttribute('data-selected-color') || parentCard?.getAttribute('data-color') || (prod.colors && prod.colors[0] ? prod.colors[0].name : '');
      const matchCol = prod.colors?.find((c: any) => c.name === chosenColor);
      const chosenImg = matchCol?.image || prod.image;
      const chosenHex = matchCol?.hex || prod.colorHex || '#CBD5E0';

      const itemPayload = {
        id: prod.id,
        name: prod.name,
        category: prod.category,
        sku: prod.sku,
        image: chosenImg,
        qty: 10,
        size: 'M',
        color: chosenColor,
        colorHex: chosenHex,
      };

      if ((window as any).QuoteCart) {
        (window as any).QuoteCart.addItem(itemPayload);
      } else {
        window.dispatchEvent(new CustomEvent('add-product-to-quote', { detail: itemPayload }));
      }

      btn.classList.add('added');
      const span = btn.querySelector('span');
      if (span) {
        const originalText = span.textContent;
        span.textContent = '✓ En Cotizador';
        setTimeout(() => { span.textContent = originalText; }, 2000);
      }
    });
  });

  // Triggers globales (desde Menú Header y sección Categorías)
  document.addEventListener('click', (e) => {
    const searchTrigger = (e.target as HTMLElement).closest('[data-search-trigger]');
    if (searchTrigger) {
      e.preventDefault();
      const term = searchTrigger.getAttribute('data-search-trigger');
      if (term && searchInput) {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tabs[0]?.classList.add('active');
        tabs[0]?.setAttribute('aria-selected', 'true');
        activeCategory = 'all';
        searchInput.value = term;
        searchTerm = normalizeText(term);
        if (searchClearBtn) searchClearBtn.style.display = 'inline-flex';
        visibleLimit = BATCH_SIZE;
        updateVisibility();
        updateMobileCategoryDisplay();
        const sec = document.getElementById('productos');
        if (sec) sec.scrollIntoView({ behavior: 'smooth' });
      }
      return;
    }

    const catTrigger = (e.target as HTMLElement).closest('[data-category-trigger]');
    if (catTrigger) {
      e.preventDefault();
      const cat = catTrigger.getAttribute('data-category-trigger');
      if (cat) {
        if (searchInput) {
          searchInput.value = '';
          searchTerm = '';
          if (searchClearBtn) searchClearBtn.style.display = 'none';
        }
        tabs.forEach((t) => {
          if (t.getAttribute('data-filter') === cat) {
            (t as HTMLElement).click();
          }
        });
        const sec = document.getElementById('productos');
        if (sec) sec.scrollIntoView({ behavior: 'smooth' });
      }
      return;
    }
  });

  // ───────────────────────── Sincronización en Vivo (SaaS CMS Sync) ─────────────────────────
  async function syncLiveCatalog() {
    try {
      const res = await fetch('/api/products');
      if (!res.ok) return;
      const data = await res.json();
      if (!data.success || !Array.isArray(data.products)) return;

      const liveProducts = data.products;
      liveProducts.forEach((p: any) => {
        catalogMap.set(p.id, p);
      });

      const gridEl = document.getElementById('product-grid');
      if (!gridEl) return;

      const allDomCards = gridEl.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
      const existingCardIds = new Set<string>();

      allDomCards.forEach((c) => {
        const id = c.getAttribute('data-id');
        if (!id) return;
        existingCardIds.add(id);
        const liveItem = catalogMap.get(id);
        if (!liveItem || liveItem.isActive === false) {
          c.style.display = 'none';
          c.setAttribute('data-cms-inactive', 'true');
        } else {
          c.removeAttribute('data-cms-inactive');
          c.setAttribute('data-name', (liveItem.name || '').toLowerCase());
          c.setAttribute('data-sku', (liveItem.sku || '').toLowerCase());
          c.setAttribute('data-category', liveItem.category);
          const nameEl = c.querySelector('.product-name');
          if (nameEl && liveItem.name) nameEl.textContent = liveItem.name;
          const imgEl = c.querySelector('.product-img') as HTMLImageElement;
          if (imgEl && liveItem.image && !imgEl.src.endsWith(liveItem.image)) {
            imgEl.src = liveItem.image;
          }
        }
      });

      // Crear tarjetas para productos creados recientemente en el SaaS
      liveProducts.forEach((np: any, idx: number) => {
        if (!existingCardIds.has(np.id) && np.isActive !== false) {
          const newCard = document.createElement('div');
          newCard.className = 'product-card';
          newCard.setAttribute('data-id', np.id);
          newCard.setAttribute('data-base-id', np.baseId || np.id);
          newCard.setAttribute('data-category', np.category);
          newCard.setAttribute('data-name', (np.name || '').toLowerCase());
          newCard.setAttribute('data-color', (np.color || '').toLowerCase());
          newCard.setAttribute('data-sku', (np.sku || '').toLowerCase());
          newCard.setAttribute('data-summary', (np.summary || '').toLowerCase());
          newCard.setAttribute('data-default-img', np.image);
          newCard.setAttribute('data-index', String(allDomCards.length + idx));
          newCard.setAttribute('tabindex', '0');
          newCard.setAttribute('role', 'button');
          newCard.setAttribute('aria-label', `Ver ficha técnica de ${np.name}`);

          newCard.innerHTML = `
            <div class="product-img-wrapper">
              <img class="product-img" src="${np.image || '/images/catalogo/polera-corporativa.webp'}" alt="${np.name}" loading="lazy" decoding="async" width="300" height="300" />
              <span class="product-quick-hint">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                Ficha técnica
              </span>
            </div>
            <div class="product-info">
              <div class="product-cat-row">
                <span class="product-cat">${np.category}</span>
              </div>
              <h3 class="product-name" title="${np.name}">${np.name}</h3>
              ${np.sku ? `<span class="product-sku">SKU: ${np.sku}</span>` : ''}
              <button class="product-btn" data-product-id="${np.id}" type="button" title="Agregar ${np.name} al cotizador">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
                <span>Cotizar</span>
              </button>
            </div>
          `;

          newCard.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('.product-btn')) return;
            openModal(np.id);
          });

          const quoteBtn = newCard.querySelector('.product-btn');
          if (quoteBtn) {
            quoteBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              const itemPayload = {
                id: np.id,
                name: np.name,
                category: np.category,
                sku: np.sku,
                image: np.image,
                qty: 10,
                size: 'M',
                color: np.color || 'Estándar',
              };
              if ((window as any).QuoteCart) {
                (window as any).QuoteCart.addItem(itemPayload);
              } else {
                window.dispatchEvent(new CustomEvent('add-product-to-quote', { detail: itemPayload }));
              }
            });
          }

          gridEl.appendChild(newCard);
          existingCardIds.add(np.id);
        }
      });

      updateVisibility();
    } catch (e) {
      console.warn('Error in syncLiveCatalog:', e);
    }
  }

  // Canales de sincronización en tiempo real
  if (typeof BroadcastChannel !== 'undefined') {
    const liveCmsChannel = new BroadcastChannel('zortex_cms');
    liveCmsChannel.onmessage = (ev) => {
      if (ev.data && ev.data.type === 'PRODUCTS_UPDATED') {
        syncLiveCatalog();
      }
    };
  }

  window.addEventListener('storage', (e) => {
    if (e.key === 'zortex_cms_updated') {
      syncLiveCatalog();
    }
  });

  // Sincronizar catálogo al inicio en segundo plano diferido (no compite con render inicial)
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(() => syncLiveCatalog(), { timeout: 4000 });
  } else {
    setTimeout(syncLiveCatalog, 3000);
  }

  // Inicializar estado al cargar
  updateVisibility();
  updateMobileCategoryDisplay();
</script>
