  // Reglas estrictas por tipo de prenda (para evitar falsos positivos como mostrar gorros al buscar parkas o camisas al buscar cargo)
  const STRICT_CATEGORY_RULES: Record<string, (name: string, cat: string, line: string, sku: string) => boolean> = {
    'parka': (name) => name.includes('parka'),
    'parkas': (name) => name.includes('parka'),
    'parkas termicas': (name) => name.includes('parka'),
    'parka termica': (name) => name.includes('parka'),
    'parkas alta visibilidad': (name) => name.includes('parka') && (name.includes('visibilidad') || name.includes('clase') || name.includes('fluor')),
    'cargo': (name) => name.includes('cargo'),
    'pantalones cargo': (name) => name.includes('cargo'),
    'pantalon cargo': (name) => name.includes('cargo'),
    'pantalon': (name) => name.includes('pantalon') || name.includes('cargo') || name.includes('jean'),
    'pantalones': (name) => name.includes('pantalon') || name.includes('cargo') || name.includes('jean'),
    'camisa': (name) => name.includes('camisa') || name.includes('blusa'),
    'camisas': (name) => name.includes('camisa') || name.includes('blusa'),
    'blusa': (name) => name.includes('blusa'),
    'blusas': (name) => name.includes('blusa'),
    'softshell': (name) => name.includes('softshell'),
    'chaquetas softshell': (name) => name.includes('softshell'),
    'chaqueta softshell': (name) => name.includes('softshell'),
    'chaqueta termica': (name) => name.includes('chaqueta') && (name.includes('termic') || name.includes('resist')),
    'chaquetas termicas': (name) => name.includes('chaqueta') && (name.includes('termic') || name.includes('resist')),
    'polar': (name) => name.includes('polar') || name.includes('fleece') || name.includes('micropolar'),
    'polares': (name) => name.includes('polar') || name.includes('fleece') || name.includes('micropolar'),
    'poleron': (name) => name.includes('poleron'),
    'polerones': (name) => name.includes('poleron'),
    'polera': (name) => name.includes('polera') || name.includes('polo'),
    'poleras': (name) => name.includes('polera') || name.includes('polo'),
    'poleras pique': (name) => name.includes('pique') || name.includes('polo'),
    'polera pique': (name) => name.includes('pique') || name.includes('polo'),
    'overol': (name) => name.includes('overol') || name.includes('jardinera'),
    'overoles': (name) => name.includes('overol') || name.includes('jardinera'),
    'buzos de trabajo': (name) => name.includes('overol') || name.includes('jardinera') || name.includes('buzo'),
    'buzo de trabajo': (name) => name.includes('overol') || name.includes('jardinera') || name.includes('buzo'),
    'chaleco geologo': (name) => name.includes('geologo'),
    'chalecos geologo': (name) => name.includes('geologo'),
    'gorro': (name) => name.includes('gorro') || name.includes('jockey') || name.includes('bandana'),
    'gorros': (name) => name.includes('gorro') || name.includes('jockey') || name.includes('bandana'),
    'jockey': (name) => name.includes('jockey') || name.includes('gorro'),
    'ropa ignifuga': (name) => name.includes('ignifug') || name.includes('antiestatic'),
    'cintas reflectantes': (name) => name.includes('cinta') || name.includes('reflectiv') || name.includes('reflex'),
