<style>
  #productos {
    padding: 80px 0 90px;
    background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    position: relative;
  }

  .products-wrap {
    width: 100%;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
    box-sizing: border-box;
  }

  /* Header de la sección */
  .products-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    padding-bottom: 26px;
    border-bottom: 1px solid #E2E8F0;
  }

  .products-title-col {
    flex: 1 1 560px;
    max-width: 780px;
  }

  .products-eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    padding: 5px 12px;
    border-radius: 9999px;
    font-family: var(--mono, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #0F172A;
    margin-bottom: 14px;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    animation: livePulse 2s infinite ease-in-out;
    will-change: transform, opacity;
  }

  @keyframes livePulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.7;
    }
  }

  .eyebrow-text {
    font-weight: 700;
    color: #0F172A;
  }

  .eyebrow-dot {
    color: #94A3B8;
  }

  .eyebrow-stat {
    color: #475569;
  }

  .products-header h2 {
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 10px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    font-family: var(--display, system-ui);
  }

  .products-lead {
    color: #475569;
    font-size: 15.5px;
    margin: 0 0 16px;
    line-height: 1.55;
  }

  .products-trust-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #334155;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    padding: 3px 10px;
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.02);
  }

  .trust-chip svg {
    color: #059669;
    flex-shrink: 0;
  }

  /* Buscador B2B */
  .catalog-search-wrap {
    flex: 1 1 380px;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .search-input-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748B;
    pointer-events: none;
    transition: color 0.2s;
  }

  .catalog-search-input {
    width: 100%;
    height: 46px;
    padding: 0 42px 0 44px;
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    border-radius: 10px;
    font-size: 13.5px;
    color: #0F172A;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: var(--body, system-ui);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .catalog-search-input:focus {
    border-color: #0F172A;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
  }

  .catalog-search-input:focus + .search-clear-btn + .search-icon,
  .search-input-box:focus-within .search-icon {
    color: #0F172A;
  }

  .search-clear-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #475569;
    transition: all 0.2s;
  }

  .search-clear-btn:hover {
    background: #E2E8F0;
    color: #0F172A;
  }

  .search-quick-hints {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 12px;
  }

  .hint-label {
    color: #64748B;
    font-size: 11.5px;
    font-weight: 500;
  }

  .hint-btn {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 1px 7px;
    font-size: 11.5px;
    color: #475569;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.18s;
  }

  .hint-btn:hover {
    background: #F1F5F9;
    border-color: #CBD5E1;
    color: #0F172A;
  }

  /* Panel y filtros de categoría */
  .catalog-control-panel {
    margin-bottom: 28px;
    max-width: 100%;
    overflow: hidden;
  }

  /* Stepper de categorías para móviles */
  .mobile-cat-stepper {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 7px 10px;
    margin-bottom: 10px;
    width: 100%;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
  }

  .mobile-step-arrow-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 7px 12px;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #0F2744;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition: all 0.18s ease;
    flex-shrink: 0;
    touch-action: manipulation;
  }

  .mobile-step-arrow-btn:active {
    background: #0F2744;
    color: #FFFFFF;
    border-color: #0F2744;
    transform: scale(0.96);
  }

  .mobile-step-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 0;
    flex: 1;
    overflow: hidden;
    padding: 0 4px;
  }

  .mobile-pill-prefix {
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748B;
    line-height: 1;
    margin-bottom: 3px;
  }

  .mobile-pill-text {
    font-size: 13px;
    font-weight: 800;
    color: #0F2744;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .mobile-curr-count {
    font-size: 11px;
    font-weight: 700;
    color: #1D4ED8;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    padding: 1px 6px;
    border-radius: 999px;
    margin-left: 4px;
    vertical-align: middle;
  }

  /* Contenedor con flechas de navegación táctil para las pestañas */
  .product-tabs-nav-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    gap: 6px;
  }

  .tabs-nav-arrow {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    color: #0F2744;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.1);
    cursor: pointer;
    flex-shrink: 0;
    z-index: 5;
    transition: all 0.2s ease;
    touch-action: manipulation;
  }

  .tabs-nav-arrow:hover {
    background: #0F2744;
    color: #FFFFFF;
    border-color: #0F2744;
  }

  .tabs-nav-arrow:active {
    transform: scale(0.92);
  }

  .product-tabs-scroll-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0;
    padding: 4px 2px 8px;
    max-width: 100%;
    flex: 1;
    scroll-behavior: smooth;
  }

  .product-tabs-scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .product-tabs {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    width: 100%;
  }

  @media (max-width: 900px) {
    .mobile-cat-stepper {
      display: flex;
    }

    .tabs-nav-arrow {
      display: flex;
    }

    .product-tabs-scroll-wrapper {
      margin: 0 !important;
      padding: 4px 4px 8px !important;
      scroll-snap-type: x proximity;
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }

    .product-tabs {
      flex-wrap: nowrap;
      width: max-content;
    }

    .product-tab {
      padding: 7px 13px;
      font-size: 12.5px;
      scroll-snap-align: start;
    }

    .product-tab .tab-count {
      font-size: 11px;
      height: 18px;
      padding: 0 6px;
    }
  }

  .product-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 9999px;
    color: #334155;
    font-size: 13.5px;
    font-weight: 600;
    font-family: var(--body, system-ui);
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    user-select: none;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    flex-shrink: 0;
  }

  .product-tab .tab-icon {
    color: #64748B;
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .product-tab:hover {
    border-color: #0F172A;
    color: #0F172A;
    background: #FFFFFF;
    transform: translateY(-1.5px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  }

  .product-tab:hover .tab-icon {
    color: #0F172A;
    transform: scale(1.1);
  }

  .product-tab.active {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    color: #FFFFFF;
    border-color: #0F172A;
    box-shadow: 0 6px 18px -2px rgba(15, 23, 42, 0.28), 0 2px 4px rgba(15, 23, 42, 0.1);
    transform: translateY(-1px);
  }

  .product-tab.active .tab-icon {
    color: #38BDF8;
  }

  .product-tab .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 20px;
    padding: 0 7px;
    border-radius: 9999px;
    font-size: 11.5px;
    font-weight: 700;
    font-family: var(--mono, monospace);
    font-feature-settings: "tnum";
    background: #F1F5F9;
    color: #334155;
    border: 1px solid #E2E8F0;
    transition: all 0.2s ease;
  }

  .product-tab:hover .tab-count {
    background: #E2E8F0;
    color: #0F172A;
  }

  .product-tab.active .tab-count {
    background: rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* Barra de estado en tiempo real */
  .catalog-status-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 9px 16px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 9999px;
    margin-top: 6px;
    width: fit-content;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
  }

  .catalog-status-info {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .catalog-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2.5px rgba(16, 185, 129, 0.2);
    flex-shrink: 0;
  }

  .catalog-status-text {
    font-size: 13px;
    color: #475569;
  }

  .catalog-status-text strong {
    color: #0F172A;
    font-weight: 700;
  }

  /* Grid: 6 columnas en escritorio */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
  }

  @media (max-width: 1320px) {
    .products-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 960px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  /* Tarjetas de Producto Ejecutivas */
  .product-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s ease, box-shadow 0.22s ease;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-3px);
    border-color: #0F172A;
    box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.12), 0 4px 8px -2px rgba(15, 23, 42, 0.05);
  }

  .product-img-wrapper {
    position: relative;
    width: 100%;
    height: 192px;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    box-sizing: border-box;
    border-bottom: 1px solid #F1F5F9;
    overflow: hidden;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.05);
  }

  .product-quick-hint {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    font-size: 10.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    opacity: 0;
    transition: all 0.22s ease;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    white-space: nowrap;
  }

  .product-card:hover .product-quick-hint {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  .product-info {
    padding: 12px 13px 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    box-sizing: border-box;
  }

  .product-cat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
  }

  .product-cat {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #334155;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-color-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    font-weight: 600;
    color: #0F172A;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 1px 6px;
    border-radius: 5px;
    max-width: 108px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .color-dot-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.18);
    flex-shrink: 0;
  }

  .product-name {
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.32;
    color: #0F172A;
    margin: 0 0 8px;
    min-height: 36px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--display, system-ui);
    letter-spacing: -0.01em;
  }

  /* Swatches de variedad en colores en la tarjeta */
  .card-swatches {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 8px;
    min-height: 18px;
  }

  .card-swatch-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid #FFFFFF;
    box-shadow: 0 0 0 1px #CBD5E1;
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    outline: none;
    flex-shrink: 0;
  }

  .card-swatch-dot:hover {
    transform: scale(1.25);
    z-index: 2;
  }

  .card-swatch-dot.active {
    box-shadow: 0 0 0 1.5px #0F172A;
    transform: scale(1.15);
  }

  .card-swatch-more {
    font-size: 9.5px;
    font-weight: 700;
    font-family: var(--mono, monospace);
    color: #0F172A;
    background: #F1F5F9;
    padding: 1px 5px;
    border-radius: 4px;
    line-height: 13px;
  }

  .product-sku {
    font-size: 11px;
    color: #475569;
    margin-bottom: 10px;
    font-family: var(--mono, monospace);
    font-weight: 500;
  }

  .product-btn {
    margin-top: auto;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 9.5px 14px;
    font-size: 13px;
    font-weight: 700;
    font-family: var(--body, system-ui);
    color: #FFFFFF;
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    cursor: pointer;
