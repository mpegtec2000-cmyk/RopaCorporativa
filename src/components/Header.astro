---
import { SITE, CATEGORIES, WHATSAPP_NUMBER } from '../config';
import { getSettings, getPublicProducts } from '../lib/cms/store';

const settings = await getSettings();
const phone = settings.contactPhone || SITE.phone;
const email = settings.contactEmail || SITE.email;
const address = settings.contactAddress || SITE.address;

const allProducts = await getPublicProducts();
const searchIndex = allProducts.map((p) => ({
  id: p.id,
  name: p.displayName || p.name,
  category: p.category,
  image: p.image,
  sku: p.sku || '',
  summary: p.summary || '',
}));
---

<!-- Top bar -->
<div class="topbar">
  <div class="wrap topbar-inner">
    <div class="topbar-left">
      <a href="https://maps.google.com/?q=Manzano+254,+Recoleta,+Santiago" target="_blank" rel="noopener noreferrer" class="topbar-item" style="text-decoration:none;" title="Ver ubicación en Google Maps">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:5px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        {address}
      </a>
      <span class="topbar-sep">|</span>
      <a href={`mailto:${email}`} class="topbar-item" style="text-decoration:none;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:5px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {email}
      </a>
      <span class="topbar-sep">|</span>
      <a href={`tel:${phone.replace(/\s+/g, '')}`} class="topbar-item" style="text-decoration:none;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:5px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {phone}
      </a>
    </div>
    <a class="topbar-wa" href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      {settings.topbarWhatsappText || 'Atención Directa por WhatsApp'}
    </a>
  </div>
</div>

<!-- Stripe -->
<div class="stripe"></div>

<!-- Main header -->
<header class="site-header">
  <div class="nav">
    <a href="/" class="logo" aria-label="Inicio">
      <img src="/images/zortex_logo_transparente.png" alt={SITE.name} class="logo-img" width="147" height="42" />
    </a>

    <!-- Barra de Búsqueda de Productos (Desktop) -->
    <div class="header-search-desktop" role="search">
      <div class="search-pill-box">
        <svg class="search-pill-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="desktop-header-search"
          class="search-pill-input"
          placeholder="Búsqueda de productos"
          autocomplete="off"
          aria-label="Búsqueda de productos"
        />
        <button type="button" class="search-pill-clear" id="desktop-search-clear" aria-label="Limpiar búsqueda" style="display: none;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Dropdown flotante con resultados en vivo -->
      <div class="search-suggestions-dropdown" id="desktop-search-dropdown" style="display: none;"></div>
    </div>

    <nav class="nav-links" aria-label="Navegación principal">
      <a href="#">Inicio</a>
      <div class="nav-dropdown">
        <a href="#lineas" class="nav-dropdown-trigger">
          Líneas y Categorías
          <svg class="dropdown-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="mega-menu">
          {CATEGORIES.map(cat => (
            <div class="mega-col">
              <a href="#productos" class="mega-title" data-category-trigger={cat.name}>{cat.name}</a>
              <ul class="mega-list">
                {cat.subcategories.map(sub => (
                  <li><a href="#productos" data-search-trigger={sub}>{sub}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <a href="#productos">Catálogo</a>
      <a href="#rubros">Industrias</a>
    </nav>
    <div class="header-actions">
      <button type="button" class="header-cart-btn" id="header-cart-btn" aria-label="Abrir carrito de cotización" title="Ver mi cotización">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span class="header-cart-label">Mi Solicitud</span>
        <span class="header-cart-badge" style="display: none;">0</span>
      </button>
      <a class="btn header-cta-btn" href="#cotizar">
        <span>Solicitar Cotización</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/sistema" class="header-system-btn" aria-label="Ingreso al Sistema" title="Acceso al Sistema ZORTEX">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </a>
      <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" id="menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Barra de Búsqueda de Productos (Móvil - Fila Dedicada) -->
  <div class="header-search-mobile" role="search">
    <div class="search-pill-box">
      <svg class="search-pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="mobile-header-search"
        class="search-pill-input"
        placeholder="Búsqueda de productos"
        autocomplete="off"
        aria-label="Búsqueda de productos"
      />
      <button type="button" class="search-pill-clear" id="mobile-search-clear" aria-label="Limpiar búsqueda" style="display: none;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Dropdown móvil con resultados en vivo -->
    <div class="search-suggestions-dropdown mobile-dropdown" id="mobile-search-dropdown" style="display: none;"></div>
  </div>
</header>

<!-- Datos de productos serializados para búsqueda instantánea en cliente -->
<script id="header-search-products-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

<!-- Mobile menu backdrop overlay -->
<div class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-hidden="true"></div>

<!-- Mobile menu drawer -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menú de navegación principal">
  <div class="mobile-menu-header">
    <a href="/" class="mobile-menu-logo" aria-label="Inicio Zortex">
      <img src="/images/zortex_logo_transparente.png" alt={SITE.name} class="mobile-logo-img" width="112" height="32" />
    </a>
    <button class="mobile-close" id="mobile-close" aria-label="Cerrar menú">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-menu-body">
    <div class="drawer-search-wrap" role="search">
      <div class="search-pill-box">
        <svg class="search-pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="drawer-header-search"
          class="search-pill-input"
          placeholder="Búsqueda de productos"
          autocomplete="off"
          aria-label="Búsqueda de productos"
        />
      </div>
    </div>
    <nav class="mobile-nav-links">
      <a href="#" class="mobile-nav-item">
        <span>Inicio</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#lineas" class="mobile-nav-item">
        <span>Líneas y Categorías</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#productos" class="mobile-nav-item">
        <span>Catálogo de Productos</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#rubros" class="mobile-nav-item">
        <span>Sectores e Industrias</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#como-funciona" class="mobile-nav-item">
        <span>Cómo Funciona</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="/sistema" class="mobile-nav-item mobile-system-link">
        <span style="display:flex;align-items:center;gap:8px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Acceso al Sistema
        </span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    </nav>
  </div>

  <div class="mobile-menu-footer">
    <button type="button" class="mobile-cart-btn" id="mobile-cart-btn">
      <div class="mobile-cart-btn-left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span>Mi Solicitud de Cotización</span>
      </div>
      <span class="header-cart-badge" id="mobile-cart-badge-val" style="display: none;">0</span>
    </button>
    <a class="btn mobile-cta-btn" href="#cotizar">
      <span>Solicitar Cotización Formal</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <a href="https://maps.google.com/?q=Manzano+254,+Recoleta,+Santiago" target="_blank" rel="noopener noreferrer" class="mobile-local-info" style="font-size:12.5px;color:#94A3B8;display:flex;align-items:center;gap:7px;margin-bottom:12px;text-decoration:none;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Local: <strong style="color:#F1F5F9;">{address}</strong></span>
    </a>
    <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="mobile-wa-direct">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>Venta Mayorista Directa: {phone}</span>
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const close = document.getElementById('mobile-close');
  const headerCartBtn = document.getElementById('header-cart-btn');
  const mobileCartBtn = document.getElementById('mobile-cart-btn');
  const dropdownTrigger = document.querySelector('.nav-dropdown-trigger');
  const navDropdown = document.querySelector('.nav-dropdown');
  
  function openMenu() {
    if (menu) menu.classList.add('open');
    if (backdrop) backdrop.classList.add('open');
    if (toggle) toggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('mobile-nav-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (menu) menu.classList.remove('open');
    if (backdrop) backdrop.classList.remove('open');
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('mobile-nav-open');
    document.body.style.overflow = '';
  }
  
  if (toggle) toggle.addEventListener('click', openMenu);
  if (close) close.addEventListener('click', closeMenu);
  if (backdrop) backdrop.addEventListener('click', closeMenu);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) closeMenu();
  });
  if (menu) {
    menu.querySelectorAll('.mobile-nav-item, .mobile-cta-btn').forEach((a) => {
      a.addEventListener('click', (e) => {
        const href = (a as HTMLAnchorElement).getAttribute('href');
        closeMenu();
        if (href && href.startsWith('#')) {
          e.preventDefault();
          const targetId = href.substring(1);
          const targetEl = targetId ? document.getElementById(targetId) : null;
          if (targetEl) {
            setTimeout(() => {
              targetEl.scrollIntoView({ behavior: 'smooth' });
            }, 100);
          } else if (href === '#') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        }
      });
    });
  }

  // Click en "Líneas y Categorías" en versión desktop o táctil
  if (dropdownTrigger) {
    dropdownTrigger.addEventListener('click', (e) => {
      // Si el usuario hace click, navega suavemente a #lineas
      e.preventDefault();
      const targetEl = document.getElementById('lineas');
      if (targetEl) {
        targetEl.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Cerrar el mega-menu al hacer click en cualquier enlace dentro de él
  if (navDropdown) {
    navDropdown.querySelectorAll('.mega-menu a').forEach((link) => {
      link.addEventListener('click', () => {
        (navDropdown as HTMLElement).blur();
        if (document.activeElement instanceof HTMLElement) {
          document.activeElement.blur();
        }
      });
    });
  }

  function openQuoteCart() {
    if ((window as any).QuoteCart) {
      (window as any).QuoteCart.open();
    }
  }

  if (headerCartBtn) headerCartBtn.addEventListener('click', openQuoteCart);
  if (mobileCartBtn) {
    mobileCartBtn.addEventListener('click', () => {
      closeMenu();
      openQuoteCart();
    });
  }

  // =========================================================================
  // CONTROLADOR DE BÚSQUEDA INTERACTIVA (DESKTOP, MÓVIL Y MENÚ DRAWER)
  // =========================================================================
  function initHeaderSearch() {
    const dataEl = document.getElementById('header-search-products-data');
    if (!dataEl) return;
    let products: Array<{ id: string; name: string; category: string; image: string; sku: string; summary: string }> = [];
    try {
      products = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
      console.error('Error parsing search products:', e);
      return;
    }

    function normalize(str: string): string {
      return (str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    const SYNONYMS: Record<string, string[]> = {
      calzado: ['zapato', 'botin', 'calzado', 'bota', 'dielectrico', 'puntera'],
      botin: ['botin', 'zapato', 'calzado', 'bota'],
      botines: ['botin', 'zapato', 'calzado', 'bota'],
      zapato: ['zapato', 'botin', 'calzado', 'bota', 'dielectrico'],
      zapatos: ['zapato', 'botin', 'calzado', 'bota'],
      dielectrico: ['dielectrico', 'zapato', 'botin', 'calzado'],
      casco: ['casco', 'barbiquejo'],
      cascos: ['casco', 'barbiquejo'],
      lente: ['lente', 'antiparra', 'uv', 'proteccion visual'],
      lentes: ['lente', 'antiparra', 'uv', 'proteccion visual'],
      guante: ['guante', 'cabritilla', 'nitrilo'],
      guantes: ['guante', 'cabritilla', 'nitrilo'],
      pantalon: ['pantalon', 'cargo', 'bermuda', 'jean'],
      pantalones: ['pantalon', 'cargo', 'bermuda', 'jean'],
      cargo: ['cargo', 'pantalon', 'bolsillo'],
      polar: ['polar', 'fleece', 'micropolar'],
      polares: ['polar', 'fleece', 'micropolar'],
      termico: ['termico', 'softshell', 'parka', 'polar', 'abrigo', 'chaqueta'],
      termica: ['termica', 'termico', 'softshell', 'parka', 'polar', 'chaqueta'],
      geologo: ['geologo', 'chaleco'],
      chaleco: ['chaleco', 'geologo'],
      chalecos: ['chaleco', 'geologo'],
      polera: ['polera', 'polo', 'pique'],
      poleras: ['polera', 'polo', 'pique'],
      pique: ['pique', 'polo', 'polera'],
      softshell: ['softshell', 'chaqueta'],
      parka: ['parka', 'chaqueta', 'termico', 'termica'],
      parkas: ['parka', 'chaqueta', 'termico', 'termica'],
      overol: ['overol', 'buzo', 'jardinera'],
      overoles: ['overol', 'buzo', 'jardinera'],
    };

    function matches(prod: any, qNorm: string): boolean {
      if (!qNorm) return false;
      const nameNorm = normalize(prod.name);
      const catNorm = normalize(prod.category);
      const skuNorm = normalize(prod.sku);
      const sumNorm = normalize(prod.summary);
      const fullText = `${nameNorm} ${catNorm} ${skuNorm} ${sumNorm}`;

      if (fullText.includes(qNorm)) return true;

      const words = qNorm.split(/\s+/).filter(Boolean);
      return words.every((word) => {
        if (fullText.includes(word)) return true;
        const syns = SYNONYMS[word];
        if (syns && syns.some((s) => fullText.includes(s))) return true;
        return false;
      });
    }

    function highlightMatch(text: string, query: string): string {
      if (!query.trim()) return text;
      const clean = query.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${clean})`, 'gi');
      return text.replace(regex, '<mark>$1</mark>');
    }

    function escapeHtml(str: string): string {
      return (str || '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] || m));
    }

    function triggerCatalogSearch(query: string) {
      if (!query.trim()) return;
      window.dispatchEvent(new CustomEvent('filter-catalog-search', { detail: { query: query.trim() } }));
      closeMenu();
    }

    function setupSearchPair(inputId: string, clearId: string, dropdownId: string) {
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const clearBtn = document.getElementById(clearId) as HTMLButtonElement | null;
      const dropdown = document.getElementById(dropdownId) as HTMLElement | null;
      if (!input || !dropdown) return;

      let selectedIdx = -1;

      function renderDropdown(query: string) {
        const qNorm = normalize(query);
        if (!qNorm) {
          dropdown.style.display = 'none';
          dropdown.innerHTML = '';
          selectedIdx = -1;
          return;
        }

        const matched = products.filter((p) => matches(p, qNorm));

        if (matched.length === 0) {
          dropdown.innerHTML = `
            <div class="search-empty-box">
              <div class="search-empty-title">No encontramos modelos para "<strong>${escapeHtml(query)}</strong>"</div>
              <div class="search-quick-tags">
                <span style="font-size:11px;color:#64748B;width:100%;margin-bottom:4px;display:block;">Búsquedas sugeridas:</span>
                <button type="button" class="quick-tag-btn" data-q="Softshell">Softshell</button>
                <button type="button" class="quick-tag-btn" data-q="Parka">Parka</button>
                <button type="button" class="quick-tag-btn" data-q="Cargo">Cargo</button>
                <button type="button" class="quick-tag-btn" data-q="Calzado">Calzado</button>
                <button type="button" class="quick-tag-btn" data-q="Geólogo">Geólogo</button>
                <button type="button" class="quick-tag-btn" data-q="Polera">Polera</button>
              </div>
            </div>
          `;
          dropdown.style.display = 'flex';
          setupEmptyTagListeners(dropdown, input, clearBtn);
          return;
        }

        const topItems = matched.slice(0, 5);
        const itemsHtml = topItems.map((p, idx) => `
          <div class="search-result-row" data-id="${p.id}" data-index="${idx}" style="display:flex;align-items:center;gap:12px;padding:10px 14px;cursor:pointer;border-bottom:1px solid #F1F5F9;">
            <img src="${p.image}" alt="${escapeHtml(p.name)}" class="search-result-thumb" width="44" height="44" style="width:44px;height:44px;min-width:44px;min-height:44px;max-width:44px;max-height:44px;object-fit:contain;border-radius:8px;background:#F8FAFC;border:1px solid #E2E8F0;padding:2px;flex-shrink:0;display:block;" loading="lazy" />
            <div class="search-result-meta" style="flex:1;min-width:0;">
              <div class="search-result-title" style="font-size:13.5px;font-weight:600;color:#0F172A;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:3px;line-height:1.3;">${highlightMatch(escapeHtml(p.name), query)}</div>
              <div class="search-result-tags" style="display:flex;align-items:center;gap:8px;font-size:11px;">
                <span class="search-result-cat" style="color:#2563EB;font-weight:600;">${escapeHtml(p.category)}</span>
                ${p.sku ? `<span class="search-result-sku" style="color:#64748B;font-family:var(--mono, monospace);">SKU: ${escapeHtml(p.sku)}</span>` : ''}
              </div>
            </div>
            <svg class="search-result-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#94A3B8;flex-shrink:0;"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        `).join('');

        dropdown.innerHTML = `
          <div class="search-dropdown-head">
            <span>Resultados sugeridos</span>
            <span class="search-dropdown-count">${matched.length} modelos</span>
          </div>
          <div class="search-results-list">
            ${itemsHtml}
          </div>
          <div class="search-dropdown-foot">
            <button type="button" class="search-view-all-btn" id="${dropdownId}-view-all">
              <span>Ver todos los resultados (${matched.length})</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>
        `;

        dropdown.style.display = 'flex';
        selectedIdx = -1;

        dropdown.querySelectorAll('.search-result-row').forEach((row) => {
          row.addEventListener('click', (e) => {
            e.preventDefault();
            const id = row.getAttribute('data-id');
            if (id) {
              window.dispatchEvent(new CustomEvent('open-product-modal', { detail: { id } }));
              closeDropdown();
            }
          });
        });

        const viewAllBtn = document.getElementById(`${dropdownId}-view-all`);
        if (viewAllBtn) {
          viewAllBtn.addEventListener('click', () => {
            triggerCatalogSearch(query);
            closeDropdown();
          });
        }
      }

      function closeDropdown() {
        dropdown.style.display = 'none';
        selectedIdx = -1;
      }

      input.addEventListener('input', () => {
        const val = input.value;
        if (clearBtn) clearBtn.style.display = val ? 'inline-flex' : 'none';
        renderDropdown(val);
      });

      input.addEventListener('focus', () => {
        if (input.value.trim()) renderDropdown(input.value);
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          clearBtn.style.display = 'none';
          closeDropdown();
          input.focus();
        });
      }

      input.addEventListener('keydown', (e) => {
        const rows = dropdown.querySelectorAll('.search-result-row');
        if (dropdown.style.display !== 'none' && rows.length > 0) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIdx = (selectedIdx + 1) % rows.length;
            updateRowSelection(rows, selectedIdx);
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIdx = (selectedIdx - 1 + rows.length) % rows.length;
            updateRowSelection(rows, selectedIdx);
            return;
          }
          if (e.key === 'Enter') {
            e.preventDefault();
            if (selectedIdx >= 0 && rows[selectedIdx]) {
              const id = rows[selectedIdx].getAttribute('data-id');
              if (id) window.dispatchEvent(new CustomEvent('open-product-modal', { detail: { id } }));
            } else {
              triggerCatalogSearch(input.value);
            }
            closeDropdown();
            return;
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          triggerCatalogSearch(input.value);
          closeDropdown();
        }

        if (e.key === 'Escape') {
          closeDropdown();
        }
      });

      document.addEventListener('click', (e) => {
        if (!input.contains(e.target as Node) && !dropdown.contains(e.target as Node) && (!clearBtn || !clearBtn.contains(e.target as Node))) {
          closeDropdown();
        }
      });
    }

    function setupEmptyTagListeners(dropdown: HTMLElement, input: HTMLInputElement, clearBtn: HTMLButtonElement | null) {
      dropdown.querySelectorAll('.quick-tag-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-q') || '';
          input.value = q;
          if (clearBtn) clearBtn.style.display = 'inline-flex';
          triggerCatalogSearch(q);
          dropdown.style.display = 'none';
        });
      });
    }

    function updateRowSelection(rows: NodeListOf<Element>, selectedIndex: number) {
      rows.forEach((r, idx) => {
        if (idx === selectedIndex) {
          r.classList.add('selected');
          r.scrollIntoView({ block: 'nearest' });
        } else {
          r.classList.remove('selected');
        }
      });
    }

    setupSearchPair('desktop-header-search', 'desktop-search-clear', 'desktop-search-dropdown');
    setupSearchPair('mobile-header-search', 'mobile-search-clear', 'mobile-search-dropdown');

    const drawerSearch = document.getElementById('drawer-header-search') as HTMLInputElement | null;
    if (drawerSearch) {
      drawerSearch.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          triggerCatalogSearch(drawerSearch.value);
        }
      });
    }
  }

  initHeaderSearch();
</script>

