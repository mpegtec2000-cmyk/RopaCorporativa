---
import { SITE, CATEGORIES, WHATSAPP_NUMBER } from '../config';
---

<!-- Top bar -->
<div class="topbar">
  <div class="wrap topbar-inner">
    <div class="topbar-left">
      <span class="topbar-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:5px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {SITE.email}
      </span>
      <span class="topbar-sep">|</span>
      <span class="topbar-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:5px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {SITE.phone}
      </span>
    </div>
    <a class="topbar-wa" href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Atención Directa por WhatsApp
    </a>
  </div>
</div>

<!-- Stripe -->
<div class="stripe"></div>

<!-- Main header -->
<header>
  <div class="nav">
    <a href="/" class="logo" aria-label="Inicio">
      <img src="/images/zortex_logo_transparente.png" alt={SITE.name} class="logo-img" width="160" height="42" />
    </a>
    <nav class="nav-links" aria-label="Navegación principal">
      <a href="#">Inicio</a>
      <div class="nav-dropdown">
        <a href="#lineas" class="nav-dropdown-trigger">
          Líneas y Categorías
          <svg class="dropdown-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="mega-menu">
          {CATEGORIES.map(cat => (
            <div class="mega-col">
              <a href="#productos" class="mega-title" data-category-trigger={cat.name}>{cat.name}</a>
              <ul class="mega-list">
                {cat.subcategories.map(sub => (
                  <li><a href="#productos" data-search-trigger={sub}>{sub}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <a href="#productos">Catálogo</a>
      <a href="#rubros">Industrias</a>
    </nav>
    <div class="header-actions">
      <button type="button" class="header-cart-btn" id="header-cart-btn" aria-label="Abrir carrito de cotización" title="Ver mi cotización">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span class="header-cart-label">Mi Solicitud</span>
        <span class="header-cart-badge" style="display: none;">0</span>
      </button>
      <a class="btn header-cta-btn" href="#cotizar">
        <span>Solicitar Cotización</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" id="menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu backdrop overlay -->
<div class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-hidden="true"></div>

<!-- Mobile menu drawer -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menú de navegación principal">
  <div class="mobile-menu-header">
    <a href="/" class="mobile-menu-logo" aria-label="Inicio Zortex">
      <img src="/images/zortex_logo_transparente.png" alt={SITE.name} class="mobile-logo-img" width="130" height="34" />
    </a>
    <button class="mobile-close" id="mobile-close" aria-label="Cerrar menú">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-menu-body">
    <nav class="mobile-nav-links">
      <a href="#" class="mobile-nav-item">
        <span>Inicio</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#lineas" class="mobile-nav-item">
        <span>Líneas y Categorías</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#productos" class="mobile-nav-item">
        <span>Catálogo de Productos</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#rubros" class="mobile-nav-item">
        <span>Sectores e Industrias</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#como-funciona" class="mobile-nav-item">
        <span>Cómo Funciona</span>
        <svg class="mobile-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    </nav>
  </div>

  <div class="mobile-menu-footer">
    <button type="button" class="mobile-cart-btn" id="mobile-cart-btn">
      <div class="mobile-cart-btn-left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span>Mi Solicitud de Cotización</span>
      </div>
      <span class="header-cart-badge" id="mobile-cart-badge-val" style="display: none;">0</span>
    </button>
    <a class="btn mobile-cta-btn" href="#cotizar">
      <span>Solicitar Cotización Formal</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="mobile-wa-direct">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>Venta Mayorista Directa: +56 9 5863 9727</span>
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const close = document.getElementById('mobile-close');
  const headerCartBtn = document.getElementById('header-cart-btn');
  const mobileCartBtn = document.getElementById('mobile-cart-btn');
  
  function openMenu() {
    if (menu) menu.classList.add('open');
    if (backdrop) backdrop.classList.add('open');
    if (toggle) toggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('mobile-nav-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (menu) menu.classList.remove('open');
    if (backdrop) backdrop.classList.remove('open');
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('mobile-nav-open');
    document.body.style.overflow = '';
  }
  
  if (toggle) toggle.addEventListener('click', openMenu);
  if (close) close.addEventListener('click', closeMenu);
  if (backdrop) backdrop.addEventListener('click', closeMenu);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) closeMenu();
  });
  if (menu) {
    menu.querySelectorAll('.mobile-nav-item, .mobile-cta-btn').forEach((a) => {
      a.addEventListener('click', closeMenu);
    });
  }

  function openQuoteCart() {
    if ((window as any).QuoteCart) {
      (window as any).QuoteCart.open();
    }
  }

  if (headerCartBtn) headerCartBtn.addEventListener('click', openQuoteCart);
  if (mobileCartBtn) {
    mobileCartBtn.addEventListener('click', () => {
      closeMenu();
      openQuoteCart();
    });
  }
</script>

<style>
  .topbar {
    background: #0F172A;
    color: #CBD5E1;
    font-size: 12.5px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 500;
  }
  .wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .topbar-left {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .topbar-badge {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #F8FAFC;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--mono, monospace);
  }
  .topbar-item {
    display: inline-flex;
    align-items: center;
    color: #E2E8F0;
  }
  .topbar-sep {
    opacity: 0.25;
  }
  .topbar-wa {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #F8FAFC;
    text-decoration: none;
    font-weight: 600;
    font-size: 12.5px;
    transition: color 0.2s;
  }
  .topbar-wa:hover {
    color: #CBD5E1;
  }

  @media (max-width: 768px) {
    .wrap {
      padding: 0 16px;
    }
    .nav {
      padding: 12px 16px;
    }
    .topbar-left {
      display: none !important;
    }
    .topbar-inner {
      justify-content: center !important;
      text-align: center !important;
    }
    .topbar-wa {
      font-size: 11.5px !important;
      letter-spacing: 0.02em;
    }
  }
  
  .stripe {
    height: 3px;
    background: linear-gradient(90deg, #0F172A 0%, #1E293B 50%, #334155 100%);
  }
  
  header {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.05);
    border-bottom: 1px solid #E2E8F0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .nav {
    max-width: 1320px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    height: 42px;
    width: auto;
    max-width: 175px;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease;
  }

  .logo:hover .logo-img {
    transform: scale(1.015);
  }
  
  .nav-links {
    display: none;
  }
  
  @media (min-width: 960px) {
    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }
    .menu-toggle {
      display: none;
    }
  }
  
  .nav-links > a {
    color: #1E293B;
    text-decoration: none;
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }
  
  .nav-links > a:hover {
    color: #0F172A;
  }
  
  .nav-dropdown {
    position: relative;
    padding: 15px 0;
    margin: -15px 0;
  }
  
  .nav-dropdown-trigger {
    color: #1E293B;
    text-decoration: none;
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: -0.01em;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
  }
  
  .nav-dropdown-trigger:hover {
    color: #0F172A;
  }
  
  .dropdown-arrow {
    display: flex;
    align-items: center;
    color: #64748B;
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .nav-dropdown:hover .dropdown-arrow,
  .nav-dropdown:focus-within .dropdown-arrow {
    transform: rotate(180deg);
    color: #0F172A;
  }
  
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #FFFFFF;
    box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.18), 0 4px 12px rgba(15, 23, 42, 0.06);
    border: 1px solid #E2E8F0;
    border-top: 3px solid #0F172A;
    border-radius: 12px;
    padding: 28px 32px;
    display: grid;
    grid-template-columns: repeat(5, minmax(135px, 1fr));
    gap: 24px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 780px;
    pointer-events: none;
  }
  
  .nav-dropdown:hover .mega-menu,
  .nav-dropdown:focus-within .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    margin-top: -2px;
  }
  
  .mega-col {
    min-width: 0;
  }
  
  .mega-title {
    display: block;
    font-family: var(--display, system-ui);
    font-weight: 700;
    font-size: 13.5px;
    color: #0F172A;
    text-decoration: none;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #E2E8F0;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }
  
  .mega-title:hover {
    color: #334155;
  }
  
  .mega-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .mega-list li {
    margin-bottom: 6px;
  }
  
  .mega-list a {
    color: #475569;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    display: block;
    padding: 2px 0;
    transition: color 0.2s, transform 0.2s;
  }
  
  .mega-list a:hover {
    color: #0F172A;
    transform: translateX(3px);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .header-cart-btn {
    display: none;
    align-items: center;
    gap: 8px;
    background: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    padding: 9px 15px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .header-cart-btn svg {
    color: #0F172A;
  }

  @media (min-width: 960px) {
    .header-cart-btn {
      display: inline-flex;
    }
  }

  .header-cart-btn:hover {
    background: #F1F5F9;
    border-color: #94A3B8;
    color: #0F172A;
    transform: translateY(-1px);
  }

  .header-cart-badge {
    background: #0F172A;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    font-family: var(--mono, monospace);
    padding: 1px 6px;
    border-radius: 6px;
    line-height: 1.3;
  }

  .mobile-cart-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    color: #0F172A;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    width: 100%;
    margin-top: 8px;
    cursor: pointer;
  }

  .header-cta-btn {
    background: #0F172A;
    color: #FFFFFF;
    border: 1px solid #0F172A;
    padding: 9px 18px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 13.5px;
    transition: all 0.2s ease;
    display: none;
    align-items: center;
    gap: 7px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.12);
  }
  
  @media (min-width: 960px) {
    .header-cta-btn {
      display: inline-flex;
    }
  }
  
  .header-cta-btn:hover {
    background: #1E293B;
    border-color: #1E293B;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(15, 23, 42, 0.22);
  }
  
  /* Backdrop */
  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.68);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 1100;
  }

  .mobile-menu-backdrop.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Desktop hide mobile menu */
  @media (min-width: 960px) {
    .menu-toggle,
    .mobile-menu,
    .mobile-menu-backdrop {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  }

  /* Mobile styles */
  @media (max-width: 959px) {
    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 9px;
      width: 42px;
      height: 42px;
