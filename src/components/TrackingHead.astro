---
/**
 * TrackingHead — Meta Pixel Oficial + Verificación de Dominio + Tracker 1st-Party ZORTEX.
 * Solo se carga en páginas públicas (noindex = false).
 * Nunca expone el token CAPI (se mantiene 100% server-side).
 */
import { getPublicSettings } from '../lib/cms/store';

let settings: Awaited<ReturnType<typeof getPublicSettings>> | null = null;
try {
  settings = await getPublicSettings();
} catch {
  settings = null;
}

const pixelId = (settings?.metaPixelId || '').replace(/[^\d]/g, '');
const pixelEnabled = Boolean(settings?.metaPixelEnabled && pixelId);
const domainVerification = (settings?.metaDomainVerification || '').trim();
---

{domainVerification && (
  <meta name="facebook-domain-verification" content={domainVerification} />
)}

{pixelEnabled && (
  <>
    <script is:inline define:vars={{ pixelId }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixelId);
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
  </>
)}

<script is:inline define:vars={{ pixelEnabled, pixelId }}>
  (function () {
    if (typeof window === 'undefined') return;
    if (window.location.pathname.indexOf('/sistema') === 0) return;

    var VID_KEY = 'ztx_vid_v1';
    var SID_KEY = 'ztx_sid_v1';
    var ATTR_KEY = 'ztx_attr_v1';
    var ATTR_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 días de atribución

    function genId(prefix) {
      return prefix + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
    }

    function getCookie(name) {
      try {
        var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)'));
        return match ? decodeURIComponent(match[1]) : null;
      } catch (_) {
        return null;
      }
    }

    function getVisitorId() {
      try {
        var v = localStorage.getItem(VID_KEY);
        if (!v) {
          v = genId('v');
          localStorage.setItem(VID_KEY, v);
        }
        return v;
      } catch (_) {
        return genId('v');
      }
    }

    function getSessionId() {
      try {
        var s = sessionStorage.getItem(SID_KEY);
        if (!s) {
          s = genId('s');
          sessionStorage.setItem(SID_KEY, s);
        }
        return s;
      } catch (_) {
        return genId('s');
      }
    }

    function captureAttribution() {
      var params = new URLSearchParams(window.location.search || '');
      var fresh = {
        utm_source: params.get('utm_source') || null,
        utm_medium: params.get('utm_medium') || null,
        utm_campaign: params.get('utm_campaign') || null,
        utm_content: params.get('utm_content') || null,
        utm_term: params.get('utm_term') || null,
        fbclid: params.get('fbclid') || null,
        gclid: params.get('gclid') || null,
      };
      var hasNewCampaignData = Boolean(
        fresh.utm_source || fresh.utm_campaign || fresh.fbclid || fresh.gclid
      );

      var stored = null;
      try {
        var raw = localStorage.getItem(ATTR_KEY);
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && parsed.savedAt && Date.now() - parsed.savedAt < ATTR_TTL_MS) {
            stored = parsed;
          }
        }
      } catch (_) {}

      var docRef = document.referrer || null;
      if (docRef && docRef.indexOf(window.location.origin) === 0) {
        docRef = null;
      }

      var merged = hasNewCampaignData
        ? {
            utm_source: fresh.utm_source,
            utm_medium: fresh.utm_medium,
            utm_campaign: fresh.utm_campaign,
            utm_content: fresh.utm_content,
            utm_term: fresh.utm_term,
            fbclid: fresh.fbclid,
            gclid: fresh.gclid,
            referrer: docRef || (stored && stored.referrer) || null,
            savedAt: Date.now(),
          }
        : stored || {
            utm_source: null,
            utm_medium: null,
            utm_campaign: null,
            utm_content: null,
            utm_term: null,
            fbclid: null,
            gclid: null,
            referrer: docRef,
            savedAt: Date.now(),
          };

      try {
        localStorage.setItem(ATTR_KEY, JSON.stringify(merged));
      } catch (_) {}
      return merged;
    }

    var visitorId = getVisitorId();
    var sessionId = getSessionId();
    var attribution = captureAttribution();

    function fireFbq(metaName, metaParams, eventId) {
      if (!pixelEnabled || typeof window.fbq !== 'function') return;
      try {
        if (metaParams && Object.keys(metaParams).length > 0) {
          window.fbq('track', metaName, metaParams, { eventID: eventId });
        } else {
          window.fbq('track', metaName, {}, { eventID: eventId });
        }
      } catch (_) {}
    }

    function sendToBackend(payload) {
      try {
        var json = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          var blob = new Blob([json], { type: 'application/json' });
          navigator.sendBeacon('/api/track', blob);
          return;
        }
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: json,
          keepalive: true,
        }).catch(function () {});
      } catch (_) {}
    }

    function buildAttribution(customEventId) {
      return {
        utm_source: attribution.utm_source,
        utm_medium: attribution.utm_medium,
        utm_campaign: attribution.utm_campaign,
        utm_content: attribution.utm_content,
        utm_term: attribution.utm_term,
        fbclid: attribution.fbclid,
        gclid: attribution.gclid,
        referrer: attribution.referrer,
        visitor_id: visitorId,
        session_id: sessionId,
        event_id: customEventId || genId('ev'),
        fbp: getCookie('_fbp'),
        fbc: getCookie('_fbc'),
        url: window.location.href,
      };
    }

    function track(eventType, metadata, options) {
      var opts = options || {};
      var eventId = opts.eventId || genId('ev');
      var meta = metadata || {};

      // 1) Disparo en navegador con Meta Pixel (deduplicado via eventID)
      if (!opts.skipFbq) {
        if (eventType === 'page_view') {
          fireFbq('PageView', {}, eventId);
        } else if (eventType === 'view_product') {
          fireFbq(
            'ViewContent',
            {
              content_name: meta.product_name || 'Producto Zortex',
              content_ids: meta.product_id ? [String(meta.product_id)] : undefined,
              content_category: meta.category || 'Vestuario y EPP',
              content_type: 'product',
              currency: 'CLP',
            },
            eventId
          );
        } else if (eventType === 'search') {
          fireFbq('Search', { search_string: meta.search_query || '' }, eventId);
        } else if (eventType === 'add_to_cart') {
          fireFbq(
            'AddToCart',
            {
              content_name: meta.product_name || 'Producto Zortex',
              content_ids: meta.product_id ? [String(meta.product_id)] : undefined,
              content_category: meta.category || 'Vestuario y EPP',
              content_type: 'product',
              num_items: Number(meta.qty) || 1,
              currency: 'CLP',
            },
            eventId
          );
        } else if (eventType === 'initiate_checkout') {
          fireFbq(
            'InitiateCheckout',
            {
              num_items: Number(meta.qty) || 1,
              currency: 'CLP',
            },
            eventId
          );
        } else if (eventType === 'whatsapp_click') {
          fireFbq(
            'Contact',
            {
              content_name: 'WhatsApp - ' + (meta.cta_location || 'Web'),
            },
            eventId
          );
        } else if (eventType === 'quote_submit') {
          fireFbq(
            'Lead',
            {
              content_name: meta.empresa ? 'Cotización B2B - ' + meta.empresa : 'Cotización B2B Zortex',
              num_items: Number(meta.num_items) || 1,
              currency: 'CLP',
            },
            eventId
          );
        }
      }

      // 2) Registro en Analítica Propia + Reenvío CAPI Server-Side
      if (!opts.skipBackend) {
        sendToBackend({
          event_type: eventType,
          event_id: eventId,
          visitor_id: visitorId,
          session_id: sessionId,
          path: window.location.pathname + (window.location.hash || ''),
          url: window.location.href,
          referrer: attribution.referrer,
          utm_source: attribution.utm_source,
          utm_medium: attribution.utm_medium,
          utm_campaign: attribution.utm_campaign,
          utm_content: attribution.utm_content,
          utm_term: attribution.utm_term,
          fbclid: attribution.fbclid,
          gclid: attribution.gclid,
          fbp: getCookie('_fbp'),
          fbc: getCookie('_fbc'),
          metadata: meta,
        });
      }

      return eventId;
    }

    window.ZortexTrack = {
      pixelEnabled: pixelEnabled,
      pixelId: pixelId,
      track: track,
      getAttribution: buildAttribution,
      genEventId: function (prefix) {
        return genId(prefix || 'ev');
      },
    };

    // Registrar PageView inicial
    track('page_view', { title: document.title || 'Zortex' });

    // Interceptar automáticamente TODOS los clics en botones/links de WhatsApp
    document.addEventListener(
      'click',
      function (ev) {
        var target = ev.target;
        if (!target || !target.closest) return;
        var link = target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
        if (!link) return;
        var loc = 'Web';
        if (link.classList.contains('wa-float')) loc = 'Botón Flotante';
        else if (link.id === 'cart-wa-btn') loc = 'Carrito de Cotización';
        else if (link.closest('#product-detail-modal')) loc = 'Modal Producto';
        else if (link.closest('header')) loc = 'Header / Barra Superior';
        else if (link.closest('footer')) loc = 'Footer';
        track('whatsapp_click', { cta_location: loc, href: link.getAttribute('href') || '' });
      },
      true
    );
  })();
</script>
