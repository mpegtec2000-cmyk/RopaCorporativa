---
import { WHATSAPP_NUMBER } from '../config';
import { getPublicProducts } from '../lib/cms/store';

const PRODUCTS = await getPublicProducts();
---

<section id="cotizar" class="quote-section" data-wa={WHATSAPP_NUMBER} data-products={JSON.stringify(PRODUCTS)}>
  <div class="wrap">
    <div class="quote-header">
      <span class="quote-eyebrow">SOLICITUD COMERCIAL B2B • PRECIOS MAYORISTAS</span>
      <h2>Arma tu Solicitud de Cotización</h2>
      <p class="lead">Selecciona los modelos y equipos requeridos, define cantidades y tallas, y recibe una propuesta formal en menos de 24 horas hábiles.</p>
    </div>
    
    <div class="quote">
      <!-- LEFT panel: Product selector -->
      <div class="quote-products">
        <div class="quote-panel-head">
          <h3>Selector Rápido de Modelos</h3>
          <span class="quote-panel-badge">{PRODUCTS.length} ítems</span>
        </div>
        <div class="quote-search-box">
          <input
            type="search"
            id="quote-product-search"
            class="quote-search-input"
            placeholder={`Buscar entre los ${PRODUCTS.length} modelos por nombre, categoría o SKU...`}
            aria-label="Buscar productos para cotizar"
          />
        </div>
        <div id="product-list">
          <!-- Populated by JS -->
        </div>
      </div>
      
      <!-- RIGHT panel: Quote form -->
      <div class="quote-form-panel">
        <div class="quote-panel-head">
          <h3>Resumen de Solicitud</h3>
          <span class="quote-panel-badge">Atención B2B</span>
        </div>
        <ul id="selected-items" class="sel"></ul>
        <p id="empty-state" class="empty">Aún no agregas productos a tu solicitud. Selecciona ítems del listado izquierdo o directamente desde el catálogo.</p>
        
        <form id="quote-form">
          <div class="form-row-2">
            <div class="form-group">
              <label for="empresa">Razón Social / Empresa *</label>
              <input type="text" id="empresa" name="empresa" placeholder="Ej: Constructora Andina SpA" required>
            </div>
            <div class="form-group">
              <label for="rut">RUT Empresa</label>
              <input type="text" id="rut" name="rut" placeholder="76.123.456-7">
            </div>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="contacto">Nombre de contacto *</label>
              <input type="text" id="contacto" name="contacto" placeholder="Nombre y Cargo" required>
            </div>
            <div class="form-group">
              <label for="telefono">Teléfono / WhatsApp *</label>
              <input type="tel" id="telefono" name="telefono" placeholder="+56 9 1234 5678" required>
            </div>
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico corporativo</label>
            <input type="email" id="email" name="email" placeholder="adquisiciones@empresa.cl">
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="personalizacion">Servicio de Personalización</label>
              <select id="personalizacion" name="personalizacion">
                <option value="Sin logo">Sin logo (Solo prendas)</option>
                <option value="Bordado">Bordado Computarizado</option>
                <option value="Estampado">Estampado DTF / Reflectante</option>
                <option value="Parches">Parches Corporativos</option>
                <option value="Aún no lo sé">Requiere asesoría técnica</option>
              </select>
            </div>
            <div class="form-group">
              <label for="plazo">Plazo estimado requerido</label>
              <input type="text" id="plazo" name="plazo" placeholder="Ej: 15 días hábiles">
            </div>
          </div>
          <div class="form-group">
            <label for="mensaje">Observaciones o requerimientos especiales</label>
            <textarea id="mensaje" name="mensaje" rows="3" placeholder="Indica distribución de tallas, ubicaciones de logo o comuna de despacho..."></textarea>
          </div>
          
          <input type="text" name="honeypot" class="ohnohoney" tabindex="-1" aria-hidden="true" autocomplete="off" style="display:none;">
          
          <div class="form-actions">
            <button type="submit" class="btn">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              <span>Enviar Solicitud Formal</span>
            </button>
            <button type="button" class="btn ghost" id="wa-quote-btn">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Enviar por WhatsApp</span>
            </button>
          </div>
          
          <p id="msg" class="msg" role="status"></p>
          <div id="success-box" class="success-box" hidden>
            <div class="check-animation">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <p>¡Solicitud de cotización enviada con éxito!</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const sectionEl = document.getElementById('cotizar');
  const PRODUCTS = JSON.parse(sectionEl?.getAttribute('data-products') || '[]');

  const SIZES = ['XS', 'S', 'M', 'L', 'XL', 'XXL', '3XL'];

  const selectedProducts = new Map();

  const productListEl = document.getElementById('product-list');
  const selectedItemsEl = document.getElementById('selected-items');
  const emptyStateEl = document.getElementById('empty-state');
  const quoteForm = document.getElementById('quote-form');
  const msgEl = document.getElementById('msg');
  const successBox = document.getElementById('success-box');
  const waQuoteBtn = document.getElementById('wa-quote-btn');
  const whatsappNumber = sectionEl?.getAttribute('data-wa') || '';

  function normalizeText(s: string) {
    return (s || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  const searchInput = document.getElementById('quote-product-search') as HTMLInputElement | null;
  let searchTerm = '';

  if (searchInput) {
    searchInput.addEventListener('input', function () {
      searchTerm = normalizeText(this.value || '');
      renderProducts();
    });
  }

  function getCartItems(): any[] {
    try {
      const data = localStorage.getItem('zortex_quote_cart');
      return data ? JSON.parse(data) : [];
    } catch (_) {
      return [];
    }
  }

  function renderProducts() {
    if (!productListEl) return;
    productListEl.innerHTML = '';
    const cartItems = getCartItems();
    const cartProductIds = new Set(cartItems.map((i: any) => i.id));

    const filtered = searchTerm
      ? PRODUCTS.filter(function (p) {
          const normName = normalizeText(p.name);
          const normCat = normalizeText(p.category);
          const normSku = normalizeText((p as any).sku || '');
          return normName.includes(searchTerm) || normCat.includes(searchTerm) || normSku.includes(searchTerm);
        })
      : PRODUCTS;

    if (filtered.length === 0) {
      productListEl.innerHTML = '<p class="empty" style="text-align:center;padding:24px 12px;">No se encontraron productos coincidentes.</p>';
      return;
    }

    filtered.forEach(function (p) {
      const isSelected = cartProductIds.has(p.id);
      const div = document.createElement('div');
      div.className = 'product-item';

      const leftWrap = document.createElement('div');
      leftWrap.className = 'pi-left';

      const thumb = document.createElement('img');
      thumb.src = p.image;
      thumb.alt = p.name;
      thumb.className = 'pi-thumb';
      thumb.loading = 'lazy';
      thumb.width = 40;
      thumb.height = 40;

      const infoDiv = document.createElement('div');
      infoDiv.className = 'pi-info';

      const nameP = document.createElement('p');
      nameP.className = 'pi-name';
      nameP.textContent = p.name;

      const catSmall = document.createElement('small');
      catSmall.className = 'pi-cat';
      catSmall.textContent = p.sku ? `${p.category} • SKU ${p.sku}` : p.category;

      infoDiv.appendChild(nameP);
      infoDiv.appendChild(catSmall);

      leftWrap.appendChild(thumb);
      leftWrap.appendChild(infoDiv);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-toggle';
      btn.setAttribute('aria-pressed', String(isSelected));
      btn.setAttribute('data-id', p.id);
      btn.textContent = isSelected ? '✓ En Solicitud' : '+ Agregar';
      btn.addEventListener('click', function () {
        if ((window as any).QuoteCart) {
          (window as any).QuoteCart.addItem({
            id: p.id,
            name: p.name,
            category: p.category,
            sku: (p as any).sku || '',
            image: p.image,
            color: p.color || (p.colors && p.colors[0] ? p.colors[0].name : ''),
            colorHex: p.colorHex || (p.colors && p.colors[0] ? p.colors[0].hex : '#CBD5E0'),
            size: 'M',
            qty: 10,
          });
        }
      });

      div.appendChild(leftWrap);
      div.appendChild(btn);
      productListEl.appendChild(div);
    });
  }

  function renderSelected() {
    if (!selectedItemsEl || !emptyStateEl) return;
    const cartItems = getCartItems();

    if (cartItems.length === 0) {
      selectedItemsEl.style.display = 'none';
      emptyStateEl.style.display = 'block';
    } else {
      selectedItemsEl.style.display = 'block';
      emptyStateEl.style.display = 'none';
      selectedItemsEl.innerHTML = '';

      cartItems.forEach(function (item: any) {
        const li = document.createElement('li');

        const infoDiv = document.createElement('div');
        const strong = document.createElement('strong');
        strong.textContent = item.name;
        infoDiv.appendChild(strong);

        if (item.color) {
          const colorBadge = document.createElement('span');
          colorBadge.className = 'sel-color-badge';
          colorBadge.textContent = 'Color: ' + item.color;
          colorBadge.style.display = 'block';
          colorBadge.style.color = '#0F172A';
          colorBadge.style.fontWeight = '600';
          colorBadge.style.fontSize = '12px';
          colorBadge.style.marginTop = '2px';
          infoDiv.appendChild(colorBadge);
        }

        const controlsDiv = document.createElement('div');
        controlsDiv.className = 'sel-controls';

        const qtyInput = document.createElement('input');
        qtyInput.type = 'number';
        qtyInput.min = '1';
        qtyInput.value = String(item.qty || 10);
        qtyInput.className = 'qty-input';
        qtyInput.setAttribute('aria-label', 'Cantidad de ' + item.name);
        qtyInput.addEventListener('change', function (e: any) {
          const val = parseInt(e.target.value) || 1;
          if ((window as any).QuoteCart) {
            (window as any).QuoteCart.updateQty(item.key, val);
          }
        });

        const sizeSelect = document.createElement('select');
        sizeSelect.className = 'size-select';
        sizeSelect.setAttribute('aria-label', 'Talla de ' + item.name);
        SIZES.forEach(function (s) {
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = s;
          if (s === item.size) opt.selected = true;
          sizeSelect.appendChild(opt);
        });
        sizeSelect.addEventListener('change', function (e: any) {
          item.size = e.target.value;
          const items = getCartItems();
          const target = items.find((x: any) => x.key === item.key);
          if (target) {
            target.size = e.target.value;
            localStorage.setItem('zortex_quote_cart', JSON.stringify(items));
            window.dispatchEvent(new CustomEvent('quote-cart-updated', { detail: { items } }));
          }
        });

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn-remove';
        removeBtn.textContent = 'Quitar';
        removeBtn.addEventListener('click', function () {
          if ((window as any).QuoteCart) {
            (window as any).QuoteCart.removeItem(item.key);
          }
        });

        controlsDiv.appendChild(qtyInput);
        controlsDiv.appendChild(sizeSelect);
        controlsDiv.appendChild(removeBtn);

        li.appendChild(infoDiv);
        li.appendChild(controlsDiv);
        selectedItemsEl.appendChild(li);
      });
    }
  }

  window.addEventListener('quote-cart-updated', () => {
    renderProducts();
    renderSelected();
  });

  // WhatsApp quote button
  if (waQuoteBtn) {
    waQuoteBtn.addEventListener('click', function () {
      const cartItems = getCartItems();
      if (cartItems.length === 0) {
        if (msgEl) {
          msgEl.textContent = 'Debes agregar al menos un producto para cotizar.';
          msgEl.style.color = '#dc2626';
        }
        return;
      }

      var empresa = (document.getElementById('empresa') as HTMLInputElement)?.value || '';
      var contacto = (document.getElementById('contacto') as HTMLInputElement)?.value || '';
      var personalizacion = (document.getElementById('personalizacion') as HTMLSelectElement)?.value || '';
      var plazo = (document.getElementById('plazo') as HTMLSelectElement)?.value || '';

      if (!empresa || !contacto) {
        if (msgEl) {
          msgEl.textContent = 'Por favor completa Empresa y Nombre de contacto.';
          msgEl.style.color = '#dc2626';
        }
        return;
      }

      var lines = ['Hola, quiero cotizar los siguientes productos:', ''];
      cartItems.forEach(function (data: any) {
        var extra = [];
        if (data.color) extra.push('Color: ' + data.color);
        if (data.size) extra.push('Talla: ' + data.size);
        var extraStr = extra.length > 0 ? ' (' + extra.join(', ') + ')' : '';
        lines.push('- ' + data.qty + 'x ' + data.name + extraStr);
      });
      lines.push('');
      lines.push('Empresa: ' + empresa);
      lines.push('Contacto: ' + contacto);
      lines.push('Personalización: ' + personalizacion);
      lines.push('Plazo: ' + (plazo || 'No especificado'));

      var text = lines.join('\n');
      var url = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(text);
      window.open(url, '_blank');
    });
  }

  // Form submission
  if (quoteForm) {
    quoteForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (msgEl) {
        msgEl.textContent = '';
        msgEl.style.color = 'inherit';
      }

      var honeypotEl = document.querySelector('input[name="honeypot"]') as HTMLInputElement | null;
      if (honeypotEl && honeypotEl.value) return;

      const cartItems = getCartItems();
      if (cartItems.length === 0) {
        if (msgEl) {
          msgEl.textContent = 'Debes agregar al menos un producto para cotizar.';
          msgEl.style.color = '#dc2626';
        }
        return;
      }

      var items: any[] = [];
      cartItems.forEach(function (data: any) {
        items.push({
          producto: data.name,
          categoria: data.category,
          cantidad: parseInt(data.qty) || 1,
          talla: data.size || '',
          color: data.color || '',
        });
      });

      var payload = {
        empresa: document.getElementById('empresa')?.value || '',
        rut: document.getElementById('rut')?.value || '',
        nombre: document.getElementById('contacto')?.value || '',
        telefono: document.getElementById('telefono')?.value || '',
        correo: document.getElementById('email')?.value || '',
        personalizacion: document.getElementById('personalizacion')?.value || 'Sin logo',
        plazo: document.getElementById('plazo')?.value || '',
        mensaje: document.getElementById('mensaje')?.value || '',
        honeypot: honeypotEl ? honeypotEl.value : '',
        items: items,
      };

      try {
        var res = await fetch('/api/cotizar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        var result = {};
        try { result = await res.json(); } catch (_) {}

        if (!res.ok) {
          var errors = result.errors || ['Error al enviar. Intenta de nuevo.'];
          if (msgEl) {
            msgEl.textContent = errors.join('. ');
            msgEl.style.color = '#dc2626';
          }
          return;
        }

        if (result.demo) {
          if (msgEl) {
            msgEl.textContent = '✓ Cotización recibida (modo demo). En producción se guardará en la base de datos.';
            msgEl.style.color = '#16a34a';
          }
          showSuccessAnimation();
          return;
        }

        // Notificar en vivo al panel SaaS
        try {
          localStorage.setItem('zortex_cms_updated', Date.now().toString());
          if (typeof BroadcastChannel !== 'undefined') {
            new BroadcastChannel('zortex_cms').postMessage({ type: 'QUOTES_UPDATED', id: result.id });
          }
        } catch (_) {}

        showSuccess();
      } catch (err) {
        // En modo estático, el endpoint no existe — modo demo
        if (msgEl) {
          msgEl.textContent = '✓ Cotización recibida (modo demo). En producción se guardará en la base de datos.';
          msgEl.style.color = '#16a34a';
        }
        showSuccessAnimation();
      }
    });
  }

  function showSuccess() {
    if (msgEl) {
      msgEl.textContent = '✓ Tu cotización fue enviada. Un ejecutivo te contactará en menos de 24 horas.';
      msgEl.style.color = '#16a34a';
    }
    showSuccessAnimation();
  }

  function showSuccessAnimation() {
    if (successBox) successBox.hidden = false;
    if (quoteForm) (quoteForm as HTMLFormElement).reset();
    try {
      localStorage.removeItem('zortex_quote_cart');
      window.dispatchEvent(new CustomEvent('quote-cart-updated', { detail: { items: [] } }));
    } catch (_) {}
    renderProducts();
    renderSelected();

    setTimeout(function () {
      if (successBox) successBox.hidden = true;
      if (msgEl) msgEl.textContent = '';
    }, 5000);
  }

  renderProducts();
  renderSelected();
</script>

<style>
  .quote-section {
    padding: 80px 0 88px;
    background: #FFFFFF;
  }

  .quote-header {
    margin-bottom: 36px;
  }

  .quote-eyebrow {
    display: inline-block;
    font-family: var(--mono, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0F172A;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 10px;
  }

  .quote-header h2 {
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.03em;
    margin: 0 0 10px;
  }

  .quote-header .lead {
    margin-bottom: 0;
  }

  .quote-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid #E2E8F0;
  }

  .quote-panel-head h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.015em;
  }

  .quote-panel-badge {
    font-family: var(--mono, monospace);
    font-size: 11px;
    font-weight: 700;
    color: #0F172A;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    padding: 3px 9px;
    border-radius: 6px;
  }

  .quote-products {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 3px solid #0F172A;
  }

  .quote-form-panel {
    border-top: 3px solid #0F172A;
  }

  .quote-search-input {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    font-size: 13.5px;
    font-family: inherit;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    background: #F8FAFC;
  }

  .quote-search-input:focus {
    background: #FFFFFF;
    border-color: #0F172A;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.14);
  }

  #product-list {
    max-height: 560px;
    overflow-y: auto;
    padding-right: 6px;
  }

  #product-list::-webkit-scrollbar {
    width: 6px;
  }

  #product-list::-webkit-scrollbar-thumb {
    background: #CBD5E1;
    border-radius: 4px;
  }

  :global(.product-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  :global(.product-item .btn-toggle) {
    flex-shrink: 0;
  }

  :global(.pi-left) {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  :global(.pi-thumb) {
    width: 42px;
    height: 42px;
    border-radius: 6px;
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
    object-fit: contain;
    padding: 2px;
    flex-shrink: 0;
  }

  :global(.pi-info) {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  :global(.pi-name) {
    margin: 0 0 2px;
    font-weight: 700;
    font-size: 13.5px;
    color: #0F172A;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.pi-cat) {
    font-family: var(--mono, monospace);
    font-size: 11px;
    color: #64748B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .form-actions {
    display: flex;
    gap: 14px;
    margin-top: 24px;
    align-items: center;
  }

  .form-actions .btn {
    flex: 1.35;
    padding: 13px 22px;
    font-size: 14px;
