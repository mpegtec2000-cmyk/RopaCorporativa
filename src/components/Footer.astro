---
import { SITE } from '../config';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      
      <!-- Brand & Slogan -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          {SITE.name.toUpperCase()}<span>EPP</span>
        </div>
        <p class="footer-desc">{SITE.tagline}</p>
        <p class="footer-subdesc">Distribución mayorista y corporativa de vestuario de trabajo y elementos de seguridad personal para empresas en Chile.</p>
      </div>

      <!-- Quick Links Column 1 -->
      <div class="footer-col">
        <h4 class="footer-title">Categorías</h4>
        <ul class="footer-links">
          <li><a href="#catalogo">Ropa Corporativa</a></li>
          <li><a href="#catalogo">Ropa Industrial</a></li>
          <li><a href="#catalogo">Calzado de Seguridad</a></li>
          <li><a href="#catalogo">Protección EPP</a></li>
          <li><a href="#catalogo">Accesorios y Gorros</a></li>
        </ul>
      </div>

      <!-- Quick Links Column 2 -->
      <div class="footer-col">
        <h4 class="footer-title">Servicios B2B</h4>
        <ul class="footer-links">
          <li><a href="#cotizar">Cotización Formal</a></li>
          <li><a href="#cotizar">Descuentos por Volumen</a></li>
          <li><a href="#cotizar">Bordados con Logo</a></li>
          <li><a href="#cotizar">Estampado Textil</a></li>
          <li><a href="#como-funciona">Envíos a Regiones</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-title">Contacto Comercial</h4>
        <ul class="footer-contact">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{SITE.location}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{SITE.phone}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>{SITE.email}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Lun a Vie: 08:30 - 18:00 hrs</span>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Legal Strip -->
  <div class="footer-bottom">
    <div class="wrap footer-bottom-wrap">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. Todos los derechos reservados.</p>
      <div class="footer-legal-links">
        <a href="#cotizar">Cotización B2B</a>
        <span>·</span>
        <a href="#como-funciona">Términos de Servicio</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: white;
    color: var(--ink, #111);
    border-top: 2px solid var(--sky, #97B4DE);
    padding-top: 60px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 36px;
    margin-bottom: 48px;
  }
  .footer-logo {
    font-size: 24px;
    font-weight: 800;
    color: var(--ink, #111);
    font-family: var(--display, system-ui);
    letter-spacing: -0.5px;
    margin-bottom: 12px;
  }
  .footer-logo span {
    color: var(--blue, #263A99);
  }
  .footer-desc {
    font-size: 15px;
    font-weight: 600;
    color: var(--blue, #263A99);
    margin-bottom: 8px;
  }
  .footer-subdesc {
    font-size: 14px;
    color: var(--muted, #444);
    line-height: 1.5;
    margin: 0;
  }
  .footer-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink, #111);
    margin-bottom: 16px;
    font-family: var(--display, system-ui);
    border-bottom: 2px solid var(--sky, #97B4DE);
    padding-bottom: 8px;
    display: inline-block;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-links a {
    color: var(--muted, #444);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }
  .footer-links a:hover {
    color: var(--blue, #263A99);
  }
  .footer-contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-contact li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--muted, #444);
  }
  .footer-contact svg {
    color: var(--blue, #263A99);
    flex-shrink: 0;
  }
  .footer-bottom {
    background: var(--tint, #F3F6FC);
    border-top: 2px solid var(--sky, #97B4DE);
    border-bottom: 4px solid var(--blue, #263A99);
    padding: 18px 0;
  }
  .footer-bottom-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--muted, #444);
  }
  .footer-legal-links {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .footer-legal-links a {
    color: var(--muted, #444);
    text-decoration: none;
  }
  .footer-legal-links a:hover {
    color: var(--blue, #263A99);
  }
</style>
