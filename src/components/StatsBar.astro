---
// Componente de Indicadores Corporativos B2B (StatsBar)
// Rediseñado con alta jerarquía tipográfica, micro-badges semánticos y redacción técnica B2B

const STATS_DATA = [
  {
    value: 500,
    suffix: '+',
    tag: 'COBERTURA NACIONAL',
    tagColor: 'blue',
    title: 'Empresas y Faenas Abastecidas',
    description: 'Contratos marco y órdenes por volumen en minería, logística, construcción e industrias en todo Chile.',
    highlight: 'Despacho directo a faena y planta',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V4a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v17" fill="currentColor" fill-opacity="0.08"/><path d="M15 9h4a1 1 0 0 1 1 1v11"/><path d="M4 21h17"/><path d="M8 7h3"/><path d="M8 11h3"/><path d="M8 15h3"/><path d="M17 13h1"/><path d="M17 17h1"/></svg>`
  },
  {
    value: 15,
    suffix: '+',
    tag: 'TRAYECTORIA COMPROBADA',
    tagColor: 'navy',
    title: 'Años de Especialización B2B',
    description: 'Asesoría técnica integral en especificación de uniformes, curvatura de tallas y normativas laborales vigentes.',
    highlight: 'Homologación de vestuario de seguridad',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6" fill="currentColor" fill-opacity="0.08"/><path d="M12 15c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z"/><path d="M8.21 13.89L7 22l5-3 5 3-1.21-8.11"/><path d="M12 6.5l.8 1.6 1.8.3-1.3 1.3.3 1.8-1.6-.9-1.6.9.3-1.8-1.3-1.3 1.8-.3.8-1.6z" fill="currentColor" fill-opacity="0.25"/></svg>`
  },
  {
    value: 50,
    suffix: '+',
    tag: 'CATÁLOGO HOMOLOGADO',
    tagColor: 'amber',
    title: 'Marcas Técnicas y EPP Normado',
    description: 'Vestuario técnico y elementos de protección certificados bajo normas chilenas NCh, ISP, ANSI y EN ISO.',
    highlight: 'Certificados de conformidad disponibles',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4.5-8 4.5-8-4.5L12 2z" fill="currentColor" fill-opacity="0.12"/><path d="M4 11.5l8 4.5 8-4.5"/><path d="M4 16.5l8 4.5 8-4.5"/><circle cx="12" cy="6.5" r="1.5" fill="currentColor"/></svg>`
  },
  {
    value: 24,
    suffix: 'h',
    tag: 'SLA DE RESPUESTA',
    tagColor: 'emerald',
    title: 'Cotización Formal Garantizada',
    description: 'Propuesta técnica y comercial escalonada por volumen emitida en menos de 24 horas por ejecutivos asignados.',
    highlight: 'Muestra digital de bordado incluida',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.08"/><polyline points="12 7 12 12 15 14"/><path d="M19.5 4.5l1.5-1.5"/><path d="M4.5 4.5L3 3"/><path d="M12 2v2"/></svg>`
  }
];
---

<section class="stats-bar reveal" aria-label="Indicadores corporativos de respaldo y capacidad operativa">
  <div class="wrap">
    <div class="stats-grid">
      {STATS_DATA.map((stat) => (
        <article class="stat-card" data-color={stat.tagColor}>
          <div class="stat-header">
            <div class="stat-icon-wrap" aria-hidden="true" set:html={stat.icon} />
            <div class={`stat-tag-pill tag-${stat.tagColor}`}>
              <span class="pill-pulse" aria-hidden="true"></span>
              <span class="pill-text">{stat.tag}</span>
            </div>
          </div>

          <div class="stat-metric">
            <div class="stat-number-wrap">
              <span class="stat-value" data-target={String(stat.value)}>0</span>
              <span class="stat-suffix">{stat.suffix}</span>
            </div>
            <h3 class="stat-title">{stat.title}</h3>
            <p class="stat-desc">{stat.description}</p>
          </div>

          <div class="stat-highlight">
            <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>{stat.highlight}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-bar {
    padding: 44px 0 52px;
    background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
    border-bottom: 1px solid #E2E8F0;
    position: relative;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1100px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
  }

  @media (max-width: 580px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* Card Container */
  .stat-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 24px 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.28s ease;
  }

  /* Accent top stroke line */
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #CBD5E1;
    transition: background 0.28s ease, height 0.28s ease;
  }

  .stat-card[data-color="blue"]::before {
    background: linear-gradient(90deg, #0284C7, #0F172A);
  }
  .stat-card[data-color="navy"]::before {
    background: linear-gradient(90deg, #0F172A, #3B82F6);
  }
  .stat-card[data-color="amber"]::before {
    background: linear-gradient(90deg, #D97706, #0F172A);
  }
  .stat-card[data-color="emerald"]::before {
    background: linear-gradient(90deg, #059669, #0F172A);
  }

  .stat-card:hover {
    transform: translateY(-4px);
    border-color: #CBD5E1;
    box-shadow: 0 18px 36px -10px rgba(15, 23, 42, 0.1), 0 2px 6px rgba(15, 23, 42, 0.04);
  }

  .stat-card:hover::before {
    height: 4px;
  }

  /* Card Header */
  .stat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 12px;
  }

  .stat-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    color: #0F172A;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }

  .stat-card:hover .stat-icon-wrap {
    transform: scale(1.06);
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
  }

  /* Semantic Tag Pills */
  .stat-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 6px;
    font-family: var(--mono, monospace);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid transparent;
  }

  .pill-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  /* Colors for pills */
  .tag-blue {
    background: #F0F9FF;
    color: #0369A1;
    border-color: #BAE6FD;
  }
  .tag-blue .pill-pulse {
    background: #0284C7;
    box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.25);
  }

  .tag-navy {
    background: #F1F5F9;
    color: #1E293B;
    border-color: #CBD5E1;
  }
  .tag-navy .pill-pulse {
    background: #0F172A;
    box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.2);
  }

  .tag-amber {
    background: #FFFBEB;
    color: #B45309;
    border-color: #FDE68A;
  }
  .tag-amber .pill-pulse {
    background: #D97706;
    box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.25);
  }

  .tag-emerald {
    background: #ECFDF5;
    color: #047857;
    border-color: #A7F3D0;
  }
  .tag-emerald .pill-pulse {
    background: #059669;
    box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.3);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.25);
    }
  }

  /* Metric & Content */
  .stat-metric {
    margin-bottom: 16px;
  }

  .stat-number-wrap {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin-bottom: 8px;
    line-height: 1;
  }

  .stat-value {
    font-family: var(--display, 'Outfit', sans-serif);
    font-size: clamp(38px, 3.4vw, 46px);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .stat-suffix {
    font-family: var(--display, 'Outfit', sans-serif);
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.02em;
  }

  .stat-title {
    font-family: var(--display, 'Outfit', sans-serif);
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .stat-desc {
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    line-height: 1.55;
    color: #475569;
    margin: 0;
  }

  /* Highlight Chip at bottom */
  .stat-highlight {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-top: 14px;
    border-top: 1px dashed #E2E8F0;
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
    font-size: 12px;
    font-weight: 600;
    color: #0F172A;
  }

  .check-icon {
    color: #059669;
    flex-shrink: 0;
  }
</style>

<script>
  function animateCounters() {
    var counters = document.querySelectorAll('.stat-value[data-target]');
    if (!counters.length) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var counter = entry.target;
          var target = parseInt(counter.getAttribute('data-target') || '0', 10);
          var duration = 1800;
          var startTime = null;

          function step(timestamp) {
            if (!startTime) startTime = timestamp;
            var progress = Math.min((timestamp - startTime) / duration, 1);
            // Easing out cubic: 1 - (1 - t)^3
            var eased = 1 - Math.pow(1 - progress, 3);
            var current = Math.floor(eased * target);
            counter.textContent = current.toString();

            if (progress < 1) {
              requestAnimationFrame(step);
            } else {
              counter.textContent = target.toString();
            }
          }

          requestAnimationFrame(step);
          observer.unobserve(counter);
        }
      });
    }, { threshold: 0.25 });

    counters.forEach(function(el) {
      observer.observe(el);
    });
  }

  // Ejecución segura tras carga y en navegación Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', animateCounters);
  } else {
    animateCounters();
  }
  document.addEventListener('astro:page-load', animateCounters);
</script>
