---
import { INDUSTRIES } from '../config';

const sectorDetails = [
  {
    name: 'Minería y Energía',
    code: 'SEC-01',
    norm: 'NCh 1801 • ASTM F1506 • EN ISO 11612',
    desc: 'Indumentaria ignífuga con protección contra arco eléctrico (Arc Flash), parkas térmicas de alta montaña Clase 3 y calzado dieléctrico certificado 18 kV.',
    tag: 'Faenas de Gran Altura Geográfica',
    image: '/images/industrias/mineria.jpg',
    color: '#F59E0B',
    badge: 'NORMA ARC FLASH',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M13 8l-4 5h5l-3 5"/></svg>`
  },
  {
    name: 'Construcción y Obras Civiles',
    code: 'SEC-02',
    norm: 'NCh 461 • ANSI/ISEA 107 • EN 397',
    desc: 'Cascos Clase A con barboquejo de 4 puntas, chalecos técnicos geólogo con cintas reflectantes 3M Scotchlite™, arneses de detención de caídas y pantalones cargo reforzados.',
    tag: 'Edificación, Vialidad e Infraestructura',
    image: '/images/industrias/construccion.jpg',
    color: '#EAB308',
    badge: 'NORMA ANSI CLASE 3',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a6 6 0 0 1 6-6h0"/><path d="M14 6h0a6 6 0 0 1 6 6v3"/></svg>`
  },
  {
    name: 'Logística y Centros de Distribución',
    code: 'SEC-03',
    norm: 'NCh 772/2 • EN 388 (4X43D) • UPF 50+',
    desc: 'Softshells corporativos térmicos respirables, calzado ultraliviano con puntera composite no metálica, fajas ergonómicas y guantes nitrilo micro-foam de alto agarre.',
    tag: 'Centros Fulfillment y Bodegaje 24/7',
    image: '/images/industrias/logistica.jpg',
    color: '#3B82F6',
    badge: 'PUNTERA COMPOSITE',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
  },
  {
    name: 'Forestal y Agroindustria',
    code: 'SEC-04',
    norm: 'NCh 3252 • EN 381 Motosierra • Filtro UV',
    desc: 'Vestuario anticorte homologado para motosierras, indumentaria en Ripstop antidesgarro con protección solar UPF 50+, guantes de cabritilla y protección ocular sellada.',
    tag: 'Operaciones en Terreno y Cosecha',
    image: '/images/industrias/forestal.jpg',
    color: '#10B981',
    badge: 'RIPSTOP UPF 50+',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L7 9h10l-5-7z"/><path d="M12 9l-6 9h12l-6-9z"/><line x1="12" y1="18" x2="12" y2="22"/></svg>`
  },
  {
    name: 'Transporte y Flotas de Carga',
    code: 'SEC-05',
    norm: 'ANSI/ISEA Tipo R • Antideslizante SRC',
    desc: 'Poleras piqué institucionales de secado rápido, cortavientos impermeables con bandas reflectantes de 360°, camisas ejecutivas y calzado de conducción segura.',
    tag: 'Ruta Nacional e Intermodal',
    image: '/images/industrias/transporte.jpg',
    color: '#06B6D4',
    badge: 'ALTA VISIBILIDAD',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`
  },
  {
    name: 'Salud, Clínicas y Alimentación',
    code: 'SEC-06',
    norm: 'Protocolo HACCP • Barrera Fluidos • Teflon®',
    desc: 'Ambos y blusas clínicas elastizadas, ambos higiénicos para plantas de alimentos, cofias lavables, pantalones ejecutivos antimanchas y calzado con suela antifatiga.',
    tag: 'Grado Hospitalario e Inocuidad',
    image: '/images/industrias/servicios.jpg',
    color: '#8B5CF6',
    badge: 'ESTÁNDAR SANITARIO',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>`
  },
];
---

<section id="rubros" class="rubros-section reveal" aria-label="Soluciones técnicas por rubro e industria">
  <!-- Subtle ambient glow background -->
  <div class="rubros-ambient-glow" aria-hidden="true"></div>

  <div class="wrap rubros-content">
    <div class="section-head">
      <div class="rubros-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>COBERTURA MULTISECTORIAL EN CHILE • ESTÁNDAR B2B</span>
      </div>
      <h2>Soluciones de Protección y Vestuario por Sector Industrial</h2>
      <p class="lead">
        Suministramos dotaciones técnicas completas, vestuario corporativo y equipamiento de seguridad homologado según normativas chilenas e internacionales vigentes (NCh, ISP, ANSI, EN ISO), con despacho programado a faenas y plantas en todo el país.
      </p>
    </div>

    <div class="rubros-grid">
      {sectorDetails.map(s => (
        <article class="rubro-card">
          <!-- Image Header with gradient overlay -->
          <div class="rubro-card-media">
            <img 
              src={s.image} 
              alt={`Personal y equipamiento de seguridad para ${s.name}`}
              class="rubro-img"
              loading="lazy"
              width="600"
              height="340"
            />
            <div class="rubro-img-overlay" aria-hidden="true"></div>
            
            <div class="rubro-media-badges">
              <div class="rubro-icon-badge" set:html={s.icon} />
              <div class="rubro-code-badge">
                <span class="code-text">{s.code}</span>
                <span class="norm-badge">{s.badge}</span>
              </div>
            </div>
          </div>

          <!-- Content Body -->
          <div class="rubro-card-body">
            <div class="rubro-headline">
              <h3 class="rubro-title">{s.name}</h3>
              <div class="rubro-norms">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                <span>{s.norm}</span>
              </div>
            </div>

            <p class="rubro-desc">{s.desc}</p>

            <div class="rubro-card-footer">
              <div class="rubro-tag-chip">
                <span class="chip-dot" aria-hidden="true"></span>
                <span>{s.tag}</span>
              </div>
              <a href="#cotizar" class="rubro-quote-link" title={`Cotizar productos para ${s.name}`}>
                <span>Cotizar productos</span>
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- National coverage pill strip -->
    <div class="rubros-pills">
      <div class="pills-header">
        <span class="pills-title">Sectores Corporativos e Industriales Abastecidos con Contratos Marco a Nivel Nacional:</span>
      </div>
      <div class="pills-list">
        {INDUSTRIES.map(rubro => (
          <span class="rubro-pill">
            <span class="pill-bullet" aria-hidden="true"></span>
            {rubro}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .rubros-section {
    padding: 100px 0 92px;
    background-color: #0F172A;
    background-image: url('/images/fondos nuevos/FONDO 1.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: scroll;
    color: #F8FAFC;
    border-top: 1px solid rgba(30, 64, 175, 0.35);
    border-bottom: 1px solid rgba(30, 64, 175, 0.3);
    position: relative;
    overflow: hidden;
  }

  .rubros-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.92) 0%, rgba(15, 23, 42, 0.85) 50%, rgba(15, 23, 42, 0.96) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Ambient corporate blue glow */
  .rubros-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, 100vw);
    max-width: 100%;
    height: 480px;
    background: radial-gradient(ellipse at 50% -10%, rgba(30, 64, 175, 0.35) 0%, rgba(30, 58, 138, 0.12) 45%, transparent 75%);
    pointer-events: none;
    z-index: 1;
  }

  .rubros-ambient-glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.035) 1px, transparent 0);
    background-size: 28px 28px;
    opacity: 0.7;
    pointer-events: none;
  }

  .rubros-content {
    position: relative;
    z-index: 2;
  }

  /* Header */
  .section-head {
    margin-bottom: 52px;
    max-width: 860px;
  }

  .rubros-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #93C5FD;
    background: rgba(30, 64, 175, 0.3);
    border: 1px solid rgba(30, 64, 175, 0.6);
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 18px;
    text-transform: uppercase;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1E40AF;
    box-shadow: 0 0 10px #1E40AF;
    animation: pulseGlow 2.5s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .section-head h2 {
    color: #FFFFFF;
    font-size: clamp(32px, 3.6vw, 44px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin: 0 0 16px;
    font-family: var(--display, 'Outfit', sans-serif);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .section-head p.lead {
    color: #CBD5E1;
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    font-weight: 400;
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
    max-width: 780px;
  }

  /* Cards Grid */
  .rubros-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    margin-bottom: 56px;
  }

  @media (max-width: 1080px) {
    .rubros-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 640px) {
    .rubros-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Professional White Card with Executive Navy/Blue (#1E40AF) Typography */
  .rubro-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 32px -8px rgba(15, 23, 42, 0.35), 
                0 4px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease,
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .rubro-card:hover {
    transform: translateY(-6px);
    border-color: #1E40AF;
    box-shadow: 0 22px 45px -10px rgba(15, 23, 42, 0.45), 
                0 0 24px rgba(30, 64, 175, 0.25);
  }

  /* Image Banner */
  .rubro-card-media {
    position: relative;
    width: 100%;
    height: 195px;
    overflow: hidden;
    background: #0F172A;
  }

  .rubro-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    filter: brightness(0.96) contrast(1.04);
  }

  .rubro-card:hover .rubro-img {
    transform: scale(1.06);
    filter: brightness(1.02) contrast(1.05);
  }

  .rubro-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg, 
      rgba(15, 23, 42, 0.2) 0%, 
      rgba(15, 23, 42, 0.3) 50%, 
      rgba(255, 255, 255, 0.05) 100%
    );
    pointer-events: none;
  }

  .rubro-media-badges {
    position: absolute;
    inset: 14px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: none;
    z-index: 2;
  }

  .rubro-icon-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #93C5FD;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: color 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }

  .rubro-card:hover .rubro-icon-badge {
    color: #FFFFFF;
    background: #1E40AF;
    border-color: #3B82F6;
  }

  .rubro-code-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
  }

  .code-text {
    font-family: var(--mono, monospace);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #F8FAFC;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 3px 8px;
    border-radius: 5px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  .norm-badge {
    font-family: var(--mono, monospace);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #FFFFFF;
    background: #1E40AF;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 3px 8px;
    border-radius: 5px;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(30, 64, 175, 0.4);
  }

  /* Card Body with White Background & Pure Blue (#1E40AF) Corporate Typography */
  .rubro-card-body {
    padding: 24px 24px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    position: relative;
    z-index: 1;
    background: #FFFFFF;
  }

  .rubro-headline {
    margin-bottom: 14px;
  }

  .rubro-title {
    color: #0F172A;
    font-size: 21px;
    font-weight: 700;
    margin: 0 0 10px;
    font-family: var(--display, 'Outfit', sans-serif);
    letter-spacing: -0.025em;
    line-height: 1.25;
    transition: color 0.25s ease;
  }

  .rubro-card:hover .rubro-title {
    color: #1E40AF;
  }

  .rubro-norms {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono, monospace);
    font-size: 11px;
    font-weight: 700;
    color: #1E40AF;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    padding: 5px 11px;
    border-radius: 6px;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .rubro-desc {
    color: #334155;
    font-size: 13.5px;
    line-height: 1.65;
    font-weight: 400;
    margin: 0 0 22px;
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
  }

  /* Card Footer */
  .rubro-card-footer {
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding-top: 18px;
    border-top: 1px solid #F1F5F9;
    margin-top: auto;
  }

  .rubro-tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.8px;
    font-weight: 600;
    color: #475569;
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 5px 12px;
    border-radius: 9999px;
    width: fit-content;
  }

  .chip-dot {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
    display: inline-block;
  }

  .rubro-quote-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 11px 20px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    background: linear-gradient(135deg, #1E40AF 0%, #1D4ED8 100%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    box-shadow: 0 4px 14px -2px rgba(30, 64, 175, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.22);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .rubro-quote-link:hover {
    color: #FFFFFF;
    background: linear-gradient(135deg, #172554 0%, #1E40AF 100%);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 8px 22px -4px rgba(30, 64, 175, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .rubro-quote-link:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(30, 64, 175, 0.3);
  }

  .arrow-icon {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .rubro-quote-link:hover .arrow-icon,
  .rubro-card:hover .rubro-quote-link .arrow-icon {
    transform: translateX(4px);
  }

  /* National Pills Strip */
  .rubros-pills {
    background: #FFFFFF;
    border: 1.5px solid #2563EB;
    border-radius: 14px;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 10px 30px -6px rgba(0, 0, 0, 0.25), 0 0 15px rgba(37, 99, 235, 0.15);
  }

  .pills-title {
    font-size: 13px;
    color: #0F172A;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--mono, monospace);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pills-title::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 14px;
    background: #2563EB;
    border-radius: 2px;
  }

  .pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rubro-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F8FAFC;
    border: 1.5px solid #2563EB;
    color: #0F172A;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    font-family: var(--body, 'Plus Jakarta Sans', sans-serif);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rubro-pill:hover {
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
  }

  .pill-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2563EB;
    box-shadow: 0 0 6px rgba(37, 99, 235, 0.5);
  }

  .rubro-pill:hover .pill-bullet {
    background: #FFFFFF;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 640px) {
    .rubros-section {
      padding: 64px 0 54px;
    }

    .section-head {
      margin-bottom: 30px;
    }

    .rubros-eyebrow {
      font-size: 10px;
      padding: 5px 12px;
      margin-bottom: 14px;
    }

    .section-head h2 {
      font-size: clamp(24px, 6.8vw, 32px);
      margin-bottom: 12px;
    }

    .section-head p.lead {
      font-size: 14.5px;
      line-height: 1.6;
    }

    .rubro-card-body {
      padding: 18px 16px 16px;
    }

    .rubro-title {
      font-size: 18.5px;
      margin-bottom: 8px;
